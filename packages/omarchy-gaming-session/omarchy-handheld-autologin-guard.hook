[Trigger]
Operation = Upgrade
Operation = Install
Type = Package
Target = omarchy-dev
Target = omarchy-settings-dev

[Action]
Description = Turning off handheld autologin when omarchy-dev or omarchy-settings-dev is not a handheld build...
When = PostTransaction
Exec = /usr/lib/omarchy-gaming-session/omarchy-handheld-autologin-guard
