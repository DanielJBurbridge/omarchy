sddm_handheld_user_file() {
  printf '%s\n' "${OMARCHY_SDDM_CONF_DIR:-/etc/sddm.conf.d}/omarchy-handheld-user.conf"
}

# True when [Autologin] contains User= and no other key. A Session= or a key
# in another section is someone else's file and stays.
sddm_handheld_user_is_only_user() {
  local file line section="" key saw_user=0
  file=$(sddm_handheld_user_file)
  [[ -f $file && ! -L $file ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -z $line || $line == "#"* ]] && continue
    if [[ $line == "["*"]" ]]; then
      section=$line
      continue
    fi
    [[ $line == *"="* && $section == "[Autologin]" ]] || return 1
    key=${line%%=*}
    key=${key%"${key##*[![:space:]]}"}
    [[ $key == "User" ]] || return 1
    saw_user=1
  done <"$file"
  (( saw_user == 1 ))
}

post_install() {
  if [[ -x /usr/bin/omarchy-setup-handheld-dirs ]]; then
    omarchy-setup-handheld-dirs
  fi
  # One owner for /etc/sddm.conf.d/omarchy-handheld-user.conf. A counted
  # User= is left in place. The name comes from the installer record, not
  # from the account that ran pacman. No second file, no Session=, no sudoers.
  # The package is present because this scriptlet is that package.
  if [[ -x /usr/bin/omarchy-hw-rog-ally ]] && /usr/bin/omarchy-hw-rog-ally; then
    if [[ -x /usr/lib/omarchy-gaming-session/sddm-user.sh && ! -L /usr/lib/omarchy-gaming-session/sddm-user.sh ]]; then
      OMARCHY_GAMING_PACKAGE_PRESENT=1 /usr/lib/omarchy-gaming-session/sddm-user.sh install-recorded
    fi
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  local file
  file=$(sddm_handheld_user_file)
  if sddm_handheld_user_is_only_user; then
    rm -f -- "$file"
  fi
}
