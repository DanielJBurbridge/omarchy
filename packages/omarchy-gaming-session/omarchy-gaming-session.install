sddm_handheld_user_file() {
  printf '%s\n' "${OMARCHY_SDDM_CONF_DIR:-/etc/sddm.conf.d}/omarchy-handheld-user.conf"
}

# Pacman keeps going when a scriptlet returns 0. A failed profile step has
# to say which step failed and the command that repeats it.
warn_profile_step() {
  local step=$1
  shift
  if ! "$@"; then
    printf 'warning: %s failed; re-run: %s\n' "$step" "$*" >&2
  fi
}

post_install() {
  if [[ -x /usr/bin/omarchy-setup-handheld-dirs ]]; then
    omarchy-setup-handheld-dirs
  fi
  if command -v omarchy-inputplumber-profile >/dev/null; then
    warn_profile_step "InputPlumber profile service install" omarchy-inputplumber-profile install-service
  fi
  if command -v omarchy-ally-tdp-install >/dev/null; then
    warn_profile_step "Ally TDP session install" omarchy-ally-tdp-install session
  fi
  if [[ -x /usr/bin/omarchy-hw-rog-ally ]] && /usr/bin/omarchy-hw-rog-ally; then
    # install-service enables the switch unit and leaves it stopped, so a
    # fresh install cannot Load a profile until the next boot. Start it now.
    # A unit the user disabled or masked stays that way.
    local profile_state
    profile_state=$(systemctl is-enabled omarchy-inputplumber-profile.service 2>/dev/null || true)
    if [[ $profile_state != disabled && $profile_state != masked ]]; then
      warn_profile_step "InputPlumber profile service start" \
        systemctl enable --now omarchy-inputplumber-profile.service
    fi
    # Fill an empty User= from the installer record. A counted User= is
    # left in place. The name is not the account that ran pacman. No second
    # file, no Session=, no sudoers. The package is present because this
    # scriptlet is that package. The file itself stays unpackaged.
    if [[ -x /usr/lib/omarchy-gaming-session/sddm-user.sh && ! -L /usr/lib/omarchy-gaming-session/sddm-user.sh ]]; then
      OMARCHY_GAMING_PACKAGE_PRESENT=1 /usr/lib/omarchy-gaming-session/sddm-user.sh install-recorded
    fi
  fi
}

post_upgrade() {
  post_install
}

# /etc/sddm.conf.d/omarchy-handheld-user.conf is not a package file. The
# username is the account the installer created, so the bytes differ per
# machine and pacman cannot own them. pre_remove and post_remove both
# delete it. apply also deletes it when the machine is not the handheld
# variant, which is the desktop-mode cleanup.
remove_handheld_user_file() {
  local file
  file=$(sddm_handheld_user_file)
  if [[ -L $file || -e $file ]]; then
    rm -f -- "$file"
  fi
}

pre_remove() {
  remove_handheld_user_file
}

post_remove() {
  if command -v omarchy-inputplumber-profile >/dev/null; then
    warn_profile_step "InputPlumber profile service removal" omarchy-inputplumber-profile remove-service
  fi
  if command -v omarchy-ally-tdp-install >/dev/null; then
    warn_profile_step "Ally TDP session removal" omarchy-ally-tdp-install remove-session
  fi
  remove_handheld_user_file
}
