# Pacman keeps going when a scriptlet returns 0. A failed profile step has
# to say which step failed and the command that repeats it.
warn_profile_step() {
  local step=$1
  shift
  if ! "$@"; then
    printf 'warning: %s failed; re-run: %s\n' "$step" "$*" >&2
  fi
}

post_install() {
  if [[ -x /usr/bin/omarchy-setup-handheld-dirs ]]; then
    omarchy-setup-handheld-dirs
  fi
  # Both policy installers read the recorded handheld user. Save the owner
  # first on a provisioned system that has just added this package.
  local user_status=0
  if [[ -x /usr/bin/omarchy-hw-rog-ally ]] && /usr/bin/omarchy-hw-rog-ally; then
    if [[ -x /usr/lib/omarchy-gaming-session/sddm-user.sh && ! -L /usr/lib/omarchy-gaming-session/sddm-user.sh ]]; then
      OMARCHY_GAMING_PACKAGE_PRESENT=1 /usr/lib/omarchy-gaming-session/sddm-user.sh install-recorded || user_status=$?
    fi
  fi
  if command -v omarchy-inputplumber-profile >/dev/null; then
    # Adding the companion to a stock install does not replay hardware setup.
    # install-greeter checks the RC71L and preserves a disabled or masked unit.
    warn_profile_step "Ally greeter pointer install" omarchy-inputplumber-profile install-greeter
    warn_profile_step "InputPlumber profile service install" omarchy-inputplumber-profile install-service
    if [[ -x /usr/bin/omarchy-hw-rog-ally ]] && /usr/bin/omarchy-hw-rog-ally &&
      systemctl is-enabled --quiet omarchy-inputplumber-profile.service; then
      warn_profile_step "InputPlumber profile service start" systemctl start omarchy-inputplumber-profile.service
    fi
  fi
  if command -v omarchy-ally-tdp-install >/dev/null; then
    warn_profile_step "Ally TDP session install" omarchy-ally-tdp-install session
  fi
  return "$user_status"
}

post_upgrade() {
  post_install
}

deactivate_handheld_autologin() {
  local helper=$1
  if [[ -x $helper && ! -L $helper ]]; then
    warn_profile_step "Handheld SDDM cleanup" "$helper" deactivate-autologin
  fi
}

pre_remove() {
  # The companion helper is available before pacman removes its files.
  deactivate_handheld_autologin /usr/lib/omarchy-gaming-session/sddm-user.sh
}

post_remove() {
  # Catch an apply that ran while the companion was still installed.
  deactivate_handheld_autologin /usr/share/omarchy/default/gaming/sddm-user.sh
  if command -v omarchy-inputplumber-profile >/dev/null; then
    warn_profile_step "InputPlumber profile service removal" omarchy-inputplumber-profile remove-service
  fi
  if command -v omarchy-ally-tdp-install >/dev/null; then
    warn_profile_step "Ally TDP session removal" omarchy-ally-tdp-install remove-session
  fi
}
