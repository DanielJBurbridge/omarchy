post_install() {
  if [[ -x /usr/bin/omarchy-setup-handheld-dirs ]]; then
    omarchy-setup-handheld-dirs
  fi
  if command -v omarchy-inputplumber-profile >/dev/null; then
    omarchy-inputplumber-profile install-service || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  if command -v omarchy-inputplumber-profile >/dev/null; then
    omarchy-inputplumber-profile remove-service || true
  fi
}
