post_install() {
  if [[ -x /usr/bin/omarchy-setup-handheld-dirs ]]; then
    omarchy-setup-handheld-dirs
  fi
  if [[ -x /usr/bin/omarchy-inputplumber-profile ]]; then
    /usr/bin/omarchy-inputplumber-profile install-service || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  if [[ -x /usr/bin/omarchy-inputplumber-profile ]]; then
    /usr/bin/omarchy-inputplumber-profile remove-service || true
  fi
}
