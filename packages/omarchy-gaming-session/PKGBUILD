# Optional fixed-path registration. Runtime commands ship in omarchy.
# Versioned file:// aliases give each release its own SRCDEST entries
# and let makepkg collect the checkout files for --allsource.
pkgname=omarchy-gaming-session
pkgver=1.0.0
pkgrel=20
pkgdesc='Optional authenticated Omarchy handheld Gamescope sessions'
arch=('x86_64')
url='https://github.com/DanielJBurbridge/omarchy'
license=('MIT')
# The paired handheld runtime and settings supply the Omarchy entry points.
# Current development packages provide the unversioned virtual name omarchy.
depends=('omarchy' 'bash' 'coreutils' 'curl' 'diffutils' 'gamescope>=3.17.0'
         'inputplumber>=0.84.0' 'iproute2' 'lua51' 'pacman' 'polkit'
         'procps-ng' 'python' 'python-gobject' 'sddm' 'steam' 'sudo'
         'systemd' 'util-linux')
optdepends=('mangohud: Gamescope overlay via mangoapp'
            'omarchy-rog-ally-powerbutton: RC71L power-button handling in Gaming Mode'
            'sunshine: opt-in Moonlight hosting in Gaming Mode'
            'udisks2: remembered removable Steam libraries')
# SteamOS publishes this MIT source through its source archives. The Jovian
# mirror supplies the unchanged tagged source in a reproducible Git archive.
_notifier_commit=0ba7aef86eec3efda037258ccb8bdf1ae357a9b9
source=(
  "${pkgname}-${pkgver}-${pkgrel}-omarchy-gamescope.desktop::file://${startdir}/../../default/gaming/wayland-sessions/omarchy-gamescope.desktop"
  "${pkgname}-${pkgver}-${pkgrel}-omarchy-handheld.desktop::file://${startdir}/../../default/gaming/wayland-sessions/omarchy-handheld.desktop"
  "${pkgname}-${pkgver}-${pkgrel}-omarchy-managed-desktop.desktop::file://${startdir}/../../default/gaming/wayland-sessions/omarchy-managed-desktop.desktop"
  "${pkgname}-${pkgver}-${pkgrel}-omarchy-gaming.desktop::file://${startdir}/../../default/gaming/applications/Omarchy%20Gaming.desktop"
  "${pkgname}-${pkgver}-${pkgrel}-steamos-update::file://${startdir}/../../default/gaming/steamos-update"
  "${pkgname}-${pkgver}-${pkgrel}-sddm-user.sh::file://${startdir}/../../default/gaming/sddm-user.sh"
  'omarchy-handheld-autologin'
  'omarchy-handheld-autologin-guard'
  'omarchy-handheld-autologin-guard.hook'
  "${pkgname}-${pkgver}-${pkgrel}-omarchy-gaming-session.target::file://${startdir}/../../default/systemd/user/omarchy-gaming-session.target"
  "${pkgname}-${pkgver}-${pkgrel}-rog-ally-input-gaming-session.conf::file://${startdir}/../../default/systemd/user/omarchy-rog-ally-input.service.d/10-gaming-session.conf"
  "${pkgname}-${pkgver}-${pkgrel}-ally-tdp-shim-gaming-session.conf::file://${startdir}/../../default/systemd/user/omarchy-ally-tdp-shim.service.d/10-gaming-session.conf"
  'enable-new-inputplumber'
  'omarchy-gaming-inputplumber.hook'
  "${pkgname}-${pkgver}-${pkgrel}-LICENSE::file://${startdir}/../../LICENSE"
  "steam_notif_daemon-${_notifier_commit}.tar.gz::https://codeload.github.com/Jovian-Experiments/steam_notif_daemon/tar.gz/${_notifier_commit}"
  'steam-notifier-use-host-steam.patch'
)
sha256sums=('a697cc8058ae879fb3f0ef12fe69acafe79a227a5820ed085795c4431161a20a'
            '6a641adab37b03362dd4405684fd7c269cccc647fb96ac863896e79aeb618edb'
            '7534f5ebedda451110ed884d1a404244fc02bd34027c7b4ecf565a55040c853f'
            '9cd356df485b20ef525231da163d1fbeaba5e5b5d15b800bb3a335e1b86a0878'
            '6b255a501ca478539e7cbed7ee1bddf14f6ca159932a8f64044d45fd3e761396'
            'c64bc45684e189a4fb96de791d0c0343b4585afc7a6e52c93cbbb4055d9a50fc'
            'b17af87051655f9395f29d6b25c8791473e0ced7a4c31b8e0d3e1e8500468b4d'
            'c300fcef13686b115f50a21ad1da252724de887b0a3fc262838787ecd830a6da'
            '46c40a747591bdf02034fd1e35b669135b5f30e8dca2dc581e0c62ce8f6bc728'
            'bdad2bd12ab3fbd22626a272d5b7412fdc35eed4ec190033b70d67fe496d7c11'
            'c5c3abdcafdd253add60dbbac876de235ec1b2281e69d0cef8d6cb30933734f3'
            'a0c5e43a2651c66381052e92acfac78ce672041d3ff1a8a292cdb46c3d4bedf7'
            'c225d16e8e6b6e73797006a023f3057cc1650dd3db55728bed8f6e6de495d73b'
            '3bf621eeb444e281c066dd2457f7f97ab26cbe3d3fa1857d48e9da9d66ca987d'
            '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2'
            '88a1df4734b94e5ef9406702db3451a5417583b161950240bc59a8bd399fc368'
            '0303ab95f33fad9f8b82e77e058540901e95213289ea3dcaefca76cc44d8d169')
install=omarchy-gaming-session.install

prepare() {
  patch -d "$srcdir/steam_notif_daemon-$_notifier_commit" -p1 < "$srcdir/steam-notifier-use-host-steam.patch"
}

build() {
  local -a c_flags cpp_flags ld_flags notifier_flags notifier_libraries
  read -r -a c_flags <<< "$CFLAGS"
  read -r -a cpp_flags <<< "$CPPFLAGS"
  read -r -a ld_flags <<< "$LDFLAGS"
  read -r -a notifier_flags <<< "$(pkg-config --cflags libsystemd libcurl)"
  read -r -a notifier_libraries <<< "$(pkg-config --libs libsystemd libcurl)"
  cc "${cpp_flags[@]}" "${c_flags[@]}" "${notifier_flags[@]}" -std=c11 -DHAVE_LIBSYSTEMD=1 \
    "$srcdir/steam_notif_daemon-$_notifier_commit/main.c" "${ld_flags[@]}" "${notifier_libraries[@]}" \
    -o "$srcdir/steam_notif_daemon"
}

package() {
  local checkout_source="$pkgname-$pkgver-$pkgrel"
  install -Dm644 "$srcdir/$checkout_source-omarchy-gamescope.desktop" "$pkgdir/usr/share/wayland-sessions/omarchy-gamescope.desktop"
  install -Dm644 "$srcdir/$checkout_source-omarchy-handheld.desktop" "$pkgdir/usr/share/wayland-sessions/omarchy-handheld.desktop"
  install -Dm644 "$srcdir/$checkout_source-omarchy-managed-desktop.desktop" "$pkgdir/usr/share/wayland-sessions/omarchy-managed-desktop.desktop"
  install -Dm644 "$srcdir/$checkout_source-omarchy-gaming.desktop" "$pkgdir/usr/share/applications/omarchy-gaming.desktop"
  install -Dm755 "$srcdir/$checkout_source-steamos-update" "$pkgdir/usr/bin/steamos-polkit-helpers/steamos-update"
  install -Dm755 "$srcdir/$checkout_source-sddm-user.sh" "$pkgdir/usr/lib/omarchy-gaming-session/sddm-user.sh"
  install -Dm755 "$srcdir/steam_notif_daemon" "$pkgdir/usr/lib/omarchy-gaming-session/steam_notif_daemon"
  install -Dm644 "$srcdir/steam_notif_daemon-$_notifier_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/steam_notif_daemon.LICENSE"
  install -Dm644 "$srcdir/$checkout_source-omarchy-gaming-session.target" "$pkgdir/usr/lib/systemd/user/omarchy-gaming-session.target"
  install -Dm644 "$srcdir/$checkout_source-rog-ally-input-gaming-session.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-rog-ally-input.service.d/10-gaming-session.conf"
  install -Dm644 "$srcdir/$checkout_source-ally-tdp-shim-gaming-session.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-ally-tdp-shim.service.d/10-gaming-session.conf"
  # Opt-in only. The base tree does not ship this NOPASSWD grant. visudo -c
  # is the same check the shell test runs; a build host without visudo still
  # installs the file the test already parsed.
  if command -v visudo >/dev/null; then
    visudo -cf "$srcdir/omarchy-handheld-autologin"
  fi
  # install -D creates missing parents at 0755. sudo ships this directory
  # at 0750, and pacman warns when the package and the filesystem disagree.
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -Dm440 "$srcdir/omarchy-handheld-autologin" \
    "$pkgdir/etc/sudoers.d/omarchy-handheld-autologin"
  install -Dm755 "$srcdir/omarchy-handheld-autologin-guard" \
    "$pkgdir/usr/lib/omarchy-gaming-session/omarchy-handheld-autologin-guard"
  install -Dm644 "$srcdir/omarchy-handheld-autologin-guard.hook" \
    "$pkgdir/usr/share/libalpm/hooks/omarchy-handheld-autologin-guard.hook"
  install -Dm755 "$srcdir/enable-new-inputplumber" "$pkgdir/usr/lib/omarchy-gaming-session/enable-new-inputplumber"
  install -Dm644 "$srcdir/omarchy-gaming-inputplumber.hook" "$pkgdir/usr/share/libalpm/hooks/omarchy-gaming-inputplumber.hook"
  install -Dm644 "$srcdir/$checkout_source-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
