# Optional fixed-path registration. Runtime commands ship in omarchy.
# makepkg looks a local source up by basename, so a relative path never
# leaves this directory. file:// URLs land in $srcdir. A clean chroot and
# makepkg --allsource pack those sources. Checksums are of those files.
# Run makepkg from this directory.
pkgname=omarchy-gaming-session
pkgver=1.0.0
pkgrel=13
pkgdesc='Optional authenticated Omarchy handheld Gamescope sessions'
arch=('x86_64')
url='https://github.com/DanielJBurbridge/omarchy'
license=('MIT')
depends=('omarchy' 'iproute2' 'gamescope>=3.17.0' 'steam' 'sddm' 'systemd' 'util-linux')
# startdir is the PKGBUILD directory. makepkg sets it before sourcing this file.
source=(
  "omarchy-gamescope.desktop::file://${startdir}/../../default/gaming/wayland-sessions/omarchy-gamescope.desktop"
  "omarchy-handheld.desktop::file://${startdir}/../../default/gaming/wayland-sessions/omarchy-handheld.desktop"
  "omarchy-gaming.desktop::file://${startdir}/../../default/gaming/applications/Omarchy%20Gaming.desktop"
  "steamos-update::file://${startdir}/../../default/gaming/steamos-update"
  "sddm-user.sh::file://${startdir}/../../default/gaming/sddm-user.sh"
  'omarchy-handheld-autologin'
  'omarchy-handheld-autologin-guard'
  'omarchy-handheld-autologin-guard.hook'
  "LICENSE::file://${startdir}/../../LICENSE"
  "omarchy-gaming-session.target::file://${startdir}/../../default/systemd/user/omarchy-gaming-session.target"
  "omarchy-gaming-input-profile.service::file://${startdir}/../../default/systemd/user/omarchy-gaming-input-profile.service"
  "omarchy-rog-ally-input-gaming.conf::file://${startdir}/../../default/systemd/user/omarchy-rog-ally-input.service.d/10-gaming-session.conf"
  "omarchy-ally-tdp-shim-gaming.conf::file://${startdir}/../../default/systemd/user/omarchy-ally-tdp-shim.service.d/10-gaming-session.conf"
)
sha256sums=('d1dc75de73707abae50f6f71c0dc9fbc705a0aee71536683748f0ea79b3416ef'
            '6a641adab37b03362dd4405684fd7c269cccc647fb96ac863896e79aeb618edb'
            'd7a202bb97c5e34e24ee62b77b316b7717f999a65a66dc4af6e7158aa0076591'
            '69f0d54d4aff96d5f275b080386405e1cbd35b3447f336c76b86517462ed5e98'
            'a93a3ff413f17a2fd66aef4c98395335c41b50c478ee34bb41b868b40a899e05'
            'b17af87051655f9395f29d6b25c8791473e0ced7a4c31b8e0d3e1e8500468b4d'
            '1135ff5dbbc58b15bd57d256a1850bddc5e98ead53d24ded7b8b775c9edd4146'
            '4899c0cac210463b8eaea941461ee6761043f3b75320b62c29f9e0e1d0d5d4e3'
            '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2'
            'a10c59d21030638f862c1b28a1b7d806fcfdca296578587b3874228c6569508b'
            'f69ce16c70cc1414a61ab36fa898d3900d31dd4be46ce5fe1075c9d22152b3a2'
            'a3153f79823df7aaf53f3b569026126ef714864ea66f58d0e4d2d28cde16c781'
            'a0c5e43a2651c66381052e92acfac78ce672041d3ff1a8a292cdb46c3d4bedf7')
install=omarchy-gaming-session.install

package() {
  install -Dm644 "$srcdir/omarchy-gamescope.desktop" \
    "$pkgdir/usr/share/wayland-sessions/omarchy-gamescope.desktop"
  install -Dm644 "$srcdir/omarchy-handheld.desktop" \
    "$pkgdir/usr/share/wayland-sessions/omarchy-handheld.desktop"
  install -Dm644 "$srcdir/omarchy-gaming.desktop" \
    "$pkgdir/usr/share/applications/omarchy-gaming.desktop"
  install -Dm755 "$srcdir/steamos-update" \
    "$pkgdir/usr/bin/steamos-polkit-helpers/steamos-update"
  install -Dm755 "$srcdir/sddm-user.sh" \
    "$pkgdir/usr/lib/omarchy-gaming-session/sddm-user.sh"
  # Opt-in only. The base tree does not ship this NOPASSWD grant. visudo -c
  # is the same check the shell test runs; a build host without visudo still
  # installs the file the test already parsed.
  if command -v visudo >/dev/null; then
    visudo -cf "$srcdir/omarchy-handheld-autologin"
  fi
  # install -D creates missing parents at 0755. sudo ships this directory
  # at 0750, and pacman warns when the package and the filesystem disagree.
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -Dm440 "$srcdir/omarchy-handheld-autologin" \
    "$pkgdir/etc/sudoers.d/omarchy-handheld-autologin"
  install -Dm755 "$srcdir/omarchy-handheld-autologin-guard" \
    "$pkgdir/usr/lib/omarchy-gaming-session/omarchy-handheld-autologin-guard"
  install -Dm644 "$srcdir/omarchy-handheld-autologin-guard.hook" \
    "$pkgdir/usr/share/libalpm/hooks/omarchy-handheld-autologin-guard.hook"
  # User units, so a packaged install does not depend on copying them into
  # ~/.config. The profile oneshot is linked from the gaming target, the same
  # shape as Valve's gamescope-session.service.wants (BSD-2-Clause,
  # steamos-powerbuttond Makefile). The Hyprland session keeps the desktop
  # pointer profile.
  install -Dm644 "$srcdir/omarchy-gaming-session.target" \
    "$pkgdir/usr/lib/systemd/user/omarchy-gaming-session.target"
  install -Dm644 "$srcdir/omarchy-gaming-input-profile.service" \
    "$pkgdir/usr/lib/systemd/user/omarchy-gaming-input-profile.service"
  install -Dm644 "$srcdir/omarchy-rog-ally-input-gaming.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-rog-ally-input.service.d/10-gaming-session.conf"
  install -Dm644 "$srcdir/omarchy-ally-tdp-shim-gaming.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-ally-tdp-shim.service.d/10-gaming-session.conf"
  install -d "$pkgdir/usr/lib/systemd/user/omarchy-gaming-session.target.wants"
  ln -s ../omarchy-gaming-input-profile.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-gaming-session.target.wants/omarchy-gaming-input-profile.service"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
