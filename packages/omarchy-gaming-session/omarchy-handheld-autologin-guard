#!/bin/bash
# Drop handheld SDDM autologin when omarchy-dev or omarchy-settings-dev is
# not a handheld build. A handheld build matches one pattern: dev.*,
# *.handheld.*, or *.allypreview.*. The other packages omit the session
# pieces, and Relogin=true in zz-omarchy-handheld.conf then loops. Bazzite
# leaves the greeter by removing zz-holo-autologin.conf; this removes the
# drop-in apply already writes. User=, the sudoers grant and TPM config stay.
# SDDM is not restarted.
# OMARCHY_HANDHELD_AUTOLOGIN_ROOT is the test root. Pacman does not set it.
#
# A PostTransaction hook runs while pacman holds db.lck. A nested pacman -Q
# waits on that lock, so the hook reads the local database instead.
# --status prints keep, drop, or unknown and does not change files.
# omarchy-handheld-autologin apply uses that, so a later apply cannot put
# the drop-in back.

set -u
trap 'exit 0' EXIT

status_only=0
if [[ ${1:-} == "--status" ]]; then
  status_only=1
fi

root=${OMARCHY_HANDHELD_AUTOLOGIN_ROOT:-}
dropin=${root}/etc/sddm.conf.d/zz-omarchy-handheld.conf

log() {
  logger -t omarchy-handheld-autologin-guard -- "$1" 2>/dev/null || true
}

# dev.* at the start, or .handheld. / .allypreview. anywhere in the version.
# A trailing pkgrel (-1) still matches. Extend this list and the test together.
keeps_handheld_autologin() {
  case $1 in
    dev.*|*.handheld.*|*.allypreview.*) return 0 ;;
    *) return 1 ;;
  esac
}

# The local database names a package pkgname-pkgver-pkgrel. pkgver and pkgrel
# contain no hyphen, so the name is what remains after those two fields.
# <name>-[0-9d]* skips names that do not start like a version or dev.*.
# omarchy-dev and omarchy-settings-dev are read the same way. A settings-dev
# swap on its own is still a non-handheld build (L247).
local_version() {
  local db=$1 name=$2 entry base rest pkgname candidate found=""
  [[ -d $db && ! -L $db ]] || return 0
  for entry in "$db/$name"-[0-9d]*; do
    [[ -d $entry && ! -L $entry ]] || continue
    base=${entry##*/}
    rest=${base%-*}
    pkgname=${rest%-*}
    [[ $pkgname == $name ]] || continue
    candidate=${base#"$name"-}
    [[ -n $candidate ]] || continue
    if [[ -n $found ]]; then
      log "more than one $name in the local database; leaving handheld autologin"
      return 0
    fi
    found=$candidate
  done
  printf '%s\n' "$found"
}

# Empty when the package is not installed. The db.lck path and pacman -Q
# share keeps_handheld_autologin, so dev.*, .handheld. and .allypreview
# classify the same on both.
package_version() {
  local name=$1 query version=""
  if [[ ! -e ${root}/var/lib/pacman/db.lck ]]; then
    query=$(pacman -Q "$name" 2>/dev/null) || query=""
    version=${query#"$name "}
    version=${version%%[[:space:]]*}
  fi
  if [[ -z $version ]]; then
    version=$(local_version "${root}/var/lib/pacman/local" "$name")
  fi
  printf '%s\n' "$version"
}

classify() {
  local version=$1
  if [[ -z $version ]]; then
    printf 'absent\n'
  elif keeps_handheld_autologin "$version"; then
    printf 'keep\n'
  else
    printf 'drop\n'
  fi
}

dev_version=$(package_version omarchy-dev)
settings_version=$(package_version omarchy-settings-dev)
dev_class=$(classify "$dev_version")
settings_class=$(classify "$settings_version")
if [[ $dev_class == "drop" || $settings_class == "drop" ]]; then
  outcome=drop
elif [[ $dev_class == "keep" || $settings_class == "keep" ]]; then
  outcome=keep
else
  outcome=unknown
fi

reason=""
if [[ $dev_class == "drop" ]]; then
  reason="omarchy-dev $dev_version"
fi
if [[ $settings_class == "drop" ]]; then
  if [[ -n $reason ]]; then
    reason="$reason and omarchy-settings-dev $settings_version"
  else
    reason="omarchy-settings-dev $settings_version"
  fi
fi
kept=""
if [[ $dev_class == "keep" ]]; then
  kept="omarchy-dev $dev_version"
fi
if [[ $settings_class == "keep" ]]; then
  if [[ -n $kept ]]; then
    kept="$kept and omarchy-settings-dev $settings_version"
  else
    kept="omarchy-settings-dev $settings_version"
  fi
fi

if (( status_only )); then
  printf '%s\n' "$outcome"
else
  case $outcome in
    keep)
      log "$kept keeps handheld autologin"
      ;;
    drop)
      if [[ -L $dropin ]]; then
        log "refusing a symlink at $dropin; leaving handheld autologin"
      elif [[ -f $dropin ]]; then
        rm -f -- "$dropin"
        if [[ -e $dropin ]]; then
          log "could not remove $dropin; handheld autologin stays"
        else
          log "$reason is not a handheld build; removed $dropin so the next login uses the greeter. Reinstall a dev, .handheld or .allypreview build, then: sudo omarchy-handheld-autologin apply"
        fi
      else
        log "$reason is not a handheld build; $dropin is already absent"
      fi
      ;;
    *)
      log "could not read omarchy-dev or omarchy-settings-dev; leaving handheld autologin"
      ;;
  esac
fi
