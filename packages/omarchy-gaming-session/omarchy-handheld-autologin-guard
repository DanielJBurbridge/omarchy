#!/bin/bash
# Deactivate handheld SDDM autologin when stock runtime or settings are
# installed. SDDM can use the last desktop while User= is still active,
# even after the handheld Session= override disappears.
# OMARCHY_HANDHELD_AUTOLOGIN_ROOT is the test root. Pacman does not set it.
#
# A PostTransaction hook runs while pacman holds db.lck. A nested pacman -Q
# waits on that lock, so the hook reads the local database instead.
# --status prints keep, drop, or unknown and does not change files.
# omarchy-handheld-autologin apply uses that, so a later apply cannot put
# the drop-in back.

set -u
trap 'exit 0' EXIT

status_only=0
if [[ ${1:-} == "--status" ]]; then
  status_only=1
fi

root=${OMARCHY_HANDHELD_AUTOLOGIN_ROOT:-}

log() {
  logger -t omarchy-handheld-autologin-guard -- "$1" 2>/dev/null || true
}

# dev.* at the start, or .handheld. / .allypreview. anywhere in the version.
# A trailing pkgrel (-1) still matches. Extend this list and the test together.
keeps_handheld_autologin() {
  case ${1#*:} in
    dev.*|*.handheld.*|*.allypreview.*) return 0 ;;
    *) return 1 ;;
  esac
}

# The local database names a package pkgname-pkgver-pkgrel. pkgver and pkgrel
# contain no hyphen, so the name is what remains after those two fields.
local_version() {
  local db=$1 name=$2 entry base rest pkgname candidate found=""
  [[ -d $db && ! -L $db ]] || return 0
  for entry in "$db/$name"-*; do
    [[ -d $entry && ! -L $entry ]] || continue
    base=${entry##*/}
    rest=${base%-*}
    pkgname=${rest%-*}
    [[ $pkgname == $name ]] || continue
    candidate=${base#"$name"-}
    [[ -n $candidate ]] || continue
    if [[ -n $found ]]; then
      log "more than one $name in the local database; leaving handheld autologin"
      return 0
    fi
    found=$candidate
  done
  printf '%s\n' "$found"
}

# Empty when the package is not installed. The db.lck path and pacman -Q
# share keeps_handheld_autologin, so dev.*, .handheld. and .allypreview
# classify the same on both.
package_version() {
  local name=$1 query version=""
  if [[ ! -e ${root}/var/lib/pacman/db.lck ]]; then
    query=$(pacman -Q "$name" 2>/dev/null) || query=""
    version=${query#"$name "}
    version=${version%%[[:space:]]*}
  fi
  if [[ -z $version ]]; then
    version=$(local_version "${root}/var/lib/pacman/local" "$name")
  fi
  printf '%s\n' "$version"
}

stock=()
handheld=()
for package in omarchy omarchy-dev omarchy-settings omarchy-settings-dev; do
  version=$(package_version "$package")
  [[ -n $version ]] || continue
  if keeps_handheld_autologin "$version"; then
    handheld+=("$package $version")
  else
    stock+=("$package $version")
  fi
done

if (( ${#stock[@]} )); then
  outcome=drop
elif (( ${#handheld[@]} )); then
  outcome=keep
else
  outcome=unknown
fi

if (( status_only )); then
  printf '%s\n' "$outcome"
else
  case $outcome in
    keep)
      log "Installed handheld packages keep autologin: ${handheld[*]}"
      ;;
    drop)
      helper=${BASH_SOURCE[0]%/*}/sddm-user.sh
      if [[ -x $helper && ! -L $helper ]] &&
        OMARCHY_SDDM_CONF_DIR="$root/etc/sddm.conf.d" "$helper" deactivate-autologin; then
        log "Retired generated handheld autologin for ${stock[*]}. After reinstalling matching handheld packages, run sudo omarchy-handheld-autologin apply"
      else
        log "Could not reconcile handheld autologin for ${stock[*]}"
      fi
      ;;
    *)
      log "Could not identify installed Omarchy runtime or settings; leaving handheld autologin"
      ;;
  esac
fi
