+#[cfg(test)]
+mod input_config_test {
+    use super::*;
+
+    #[test]
+    fn input_management_is_explicit_and_preserves_legacy_default() {
+        assert!(RootConfig::default().services.manage_input);
+        assert!(toml::from_str::<RootConfig>("").unwrap().services.manage_input);
+        assert!(toml::from_str::<RootConfig>("[services]").unwrap().services.manage_input);
