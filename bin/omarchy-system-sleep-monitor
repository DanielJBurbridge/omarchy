#!/bin/bash

# omarchy:summary=Monitor sleep preparation and lock before suspend
# omarchy:group=system
# omarchy:hidden=true

# Exit 0 is a confirmed lock. Exit 10 is the handheld skip (no keyboard, and
# desktop-lock is not on). Both may suspend. Anything else, including a
# timeout and any other non-zero, must not: this process holds the delay
# inhibitor, and returning would release it so logind suspends an unlocked
# desktop. The broker that replaces this decision is a later change.
suspend_allowed() {
  local status=$1
  (( status == 0 || status == 10 ))
}

hold_sleep() {
  local held
  # Stay in this process. Exiting is what lets logind continue the suspend.
  sleep infinity &
  held=$!
  trap 'kill "$held" 2>/dev/null || true; exit 1' TERM INT HUP
  wait "$held"
}

consume_sleep_events() {
  local line sleep_lock status
  sleep_lock="$OMARCHY_PATH/bin/omarchy-system-sleep-lock"
  local lock_timeout=${OMARCHY_SLEEP_LOCK_TIMEOUT:-15}

  while IFS= read -r line; do
    if [[ $line == *"boolean true"* ]]; then
      timeout --kill-after=1s "${lock_timeout}s" "$sleep_lock"
      status=$?
      if suspend_allowed "$status"; then
        return 0
      fi
      hold_sleep
      return "$status"
    fi
  done
}

monitor_sleep_events() {
  local monitor_fd monitor_pid status

  coproc SLEEP_EVENTS {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  }
  monitor_fd=${SLEEP_EVENTS[0]}
  monitor_pid=$SLEEP_EVENTS_PID

  cleanup_monitor() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  }
  trap cleanup_monitor EXIT

  consume_sleep_events <&"$monitor_fd"
  status=$?
  cleanup_monitor
  trap - EXIT

  return "$status"
}

case ${1:-} in
  --consume)
    consume_sleep_events
    exit 0
    ;;
  --inhibited)
    monitor_sleep_events
    exit 0
    ;;
esac

sleep_monitor="$OMARCHY_PATH/bin/omarchy-system-sleep-monitor"

exec systemd-inhibit \
  --what=sleep \
  --mode=delay \
  --who=Omarchy \
  --why="Lock screen before suspend" \
  "$sleep_monitor" --inhibited
