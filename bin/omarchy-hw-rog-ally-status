#!/bin/bash

# omarchy:summary=Read ROG Ally package, service and recovery readiness without personal data
# omarchy:args=[--menu] [--updates] [--help]

set -euo pipefail

menu=false
updates=false
for arg in "$@"; do
  case "$arg" in
    --help|-h)
      echo 'Usage: omarchy-hw-rog-ally-status [--menu] [--updates]'
      echo 'Read-only report; --updates checks repositories using a separate temporary database.'
      echo 'Package/service presence does not prove physical operation.'
      exit 0 ;;
    --menu) menu=true ;;
    --updates) updates=true ;;
    *) exit 2 ;;
  esac
done
if ! omarchy-hw-rog-ally; then
  echo 'This report is for the original ASUS ROG Ally RC71L.' >&2
  exit 1
fi

rows=()
report() {
  rows+=("$1"$'\t'"$2")
}
package() {
  local value
  # Query only named packages. Do not include machine names, paths, logs or
  # arbitrary backend output in a report intended to be shared publicly.
  if value=$(pacman -Q "$1" 2>/dev/null); then
    value=${value#"$1 "}
    if [[ $value =~ ^[0-9][0-9A-Za-z.+_:~\-]*$ ]]; then
      printf 'installed %s' "$value"
    else
      printf 'installed (version unreadable)'
    fi
  else
    printf 'not installed'
  fi
}
service() {
  local state load active key value
  state=$(timeout 3 systemctl "${2:---system}" show "$1" --property=LoadState --property=ActiveState 2>/dev/null) || state=''
  load=''; active=''
  while IFS='=' read -r key value; do
    case "$key" in LoadState) load=$value ;; ActiveState) active=$value ;; esac
  done <<< "$state"
  if [[ $load != "loaded" ]]; then
    printf 'unavailable or unreadable'
  else
    case "$active" in
      active) printf 'active; device function unverified' ;;
      inactive|failed|activating|deactivating|reloading) printf '%s' "$active" ;;
      *) printf 'unavailable or unreadable' ;;
    esac
  fi
}
bus_ready() {
  local reply
  # Query the bus daemon, not a backend method: do not activate optional daemons.
  reply=$(busctl "$1" --timeout=2 call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus NameHasOwner s "$2" 2>/dev/null) || reply=''
  case "$reply" in
    'b true') printf 'API present; physical operation unverified' ;;
    'b false') printf 'not ready (no bus owner)' ;;
    *) printf 'unavailable or unreadable' ;;
  esac
}
module() {
  if omarchy-cmd-present "$2"; then
    report "$1 setup" 'command available; readiness and physical checks are separate'
  else
    report "$1 setup" 'not delivered in this installation'
  fi
}

report 'Hardware' 'original ROG Ally RC71L'
for spec in 'Omarchy:omarchy' 'Development package:omarchy-dev' 'Steam:steam' 'Gamescope:gamescope' 'Session companion:omarchy-gaming-session' 'InputPlumber:inputplumber' 'Input companion:omarchy-rog-ally-input' 'SteamOS Manager:steamos-manager' 'PowerStation:powerstation' 'Trusted keyboard:qt6-virtualkeyboard' 'Desktop keyboard:wvkbd' 'Firmware tooling:fwupd'; do
  report "${spec%%:*} package" "$(package "${spec#*:}")"
done
for unit in inputplumber powerstation power-profiles-daemon; do
  report "$unit service" "$(service "$unit.service")"
done
# A known competing input owner is a recovery issue, not a reason to silently
# stop someone else's service. Setup leaves decide ownership before changing it.
for unit in hhd handheld-daemon; do
  if [[ $(service "$unit.service") == active* ]]; then
    report 'Input ownership conflict' "$unit is active; resolve before enabling InputPlumber"
  fi
done
input_ready=$(bus_ready --system org.shadowblip.InputPlumber)
report 'InputPlumber readiness' "$input_ready"
if omarchy-cmd-present omarchy-hw-rog-ally-input; then
  report 'Input desktop bridge' "$(service omarchy-rog-ally-input.service --user)"
  if [[ $input_ready == 'API present;'* ]]; then
    # Never print raw composite names, profile/source paths or backend errors.
    # Probe only a running API; status must not activate a missing input owner.
    if input_json=$(timeout 12 omarchy-hw-rog-ally-input status 2>/dev/null) && \
      input_summary=$(jq -er '
        select(type == "object" and (.ProfileName | type == "string") and (.TargetDevices | type == "array" and length <= 128))
        | (.ProfileName | if . == "Omarchy Ally desktop" then "desktop" elif . == "Omarchy Ally gamepad" then "gamepad" elif . == "Omarchy Ally dualsense" then "dualsense" else "custom" end) as $profile
        | (.InterceptMode | if . == 0 then "none" elif . == 2 then "all" else "unrecognised" end) as $intercept
        | "composite readable; profile \($profile); interception \($intercept); \(.TargetDevices | length) targets; physical input unverified"
      ' <<< "$input_json" 2>/dev/null); then
      report 'Input composite' "$input_summary"
    else
      report 'Input composite' 'missing, ambiguous or unreadable; see local input diagnostics'
    fi
    if input_caps=$(timeout 12 omarchy-hw-rog-ally-input capabilities 2>/dev/null) && \
      input_counts=$(jq -er '
        select(type == "object" and (.Capabilities | type == "array" and length <= 4096) and (.OutputCapabilities | type == "array" and length <= 4096))
        | "\(.Capabilities | length) advertised input capabilities; \(.OutputCapabilities | length) output capabilities; physical behaviour unverified"
      ' <<< "$input_caps" 2>/dev/null); then
      report 'Input capabilities' "$input_counts"
    else
      report 'Input capabilities' 'unreadable; no gyro, rumble or lighting support inferred'
    fi
  else
    report 'Input composite' 'not probed because the API has no readable owner'
  fi
else
  report 'Input composite' 'integration command not delivered in this installation'
fi
manager_ready=$(bus_ready --user com.steampowered.SteamOSManager1)
report 'SteamOS Manager readiness' "$manager_ready"
if omarchy-cmd-present omarchy-power-ally; then
  report 'Manager system service' "$(service steamos-manager.service)"
  report 'Manager user service' "$(service steamos-manager.service --user)"
  report 'Power policy service' "$(service omarchy-ally-power.service --user)"
  if [[ $manager_ready == 'API present;'* ]]; then
    if power_json=$(timeout 15 omarchy-power-ally status 2>/dev/null) && \
      power_summary=$(jq -er '
        def number: type == "number" and . >= -1 and . <= 100000 and floor == .;
        def value($key):
          .value as $v
          | if $key == "charge" and $v == -1 then "firmware default"
            elif $key == "boost" and ($v == 0 or $v == 1) then (if $v == 1 then "enabled" else "disabled" end)
            elif ($v | number) then ($v | tostring) + (if $key == "tdp" then " W" elif $key == "gpu-clock" then " MHz" elif $key == "charge" then "%" else "" end)
            elif (["quiet","balanced","performance","low-power","power-saver","powersave","schedutil","ondemand","conservative","userspace","auto","low","high","manual","profile_standard","profile_min_sclk","profile_min_mclk","profile_peak"] | index($v)) != null then $v
            else "readable (value omitted)" end;
        def limits:
          if (.min | number) and (.max | number) then "; selectable " + (.min|tostring) + ".." + (.max|tostring) else "" end;
        if type != "object" or (.controls | type != "object") then error("schema")
        elif .error != null then ["Power controls", "unavailable or policy error; values not used"]
        elif (.conflicts | type == "array" and length > 0) then ["Power controls", "blocked by competing owner; resolve ownership before setup"]
        else
          ["Power source", (if .source == "ac" then "AC" elif .source == "battery" then "battery" else "unknown" end)],
          ["Power opt-in", (if .configured == true then "configured; physical operation unverified" else "not configured" end)],
          (["profile","tdp","boost","governor","gpu-level","gpu-clock","charge"][] as $key
            | .controls[$key] as $c
            | ["Power " + $key, (if $c.available == true then ($c | value($key)) + ($c | limits) + "; backend readback, physical effect unverified" else "unavailable from backend; inspect local capability reason" end)])
        end | @tsv
      ' <<< "$power_json" 2>/dev/null); then
      while IFS=$'\t' read -r label detail; do report "$label" "$detail"; done <<< "$power_summary"
    else
      report 'Power controls' 'unreadable or policy error; no prior values reused'
    fi
  else
    report 'Power controls' 'not probed because the Manager API has no readable owner'
  fi
  report 'Other power controls' 'independent burst, CPU frequency, SMT, fan curves, bypass and thermal API unavailable'
fi
report 'Power activation review' 'blocked; unchanged Manager 26.4.1-3 must not be installed, even inactive; no remediated package approved'
report 'Input source review' 'cleared with actual-lock and ownership corrections; physical acceptance remains unverified'
if omarchy-cmd-present omarchy-setup-rog-ally-input && omarchy-cmd-present omarchy-hw-rog-ally-input && \
  [[ $(pacman -Q omarchy-rog-ally-input 2>/dev/null) == "omarchy-rog-ally-input 1.0.2-1" ]]; then
  report 'Input setup eligibility' 'reviewed companion 1.0.2-1 installed; explicit terminal setup only'
else
  report 'Input setup eligibility' 'matching runtime helpers and reviewed companion 1.0.2-1 required; no activation attempted'
fi
module 'Input' omarchy-setup-rog-ally-input
module 'Power' omarchy-setup-rog-ally-power
module 'Display' omarchy-display-rog-ally
module 'Game tools' omarchy-install-gaming-tools
module 'Dedicated session' omarchy-setup-gaming-session
module 'Touch keyboard' omarchy-setup-rog-ally-keyboard
report 'Physical acceptance' 'not established by this report; test touch, controllers, game and resume on device'
if [[ $updates == true ]]; then
  # checkupdates uses its own database; never pacman -Sy (a partial upgrade).
  # A timeout or sync failure must not look like a current system.
  update_status=0
  pending=$(timeout 60 checkupdates --nocolor 2>/dev/null) || update_status=$?
  case "$update_status" in
    0)
      count=0
      while IFS= read -r line; do [[ -z $line ]] || (( count += 1 )); done <<< "$pending"
      report 'Package updates' "$count pending in configured repositories; use a full Omarchy update"
      ;;
    2) report 'Package updates' 'no repository package updates reported; AUR and firmware not checked' ;;
    *) report 'Package updates' 'check failed or timed out; update availability unknown' ;;
  esac
else
  report 'Package updates' 'not checked offline; choose Check updates or open Update > Omarchy'
fi
root_fs=$(findmnt -n -o FSTYPE / 2>/dev/null) || root_fs=unknown
if [[ $root_fs == "btrfs" ]]; then
  report 'Root filesystem' 'Btrfs; snapshot configuration still needs checking'
else
  report 'Root filesystem' 'not Btrfs or unreadable; do not assume snapshot recovery'
fi
report 'Snapper package' "$(package snapper)"
report 'Snapshot boot sync' "$(service limine-snapper-sync.service)"
if [[ -r /etc/snapper/configs/root && -r /boot/limine.conf ]]; then
  report 'Snapshot configuration' 'root config and Limine file present; create and inspect a snapshot before relying on recovery'
else
  report 'Snapshot configuration' 'missing or unreadable without privilege; recovery not established'
fi
report 'Boot recovery' 'manual Limine snapshot selection; no automatic failed-boot rollback promised'
report 'Save backups' 'root snapshots exclude home; back up saves and prefixes separately'
report 'Firmware' 'no scan or flash performed; availability depends on LVFS and the device'
report 'Boot trust and encryption' 'unchanged; confirm Secure Boot and disk-unlock recovery separately'

if [[ $menu == true ]]; then
  options=()
  for row in "${rows[@]}"; do options+=("󰋖"$'\t'"$row"); done
  if omarchy-menu-select 'ROG Ally status — read only' "${options[@]}" -- --width 680 >/dev/null; then
    :
  else
    status=$?
    (( status == 1 )) || exit "$status"
  fi
else
  printf '%s\n' "${rows[@]}"
fi
