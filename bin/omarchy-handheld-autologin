#!/bin/bash
# omarchy:hidden=true
# omarchy:summary=Autologin the handheld into gaming and stop after three failed starts

set -euo pipefail

# Root-owned crash-loop state. /run is empty after a reboot, so the next boot
# autologins again. The counter is not a user setting.
run_root=${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-/run/omarchy/handheld-autologin}
conf_dir=${OMARCHY_SDDM_CONF_DIR:-/etc/sddm.conf.d}
failures=$run_root/failures
stop=$run_root/stop
dropin=$conf_dir/zz-omarchy-handheld.conf
user_dropin=$conf_dir/omarchy-handheld-user.conf

if (( EUID == 0 )) && [[ -z ${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-} ]]; then
  export PATH=/usr/bin:/bin
fi

action=${1:-session}

log_refuse() {
  printf '%s\n' "omarchy-handheld-autologin: $1" >&2
  logger -t omarchy-handheld-autologin -- "$1" 2>/dev/null || true
  exit 1
}

if [[ $action == fail || $action == reset || $action == apply ]] && (( EUID != 0 )); then
  if [[ -z ${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-} && -x /usr/bin/omarchy-handheld-autologin ]] && sudo -n -l /usr/bin/omarchy-handheld-autologin "$action" >/dev/null 2>&1; then
    exec sudo -n -- /usr/bin/omarchy-handheld-autologin "$action"
  fi
  if [[ -n ${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-} ]]; then
    log_refuse "$action needs root; not using sudo while OMARCHY_HANDHELD_AUTOLOGIN_DIR is set"
  fi
  if [[ ! -x /usr/bin/omarchy-handheld-autologin ]]; then
    log_refuse "$action needs root; /usr/bin/omarchy-handheld-autologin is not installed"
  fi
  log_refuse "$action needs root; sudo -n -l refused a passwordless $action"
fi

refuse_symlink() {
  local path
  for path in "$run_root" "$conf_dir" "$failures" "$stop" "$dropin" "$user_dropin"; do
    if [[ -L $path ]]; then
      echo "omarchy-handheld-autologin: refusing a symlink at $path" >&2
      exit 1
    fi
  done
}

ensure_dir() {
  local dir=$1
  (( EUID == 0 )) || exit 1
  install -d -o root -g root -m 0755 "$dir"
}

write_file() {
  local dest=$1
  local temporary
  (( EUID == 0 )) || exit 1
  temporary=$(mktemp --tmpdir="${dest%/*}" .omarchy-handheld.XXXXXXXX)
  if cat > "$temporary" && chown root:root "$temporary" && chmod 0644 "$temporary" && mv -fT -- "$temporary" "$dest"; then
    return 0
  fi
  rm -f -- "$temporary"
  return 1
}

now_s() {
  if [[ ${OMARCHY_AUTOLOGIN_NOW:-} =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$OMARCHY_AUTOLOGIN_NOW"
  else
    date +%s
  fi
}

handheld_variant() {
  omarchy-cmd-present omarchy-hw-rog-ally omarchy-pkg-present &&
    omarchy-hw-rog-ally && omarchy-pkg-present omarchy-gaming-session
}

# sudo strips the environment, so this is the default state home of SUDO_USER.
# A relocated XDG_STATE_HOME is not visible here.
caller_failure_count() {
  local user home state file count
  user=${SUDO_USER:-}
  [[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || return 0
  home=$(getent passwd -- "$user" 2>/dev/null | cut -d: -f6 || true)
  [[ -n $home && $home == /* && ! -L $home && -d $home ]] || return 0
  state=$home/.local/state/omarchy/gaming-session
  file=$state/start-failures
  [[ -d $state && ! -L $state && -f $file && ! -L $file ]] || return 0
  IFS= read -r count < "$file" || return 0
  [[ $count =~ ^[0-9]+$ ]] || return 0
  printf '%s\n' "$count"
}

# sudo clears OMARCHY_PATH. The companion copy also works when stock settings
# have replaced the desktop's copy of the helper.
source_sddm_user_helper() {
  local command_path helper
  command_path=$(readlink -f -- "${BASH_SOURCE[0]}")
  helper=$(dirname -- "$command_path")/../default/gaming/sddm-user.sh
  if [[ ! -f $helper || -L $helper ]]; then
    helper=/usr/share/omarchy/default/gaming/sddm-user.sh
  fi
  if [[ ! -f $helper || -L $helper ]]; then
    helper=/usr/lib/omarchy-gaming-session/sddm-user.sh
  fi
  if [[ ! -f $helper || -L $helper ]]; then
    echo "omarchy-handheld-autologin: missing SDDM user helper" >&2
    return 1
  fi
  # shellcheck source=/dev/null
  source "$helper"
}

# The package guard also answers read-only status queries from apply.
handheld_package_status() {
  local guard command_path
  guard=/usr/lib/omarchy-gaming-session/omarchy-handheld-autologin-guard
  if [[ ! -f $guard || -L $guard ]]; then
    command_path=$(readlink -f -- "${BASH_SOURCE[0]}")
    guard=$(dirname -- "$command_path")/../packages/omarchy-gaming-session/omarchy-handheld-autologin-guard
  fi
  if [[ ! -f $guard || -L $guard || ! -x $guard ]]; then
    printf 'unknown\n'
    return 0
  fi
  "$guard" --status 2>/dev/null || true
}

apply_dropin() (
  local lock_policy variant=0
  handheld_variant && variant=1
  if (( ! variant )) && [[ ! -e $conf_dir && ! -L $conf_dir ]]; then
    return 0
  fi
  source_sddm_user_helper || return 1
  sddm_lock_conf_dir || return 1
  if (( ! variant )) || [[ $(handheld_package_status) == "drop" ]]; then
    sddm_deactivate_autologin
    return
  fi
  refuse_symlink
  # A crash-loop stop shows the greeter. A boot with no stop file autologins.
  if [[ -f $stop ]]; then
    sddm_activate_autologin false
    return
  fi
  # Read the packaged policy, independently of the caller's development path.
  # SDDM still autologins on its first display. Later displays reload this
  # file and ask for a password when the desktop entry policy requires one.
  lock_policy=$(
    # shellcheck source=/dev/null
    source /usr/share/omarchy/default/gaming/session.sh || exit 1
    gaming_desktop_lock_effective
  )
  if [[ $lock_policy == on ]]; then
    sddm_activate_autologin false
  else
    sddm_activate_autologin true
  fi
)

restart_greeter() {
  if [[ -n ${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-} ]]; then
    printf 'sddm-restart\n' >> "$OMARCHY_HANDHELD_AUTOLOGIN_DIR/actions"
  else
    systemctl restart sddm.service || true
  fi
}

# The greeter must not keep the desktop profile. fail is already root, so
# this is the helper itself, not pkexec and not a sudoers grant.
load_greeter_pointer() {
  if [[ -n ${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-} ]]; then
    printf 'inputplumber-profile:load pointer\n' >> "$OMARCHY_HANDHELD_AUTOLOGIN_DIR/actions"
  else
    if ! /usr/bin/omarchy-inputplumber-profile load pointer; then
      printf 'warning: greeter pointer profile load failed; re-run: omarchy-inputplumber-profile load pointer\n' >&2
    fi
  fi
}

case $action in
  session)
    refuse_symlink
    # Stop used to exit 0 and leave the greeter, which has no keyboard.
    # The supervisor opens the Hyprland desktop once. Relogin is already
    # false, so that desktop exiting does not start another session.
    exec omarchy-session-start relogin
    ;;
  install-user)
    source_sddm_user_helper
    sddm_install_user "${2:-}"
    ;;
  apply)
    apply_dropin
    ;;
  reset)
    # The ready FIFO read "started". That is the only healthy session.
    refuse_symlink
    ensure_dir "$run_root"
    write_file "$failures" </dev/null
    ;;
  fail)
    refuse_symlink
    ensure_dir "$run_root"
    now=$(now_s)
    kept=()
    if [[ -f $failures ]]; then
      while read -r stamp; do
        [[ $stamp =~ ^[0-9]+$ ]] || continue
        if (( stamp + 60 >= now )); then
          kept+=("$stamp")
        fi
      done < "$failures"
    fi
    kept+=("$now")
    write_file "$failures" <<EOF
$(printf '%s\n' "${kept[@]}")
EOF
    state_count=$(caller_failure_count)
    if (( ${#kept[@]} >= 3 )); then
      write_file "$stop" <<'EOF'
stop
EOF
      apply_dropin
      if handheld_variant; then
        restart_greeter
        load_greeter_pointer
      fi
    elif [[ $state_count =~ ^[0-9]+$ ]] && (( state_count >= 3 )); then
      # The persisted count already tripped. Pin Relogin off without
      # restarting SDDM: this process is about to open the desktop.
      write_file "$stop" <<'EOF'
stop
EOF
      apply_dropin
    fi
    ;;
  tripped)
    [[ -f $stop ]]
    ;;
  *)
    exit 2
    ;;
esac
