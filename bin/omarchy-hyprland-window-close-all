#!/bin/bash

# omarchy:summary=Close all open windows
# omarchy:args=[--wait|--confirm]

if [[ ${1:-} == "--confirm" ]]; then
  [[ -n ${XDG_RUNTIME_DIR:-} ]] || exit 0
  # The menu only tracks one selection request. Ignore another press while
  # this prompt is open, and release the lock if the shell loses the request.
  exec {confirm_lock}>"$XDG_RUNTIME_DIR/omarchy-close-all-confirm.lock" || exit 0
  flock -n "$confirm_lock" || exit 0
  no=$(omarchy-i18n common.no)
  yes=$(omarchy-i18n common.yes)
  [[ -n $no && -n $yes && $no != "$yes" ]] || exit 0
  selection=$(timeout 60s omarchy-menu-select "$(omarchy-i18n window.closeAllConfirm)" "$no" "$yes") || exit 0
  [[ $selection == "$yes" ]] || exit 0
fi

clients=$(hyprctl clients -j) || exit 1

# Capture the owning processes before their windows disappear. Window closure
# alone does not mean an application has finished writing its shutdown state.
if [[ ${1:-} == "--wait" ]]; then
  pids=$(jq -r '[.[].pid | select(. > 0)] | unique | join(",")' <<<"$clients")
  if [[ -n $pids ]]; then
    pidwait --euid "$UID" --pid "$pids" &
    waiter=$!
  fi
fi

batch=$(jq -r '[.[].address | select(length > 0) | "dispatch hl.dsp.window.close({ window = \"address:\(.)\" })"] | join(" ; ")' <<<"$clients")
if [[ -n $batch ]]; then
  hyprctl --batch "$batch" >/dev/null
fi

# Move to the focused monitor's first workspace
hyprctl dispatch 'o.workspaces.focus(1)' >/dev/null 2>&1 || hyprctl dispatch workspace 1

if [[ -n ${waiter:-} ]]; then
  # No matching process means the applications have already exited.
  wait "$waiter" || (( $? == 1 ))
fi
