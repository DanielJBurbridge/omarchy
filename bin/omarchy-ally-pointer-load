#!/bin/bash
# omarchy:hidden=true
# omarchy:summary=Load the Ally stick pointer profile into InputPlumber

set -uo pipefail
if [[ -z ${OMARCHY_PATH:-} ]]; then
  # shellcheck source=/dev/null
  source /usr/share/omarchy/default/bash/env-bootstrap
fi
profile=$OMARCHY_PATH/default/inputplumber/profiles/omarchy-ally-pointer.yaml
[[ -f $profile ]] || exit 0
command -v busctl >/dev/null 2>&1 || exit 0
waited=0
while (( waited < 40 )); do
  if busctl introspect org.shadowblip.InputPlumber /org/shadowblip/InputPlumber/CompositeDevice0 >/dev/null 2>&1; then
    busctl call org.shadowblip.InputPlumber \
      /org/shadowblip/InputPlumber/CompositeDevice0 \
      org.shadowblip.Input.CompositeDevice \
      LoadProfilePath s "$profile" || true
    exit 0
  fi
  sleep 0.25
  waited=$(( waited + 1 ))
done
exit 0
