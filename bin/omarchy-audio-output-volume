#!/bin/bash

# omarchy:summary=Adjust output volume and show the Omarchy OSD
# omarchy:args=<raise|lower|mute-toggle|+N|-N> [sink-name]
# omarchy:examples=omarchy audio output volume raise | omarchy audio output volume lower | omarchy audio output volume mute-toggle | omarchy audio output volume +1

action="${1:-}"

if [[ -z $action ]]; then
  echo "Usage: omarchy-audio-output-volume <raise|lower|mute-toggle|+N|-N> [sink-name]"
  exit 1
fi

# Resolve through any DSP sink to the physical one, so the keys always move real
# loudness and the processing always sees full-scale input. Shared with the audio
# panel and the output switcher.
sink="$(omarchy-audio-output-sink "${2:-}")"
if [[ -z $sink ]]; then
  echo "Could not resolve an audio sink to control." >&2
  exit 1
fi

# pactl reports the same percentage scale wpctl does (both are the raw volume
# over PA_VOLUME_NORM), so the OSD reads identically either way.
# pactl translates its labels and yes/no; parse them in the C locale.
volume_percent() {
  local line
  line=$(LC_ALL=C pactl get-sink-volume "$sink" 2>/dev/null) || return
  line=${line%%$'\n'*}
  [[ $line =~ (^|[[:space:]])([0-9]+)%([[:space:]]|$) ]] && printf '%s\n' "${BASH_REMATCH[2]}"
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

if [[ $action == "mute-toggle" ]]; then
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  debounce_file="$runtime_dir/omarchy-audio-output-volume-mute-toggle.last"
  now_us=${EPOCHREALTIME//[!0-9]/}
  now=$(( 10#$now_us / 1000 ))
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  if ((now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  pactl set-sink-mute "$sink" toggle || exit 1
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  direction="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"

  if ! current=$(volume_percent); then
    echo "Could not read volume for $sink." >&2
    exit 1
  fi

  if [[ $direction == "+" ]]; then
    next=$((current + step))
    ((next <= 100)) || next=100
  else
    next=$((current - step))
    ((next >= 0)) || next=0
  fi

  pactl set-sink-mute "$sink" 0 || exit 1
  pactl set-sink-volume "$sink" "${next}%" || exit 1
else
  echo "Unknown volume action: $action"
  exit 1
fi

# The named output can disappear after the write, especially during dock removal.
if ! percent=$(volume_percent) ||
    ! mute=$(LC_ALL=C pactl get-sink-mute "$sink" 2>/dev/null) ||
    [[ $mute != "Mute: yes" && $mute != "Mute: no" ]]; then
  echo "Could not read volume or mute state for $sink." >&2
  exit 1
fi
if [[ $mute == "Mute: yes" ]] || (( percent == 0 )); then
  icon="volume-muted"
else
  icon="volume-high"
fi

omarchy-osd -i "$icon" -p "$percent"
