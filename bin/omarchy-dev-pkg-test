#!/bin/bash

# omarchy:summary=Build and install Omarchy packages from a local checkout
# omarchy:group=dev
# omarchy:args=[--all|package-name] [path-to-checkout]
# omarchy:examples=omarchy dev pkg-test --all | omarchy dev pkg-test omarchy-dev ~/Work/omarchy/omarchy-installer

set -euo pipefail

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  cat <<USAGE
Usage: omarchy dev pkg-test
       omarchy dev pkg-test --all [path-to-checkout]
       omarchy dev pkg-test <package-name> [path-to-checkout] [makepkg options]

Builds and installs Omarchy packages from a local Omarchy source
checkout. Use when changes need to land at fixed system paths (/etc/,
/usr/lib/systemd/, udev rule bodies, plymouth) that omarchy-dev-link
can't shadow.

With --all or no arguments, both packages are installed in one transaction.
Paired builds require build dependencies to be installed already.

Defaults:
  packages          omarchy-settings-dev omarchy-dev
  path-to-checkout  ~/Work/omarchy/omarchy-installer

Examples:
  omarchy dev pkg-test --all
  omarchy dev pkg-test omarchy-settings-dev
  omarchy dev pkg-test omarchy-dev ~/Work/omarchy/omarchy-installer

The pkgver of the built package is
'<base>.<commit UTC yyyymmddHHMM>.r<count>.handheld.<sha8>[.dirty]'.
<base> is the checkout's version file with a trailing .alpha removed.
pacman -Q shows the commit, and vercmp keeps the build above upstream
omarchy-dev 4.0.0.r* until that package's base moves to 4.0.1 or later.

PKGBUILDs are read from \${OMARCHY_PKGBUILDS_DIR:-~/Work/omarchy/omarchy-pkgs/pkgbuilds}/<package-name>/.
USAGE
  exit 0
fi

remove_pkgver_function() {
  local pkgbuild="$1"
  local tmp="$pkgbuild.tmp"

  awk '
    /^pkgver\(\)[[:space:]]*\{/ {
      in_pkgver = 1
      depth = 0
    }
    in_pkgver {
      line = $0
      opens = gsub(/\{/, "{", line)
      line = $0
      closes = gsub(/\}/, "}", line)
      depth += opens - closes
      if (depth <= 0) {
        in_pkgver = 0
      }
      next
    }
    { print }
  ' "$pkgbuild" >"$tmp"
  mv "$tmp" "$pkgbuild"
}

dev_package_name() {
  local pkg="$1"

  case "$pkg" in
    omarchy | omarchy-settings)
      printf '%s-dev\n' "$pkg"
      ;;
    *)
      printf '%s\n' "$pkg"
      ;;
  esac
}

# Upstream omarchy-dev is 4.0.0.r<count>.g<sha> (omarchy-pkgs: r is the total
# commit count and must not go down). vercmp ranks a numeric segment above
# the letter r, and ranks 4.0.1 above 4.0.0. The UTC stamp therefore sits in
# front of r<count>. A dev.<date>.<sha> pkgver sorts below 4.0.0, and
# `omarchy update` then replaces the handheld build.
handheld_pkgver_base() {
  local version="$1"

  version=${version%%$'\n'*}
  version=${version//[[:space:]]/}
  if [[ $version == *.alpha ]]; then
    version=${version%.alpha}
  fi
  if [[ -z $version ]]; then
    version=0
  fi
  printf '%s\n' "$version"
}

handheld_pkgver() {
  local base="$1" stamp="$2" rev="$3" sha="$4" dirty="${5:-}"

  printf '%s.%s.r%s.handheld.%s%s\n' "$base" "$stamp" "$rev" "$sha" "$dirty"
}

handheld_pkgver_for_checkout() {
  local checkout="$1"
  local version="" base stamp rev sha dirty=""

  if [[ -f "$checkout/version" ]]; then
    version=$(<"$checkout/version")
  fi
  base=$(handheld_pkgver_base "$version")

  if git -C "$checkout" rev-parse --verify HEAD >/dev/null 2>&1; then
    stamp=$(date -u -d "@$(git -C "$checkout" show -s --format=%ct HEAD)" +%Y%m%d%H%M)
    rev=$(git -C "$checkout" rev-list --count HEAD)
    sha=$(git -C "$checkout" rev-parse --short=8 HEAD)
    if [[ -n "$(git -C "$checkout" status --porcelain)" ]]; then
      dirty=".dirty"
    fi
  else
    stamp=$(date -u +%Y%m%d%H%M)
    rev=0
    sha=local
  fi

  handheld_pkgver "$base" "$stamp" "$rev" "$sha" "$dirty"
}

if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
  return 0
fi

CHECKOUT="${2:-$HOME/Work/omarchy/omarchy-installer}"
if (( $# == 0 )) || [[ $1 == "--all" ]]; then
  if (( $# > 2 )); then
    echo "Error: --all accepts only an optional checkout path." >&2
    exit 1
  fi
  PKGS=(omarchy-settings-dev omarchy-dev)
  # makepkg -s could install the repository settings package while building
  # the runtime package. Resolve runtime dependencies in the final transaction.
  MAKEPKG_ARGS=(--nodeps)
else
  PKGS=("$(dev_package_name "$1")")
  MAKEPKG_ARGS=(-s "${@:3}")
fi
PKGBUILDS_ROOT="${OMARCHY_PKGBUILDS_DIR:-$HOME/Work/omarchy/omarchy-pkgs/pkgbuilds}"

if [[ ! -d $CHECKOUT ]]; then
  echo "Error: checkout not found at $CHECKOUT" >&2
  exit 1
fi
CHECKOUT=$(realpath -- "$CHECKOUT")

for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  if [[ ! -f "$PKGBUILD_DIR/PKGBUILD" ]]; then
    echo "Error: PKGBUILD not found at $PKGBUILD_DIR/PKGBUILD" >&2
    echo "       Pass a different package name as arg 1, or set OMARCHY_PKGBUILDS_DIR." >&2
    exit 1
  fi
done

build_dir=$(mktemp -d -t omarchy-dev-pkg-test.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT
build_dir=$(realpath -- "$build_dir")

new_pkgver=$(handheld_pkgver_for_checkout "$CHECKOUT")
built_packages=()

for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  package_build_dir="$build_dir/$PKG"
  package_output_dir="$build_dir/archives/$PKG"
  mkdir -p "$package_build_dir" "$package_output_dir"
  cp -a "$PKGBUILD_DIR/." "$package_build_dir/"

  remove_pkgver_function "$package_build_dir/PKGBUILD"
  sed -i "s/^pkgver=.*/pkgver=${new_pkgver}/" "$package_build_dir/PKGBUILD"

  echo "Building $PKG ${new_pkgver} from $CHECKOUT"
  echo "  build dir: $package_build_dir"
  echo "  PKGBUILD : $PKGBUILD_DIR/PKGBUILD"
  echo

  (
    cd "$package_build_dir" &&
      OMARCHY_SRC="$CHECKOUT" PKGDEST="$package_output_dir" \
        makepkg --skipchecksums --noconfirm "${MAKEPKG_ARGS[@]}"
  ) || {
    status=$?
    if (( status == 13 )); then
      echo "Error: $PKG build was skipped by makepkg." >&2
    else
      echo "Error: $PKG build failed (exit $status)." >&2
    fi
    exit "$status"
  }

  package_list=$(
    cd "$package_build_dir" &&
      OMARCHY_SRC="$CHECKOUT" PKGDEST="$package_output_dir" makepkg --packagelist "${MAKEPKG_ARGS[@]}"
  ) || {
    status=$?
    echo "Error: could not list the archives for $PKG (exit $status)." >&2
    exit "$status"
  }

  # makepkg accounts for pkgrel, architecture and compression. Keep the
  # requested package at this pkgver, including recipes that set an epoch.
  matching_packages=()
  while IFS= read -r archive; do
    if [[ -f $archive && ${archive##*/} == "$PKG-"?(+([0-9]):)"$new_pkgver-"* ]]; then
      matching_packages+=("$archive")
    fi
  done <<<"$package_list"
  if (( ${#matching_packages[@]} != 1 )); then
    echo "Error: $PKG did not produce exactly one $new_pkgver archive." >&2
    exit 1
  fi
  built_packages+=("${matching_packages[0]}")
done

# Dev builds can replace files left by earlier script-installed versions.
sudo pacman -U --noconfirm --overwrite='*' "${built_packages[@]}"
