#!/bin/bash

# omarchy:summary=Remove the Battle.net desktop entry while keeping games, its prefix and shared runners

set -e

rm -f "$HOME/.local/share/applications/battlenet.desktop"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

echo "Battle.net desktop entry removed. Games and the prefix at $HOME/Games/battlenet were kept."
echo "UMU and Proton runners were kept for other launchers. Reinstall to restore the entry."
