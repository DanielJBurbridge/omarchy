#!/bin/bash
# omarchy:summary=Toggle the optional touch desktop keyboard
# omarchy:args=[toggle|show|hide|stop|--help]

set -euo pipefail

case "${1:-toggle}" in
  -h | --help)
    cat <<'HELP'
Usage: omarchy-toggle-desktop-keyboard [toggle|show|hide|stop]

Show a bottom overlay keyboard without resizing desktop windows.
Toggle is the default; show/hide are idempotent. Stop releases the process.
Requires optional wvkbd 0.21 or newer and a Hyprland desktop session.
Install it through the optional ROG Ally keyboard setup after reviewing AUR.
No automatic startup, input-device permissions or system service is needed.

Tap Desktop Keyboard in the bar or open it from Apps. On a configured RC71L,
Super+Ctrl+Y also toggles it. Enable menu.onScreenKeyboard in shell.json to
summon it when you click or tap menu search. On RC71L, desktopKeyboard.edgeSwipe
lets you swipe up from the handle at the bottom centre of the desktop.
The bottom-left symbol changes layouts. Full has Ctrl/Esc/arrows. Special has
Alt, Sup (Super) and AltGr. Abc returns to letters.
Cmp plus a letter opens accents; Cmp plus Space opens the layout index.
Modifiers are one-shot; the keyboard uses its own layouts, not the physical
keyboard's layout setting. Tap the bar button again to hide, or use hide.
Steam owns its keyboard in Gaming Mode; this command never starts Steam.
HELP
    exit 0
    ;;
  toggle | show | hide | stop | show-for-edge | show-for-menu | hide-for-menu) action=${1:-toggle} ;;
  *) echo 'Unknown action; use --help.' >&2; exit 2 ;;
esac
if [[ $action == "show-for-edge" ]]; then
  (( $# <= 2 )) && [[ ${2-0} =~ ^[0-7]$ ]] || { echo 'Expected a display transform from 0 to 7.' >&2; exit 2; }
elif (( $# > 1 )); then
  echo 'Too many arguments; use --help.' >&2
  exit 2
fi

fail() {
  echo "Desktop keyboard: $*" >&2
  # A bar tap runs this detached, so a missing keyboard would otherwise be silent.
  if [[ $* == *wvkbd-mobintl\ is\ missing* ]]; then
    omarchy-notification-send -u normal -i input-keyboard \
      "$(omarchy-i18n keyboard.missingTitle)" \
      "$(omarchy-i18n keyboard.missingBody)" >/dev/null 2>&1 || true
  fi
  exit 1
}
if [[ $action == "show" || $action == "toggle" || $action == "show-for-menu" || $action == "show-for-edge" ]]; then
  desktop=${XDG_CURRENT_DESKTOP:-}
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && ${desktop,,} != *gamescope* ]] ||
    fail 'show it in the Hyprland desktop; use the Steam keyboard in Gaming Mode.'
fi
[[ -n ${WAYLAND_DISPLAY:-} && -n ${XDG_RUNTIME_DIR:-} ]] || fail 'run inside your Wayland desktop session.'
[[ -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]] || fail 'runtime directory is not owned by this user.'
# Separate state for independent Wayland sessions; never signal by process name.
session=${WAYLAND_DISPLAY##*/}
[[ $session =~ ^[[:alnum:]_.-]+$ ]] || fail 'invalid Wayland display name.'
state="$XDG_RUNTIME_DIR/omarchy-desktop-keyboard-$session"
umask 077
mkdir -p "$state"
[[ -d $state && ! -L $state && -O $state ]] || fail 'unsafe state directory.'
exec 9>"$state/lock"
flock -x 9

# Match both the process start time and executable before signalling a saved PID.
# /proc/stat fields after the final ')' begin at field 3; starttime is field 22.
identity() {
  local stat executable
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/stat ]] || return 1
  stat=$(cat "/proc/$pid/stat") || return 1
  stat=${stat##*) }
  read -ra fields <<< "$stat"
  [[ ${fields[0]} != Z && ${fields[19]} == "$started" ]] || return 1
  executable=$(readlink "/proc/$pid/exe") || return 1
  # Linux retains the old executable inode across package replacement.
  [[ ${executable%" (deleted)"} == "$binary" ]]
}

pid='' started='' binary=''
alive=false
if [[ -f $state/process ]]; then
  read -r pid started binary < "$state/process" || true
  if identity; then alive=true; else rm -f "$state/process"; fi
fi

# Only hide a keyboard the menu showed. A manual action takes over its
# visibility, including one issued while the window is still mapping.
visibility=unknown
if $alive && [[ -f $state/visibility ]]; then
  read -r visibility < "$state/visibility" || true
fi

# Wayland delivers a seat's touch events without the hardware identity, and
# wvkbd chooses its own output. Require an unambiguous panel and touchscreen.
edge_can_show() {
  local panel
  [[ :${desktop,,}: == *:hyprland:* ]] || return 1
  omarchy-hw-rog-ally || return 1
  panel=$(hyprctl -j monitors | jq -er --argjson transform "$1" 'select(length == 1) | .[0] |
    select($transform == null or .transform == $transform) |
    select(.focused == true and .dpmsStatus == true and (.solitaryBlockedBy |
      type == "array" and index("WINDOWED") != null and index("LOCK") == null and index("WORKSPACE") == null)) |
    .name | select(test("^eDP-[0-9]+$"))') || return 1
  hyprctl -j devices | jq -e '.touch | length == 1 and (.[0].name |
    test("^nvtk0603:00-0603:f200($|-touchscreen$)"))' >/dev/null || return 1
  hyprctl -j activewindow | jq -e '.mapped == true and
    ([.class, .initialClass] | all(type == "string" and length > 0 and
      (ascii_downcase | contains("gamescope") | not)))' >/dev/null || return 1
  hyprctl -j layers | jq -e --arg panel "$panel" '
    .[$panel].levels as $l | keys == [$panel] and ($l["1"] | any(.namespace == "omarchy-keyboard-edge"))
    and ($l["2"] | type == "array" and all(.namespace == "omarchy-bar" or .namespace == "omarchy-dock"))
    and ($l["3"] | type == "array" and all(.namespace == "omarchy-notifications"))' >/dev/null
}

case "$action" in
  show-for-edge)
    [[ $(omarchy-shell lock isLocked 2>/dev/null) == "false" ]] || exit 0
    edge_can_show "${2:-null}" 2>/dev/null || exit 0
    action=show
    ;;
  show-for-menu)
    [[ $visibility != "manual" ]] || exit 0
    [[ $(omarchy-shell lock isLocked 2>/dev/null) == "false" ]] || exit 0
    if omarchy-hyprland-session-locked; then
      exit 0
    else
      # Exit 1 is the explicit unlocked result. Skip an unknown compositor.
      (( $? == 1 )) || exit 0
    fi
    layers=$(hyprctl -j layers 2>/dev/null) || exit 0
    jq -e 'type == "object" and ([.[] | .levels[][] | .namespace] |
      index("omarchy-menu") != null and index("omarchy-polkit") == null and index("wvkbd") == null)' \
      <<<"$layers" >/dev/null 2>&1 || exit 0
    ;;
  hide-for-menu)
    [[ $visibility == "menu" ]] || exit 0
    action=hide
    ;;
esac

# Linux delivers different pending signals by number. Let wvkbd read the
# previous control before sending another, so a quick hide wins over a show.
control_pending() {
  local field bits
  while read -r field bits _; do
    [[ $field == "ShdPnd:" ]] || continue
    (( 16#$bits )) || return 1
    if (( control_mask == 0 )); then
      control_mask=$((1 << ($(kill -l USR1) - 1) | 1 << ($(kill -l USR2) - 1) | 1 << ($(kill -l RTMIN) - 1)))
    fi
    (( 16#$bits & control_mask ))
    return
  done < "/proc/$pid/status"
  return 1
}

send_control() {
  local -i remaining=100 control_mask=0
  while control_pending; do
    (( remaining-- > 0 )) || fail 'keyboard did not receive the previous control.'
    sleep 0.02
  done
  identity && kill -s "$1" "$pid"
}

if $alive; then
  case "$action" in
    toggle)
      send_control RTMIN
      case "$visibility" in
        "manual" | "menu") visibility=hidden ;;
        "hidden") visibility=manual ;;
      esac
      ;;
    show | show-for-menu) send_control USR2 ;;
    hide) send_control USR1 ;;
    stop)
      # hide() releases held keys before removing the surface in wvkbd 0.21.
      kill -USR1 "$pid"
      sleep 0.1
      if identity; then kill -TERM "$pid"; fi
      rm -f "$state/process" "$state/visibility"
      exit 0
      ;;
  esac
elif [[ $action == hide || $action == stop ]]; then
  rm -f "$state/visibility"
  exit 0
else
  omarchy-cmd-present wvkbd-mobintl || fail 'wvkbd-mobintl is missing; use optional ROG Ally keyboard setup.'
  binary=$(readlink -f "$(type -P wvkbd-mobintl)")
  # Refuse older builds rather than starting an unexpectedly exclusive surface.
  flags=$("$binary" --help 2>&1) || fail 'cannot read wvkbd options.'
  [[ $flags == *--non-exclusive* && $flags == *--wayland-layer* ]] || fail 'wvkbd 0.21 or newer is required.'
  style=()
  if [[ -r $HOME/.local/state/omarchy/current/theme/colors.toml && $flags == *--text-press-sp* ]]; then
    # Use the shell palette and its monospace alias. Mix two levels of key
    # surfaces from the foreground, so both light and dark palettes work.
    mapfile -t style < <(omarchy-theme-color --all | awk -F '\t' '
      function channel(hex, i) { return strtonum("0x" substr(hex, i, 2)) }
      function mix(a, b, t,    i, rgb) {
        for (i = 1; i <= 5; i += 2)
          rgb = rgb sprintf("%02x", (1 - t) * channel(a, i) + t * channel(b, i) + .5)
        return rgb
      }
      function linear(c) { c /= 255; return c <= .04045 ? c / 12.92 : ((c + .055) / 1.055)^2.4 }
      function luminance(hex) {
        return .2126 * linear(channel(hex, 1)) + .7152 * linear(channel(hex, 3)) + .0722 * linear(channel(hex, 5))
      }
      $2 ~ /^#[[:xdigit:]]{6}$/ { palette[$1] = substr($2, 2) }
      END {
        bg = palette["background"]; text = palette["foreground"]; press = palette["accent"]
        if (!bg || !text) exit
        if (!press) press = mix(bg, text, .44)
        luma = luminance(press)
        ratio = (luma + .05) / (luminance(bg) + .05)
        pressed_text = ratio >= 4.5 || ratio <= 1/4.5 ? bg : (luma >= .179 ? "000000" : "ffffff")
        printf "--bg\n%s\n--fg\n%s\n--fg-sp\n%s\n--text\n%s\n--text-sp\n%s\n", bg, mix(bg, text, .14), mix(bg, text, .23), text, text
        printf "--press\n%s\n--press-sp\n%s\n--text-press\n%s\n--text-press-sp\n%s\n", press, press, pressed_text, pressed_text
        print "--fn\nmonospace 18\n-R\n6"
      }')
  fi
  # Six rows in full: 44 logical units per row, before upstream key borders.
  # At scale 2, 264 becomes 528px; no global display or physical keymap change.
  # Both orientations are explicit. No auto input-method or focus stealing.
  # wvkbd reads these through signalfd after its first Wayland round trips.
  # Queue early button presses even before the keyboard has mapped.
  nohup env --block-signal=USR1,USR2,RTMIN "$binary" -H 264 -L 264 --non-exclusive --wayland-layer overlay \
    -l full,special --landscape-layers full,special \
    --no-popup "${style[@]}" >"$state/output.log" 2>&1 < /dev/null 9>&- &
  pid=$!
  # Poll until the child is the keyboard we just started. A fixed sleep
  # returns before exec under load, and then the identity check fails closed.
  ready=false
  for _ in {1..100}; do
    # Once the child exits it cannot finish starting. Release the lock so
    # another tap can retry immediately.
    IFS= read -r stat 2>/dev/null <"/proc/$pid/stat" || break
    stat=${stat##*) }
    read -ra fields <<< "$stat"
    [[ ${fields[0]:-} != "Z" ]] || break
    started=${fields[19]:-}
    if [[ -n ${started:-} ]] && identity; then
      ready=true
      break
    fi
    sleep 0.02
  done
  $ready || fail "startup failed; see $state/output.log"
  printf '%s %s %s\n' "$pid" "$started" "$binary" > "$state/process"
  if [[ $action == "toggle" ]]; then visibility=manual; fi
fi

case "$action" in
  show) visibility=manual ;;
  hide) visibility=hidden ;;
  show-for-menu) visibility=menu ;;
esac
printf '%s\n' "$visibility" > "$state/visibility"
