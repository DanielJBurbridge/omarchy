#!/bin/bash
# omarchy:summary=Toggle the optional touch desktop keyboard
# omarchy:args=[toggle|show|hide|stop|--help]

set -euo pipefail

case "${1:-toggle}" in
  -h | --help)
    cat <<'HELP'
Usage: omarchy-toggle-desktop-keyboard [toggle|show|hide|stop]

Show a bottom overlay keyboard without resizing desktop windows.
Toggle is the default; show/hide are idempotent. Stop releases the process.
Requires optional wvkbd 0.21 or newer and a Hyprland desktop session.
Install it through the optional ROG Ally keyboard setup after reviewing AUR.
No automatic startup, input-device permissions or system service is needed.

Tap Desktop Keyboard in the bar or open it from Apps. On a configured RC71L,
Super+Ctrl+Y also toggles it. There is no swipe-up gesture or automatic
text-field activation. Tap the bottom-left keyboard symbol to change layouts:
full has Ctrl/Esc/arrows; special has Alt, Sup (Super) and AltGr. Abc returns
to letters. The keyboard symbol changes layouts; it does not hide the keyboard.
Cmp plus a letter opens accents; Cmp plus Space opens the layout index.
Modifiers are one-shot; the keyboard uses its own layouts, not the physical
keyboard's layout setting. Tap the bar button again to hide, or use hide.
Steam owns its keyboard in Gaming Mode; this command never starts Steam.
HELP
    exit 0
    ;;
  toggle | show | hide | stop) action=${1:-toggle} ;;
  *) echo 'Unknown action; use --help.' >&2; exit 2 ;;
esac
(( $# <= 1 )) || { echo 'Too many arguments; use --help.' >&2; exit 2; }

fail() { echo "Desktop keyboard: $*" >&2; exit 1; }
if [[ $action == "show" || $action == "toggle" ]]; then
  desktop=${XDG_CURRENT_DESKTOP:-}
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && ${desktop,,} != *gamescope* ]] ||
    fail 'show it in the Hyprland desktop; use the Steam keyboard in Gaming Mode.'
fi
[[ -n ${WAYLAND_DISPLAY:-} && -n ${XDG_RUNTIME_DIR:-} ]] || fail 'run inside your Wayland desktop session.'
[[ -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]] || fail 'runtime directory is not owned by this user.'
# Separate state for independent Wayland sessions; never signal by process name.
session=${WAYLAND_DISPLAY##*/}
[[ $session =~ ^[[:alnum:]_.-]+$ ]] || fail 'invalid Wayland display name.'
state="$XDG_RUNTIME_DIR/omarchy-desktop-keyboard-$session"
umask 077
mkdir -p "$state"
[[ -d $state && ! -L $state && -O $state ]] || fail 'unsafe state directory.'
exec 9>"$state/lock"
flock -x 9

# Match both the process start time and executable before signalling a saved PID.
# /proc/stat fields after the final ')' begin at field 3; starttime is field 22.
identity() {
  local stat executable
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/stat ]] || return 1
  stat=$(cat "/proc/$pid/stat") || return 1
  stat=${stat##*) }
  read -ra fields <<< "$stat"
  [[ ${fields[0]} != Z && ${fields[19]} == "$started" ]] || return 1
  executable=$(readlink "/proc/$pid/exe") || return 1
  # Linux retains the old executable inode across package replacement.
  [[ ${executable%" (deleted)"} == "$binary" ]]
}

pid='' started='' binary=''
alive=false
if [[ -f $state/process ]]; then
  read -r pid started binary < "$state/process" || true
  if identity; then alive=true; else rm -f "$state/process"; fi
fi

if $alive; then
  case "$action" in
    toggle) kill -RTMIN "$pid" ;;
    show) kill -USR2 "$pid" ;;
    hide) kill -USR1 "$pid" ;;
    stop)
      # hide() releases held keys before removing the surface in wvkbd 0.21.
      kill -USR1 "$pid"
      sleep 0.1
      if identity; then kill -TERM "$pid"; fi
      rm -f "$state/process"
      ;;
  esac
elif [[ $action == hide || $action == stop ]]; then
  exit 0
else
  omarchy-cmd-present wvkbd-mobintl || fail 'wvkbd-mobintl is missing; use optional ROG Ally keyboard setup.'
  binary=$(readlink -f "$(type -P wvkbd-mobintl)")
  # Refuse older builds rather than starting an unexpectedly exclusive surface.
  flags=$("$binary" --help 2>&1) || fail 'cannot read wvkbd options.'
  [[ $flags == *--non-exclusive* && $flags == *--wayland-layer* ]] || fail 'wvkbd 0.21 or newer is required.'
  # Six rows in full: 44 logical units per row, before upstream key borders.
  # At scale 2, 264 becomes 528px; no global display or physical keymap change.
  # Both orientations are explicit. No auto input-method or focus stealing.
  nohup "$binary" -H 264 -L 264 --non-exclusive --wayland-layer overlay \
    -l full,special --landscape-layers full,special \
    --no-popup >"$state/output.log" 2>&1 < /dev/null 9>&- &
  pid=$!
  sleep 0.2
  [[ -r /proc/$pid/stat ]] || fail "startup failed; see $state/output.log"
  stat=$(cat "/proc/$pid/stat")
  stat=${stat##*) }
  read -ra fields <<< "$stat"
  started=${fields[19]}
  identity || fail "startup failed; see $state/output.log"
  printf '%s %s %s\n' "$pid" "$started" "$binary" > "$state/process"
fi
