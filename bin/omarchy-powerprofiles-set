#!/bin/bash

# omarchy:summary=Set and remember the power profile for AC or battery use
# omarchy:args=[--ppd-only] [autodetect|ac|battery] [power-saver|balanced|performance]

ppd_only=false
if [[ ${1:-} == "--ppd-only" ]]; then
  ppd_only=true
  shift
fi
action="${1:-autodetect}"
requested_profile="${2:-}"

usage() {
  echo "Usage: omarchy-powerprofiles-set [--ppd-only] [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
  exit 1
}

(( $# <= 2 )) || usage

case "$action" in
  autodetect)
    # Use the same signal as the shell (UPower.onBattery) so every entry point
    # saves and restores the profile under the same ac/battery key.
    if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
      action=battery
    else
      action=ac
    fi
    ;;
  ac | battery) ;;
  *) usage ;;
esac

# shellcheck source=/dev/null
source "$OMARCHY_PATH/default/ally-tdp/profiles.sh"
ally_tdp=0
if ! $ppd_only && ally_tdp_profiles_enabled; then
  # Wake and AC changes reapply the shared request from the root services.
  # Only an explicit preset should replace a request made in Gaming Mode.
  [[ -n $requested_profile ]] || exit 0
  ally_tdp=1
  profiles=()
  while IFS=$'\t' read -r name _; do
    profiles+=("$name")
  done < <(ally_tdp_profiles)
  if (( ${#profiles[@]} == 0 )); then
    echo "Ally power profiles are unavailable." >&2
    exit 1
  fi
else
  mapfile -t profiles < <(omarchy-powerprofiles-list --ppd-only)
  if $ppd_only && (( ${#profiles[@]} == 0 )); then
    echo "Power profiles are unavailable." >&2
    exit 1
  fi
fi

profile_available() {
  local available
  for available in "${profiles[@]}"; do
    [[ $available == "$1" ]] && return 0
  done
  return 1
}

state_dir="${OMARCHY_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/powerprofiles}"
state_file="$state_dir/$action"

if [[ -n $requested_profile ]]; then
  profile_available "$requested_profile" || {
    echo "Power profile is not available: $requested_profile" >&2
    exit 1
  }

  profile="$requested_profile"
elif [[ -r $state_file ]]; then
  profile=$(<"$state_file")
fi

if [[ -z ${profile:-} ]] || ! profile_available "$profile"; then
  if [[ $action == "ac" ]] && profile_available performance; then
    profile=performance
  else
    profile=balanced
  fi
fi

# The writer checks ownership again and clamps to the current power source.
if (( ally_tdp )); then
  omarchy-ally-tdp-apply --set-profile "$profile" || exit
else
  powerprofilesctl set "$profile" || exit
fi
omarchy-shell -q battery refreshPowerProfile >/dev/null 2>&1 || true

if [[ -n $requested_profile ]]; then
  mkdir -p "$state_dir"
  printf '%s\n' "$requested_profile" >"$state_file"
fi
