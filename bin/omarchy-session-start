#!/bin/bash
# omarchy:hidden=true
# omarchy:summary=Supervise the optional authenticated handheld login session
# omarchy:args=<preferred|gaming|relogin|authenticated-desktop>

set -uo pipefail
# Set when an explicit Switch to Desktop wrote next=desktop for this process.
gaming_desktop_next=0
desktop_input_pid=''
desktop_input_fd=''
# A non-login ssh command does not source env-bootstrap, and set -u then
# aborts on the next line when that file is absent. Same fallback as
# env-bootstrap and omarchy-migrate. The bootstrap still replaces this
# when it is installed.
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
# This is a pre-UWSM login boundary; use the canonical environment bootstrap.
# shellcheck source=/dev/null
source /usr/share/omarchy/default/bash/env-bootstrap
source "$OMARCHY_PATH/default/gaming/session.sh"
# shellcheck source=/dev/null
source "$OMARCHY_PATH/default/gaming/steam-ready.sh"
(( $# == 1 )) || exit 2
case $1 in
  preferred | gaming | relogin | authenticated-desktop | sddm) ;;
  *) exit 2 ;;
esac

# Hyprland instance sockets already on disk belong to an earlier compositor.
existing_hypr_sockets() {
  local signature_root=${XDG_RUNTIME_DIR:-}/hypr entry
  [[ -n ${XDG_RUNTIME_DIR:-} && -d $signature_root ]] || return 0
  for entry in "$signature_root"/*/.socket.sock "$signature_root"/*/.socket2.sock; do
    if [[ -S $entry ]]; then
      printf '%s\n' "$entry"
    fi
  done
}

# Hyprland is up when a new $XDG_RUNTIME_DIR/hypr/<instance>/.socket.sock
# appears. Nothing pushes that creation, so this waits only until the socket
# shows or the handoff gives up. The caller stops it when uwsm returns.
drop_desktop_next_after_hyprland() {
  local before=$1 signature_root=${XDG_RUNTIME_DIR:-}/hypr waited=0 entry prior found
  # The session flock is on fd 9. Drop it before waiting so a child cannot
  # keep the next login out after this supervisor exits.
  exec 9>&-
  [[ -n ${XDG_RUNTIME_DIR:-} && -n ${gaming_state:-} ]] || return 0
  while (( waited < 600 )); do
    if [[ -d $signature_root ]]; then
      for entry in "$signature_root"/*/.socket.sock "$signature_root"/*/.socket2.sock; do
        [[ -S $entry ]] || continue
        found=0
        while IFS= read -r prior; do
          if [[ $prior == "$entry" ]]; then
            found=1
          fi
        done <<< "$before"
        if (( found == 0 )); then
          rm -f -- "$gaming_state/next"
          return 0
        fi
      done
    fi
    sleep 0.1
    waited=$(( waited + 1 ))
  done
}

start_hyprland() {
  export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
  # UWSM intentionally removes XDG_SESSION_ID from the user manager. Carry our
  # managed login identity through its normal environment import/cleanup.
  if [[ -n ${gaming_runtime:-} ]]; then export OMARCHY_HANDHELD_SESSION=$XDG_SESSION_ID; fi
  unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
  if [[ -n ${gaming_state:-} && -f $gaming_state/preference-reset ]]; then
    rm -f "$gaming_state/preference-reset"
    omarchy-notification-send 'Omarchy' 'Session preference reset' || true
  fi
  local next_watch_pid='' before
  if (( gaming_desktop_next )); then
    before=$(existing_hypr_sockets)
    drop_desktop_next_after_hyprland "$before" &
    next_watch_pid=$!
  fi
  uwsm start -g -1 -e -D Hyprland hyprland.desktop
  local status=$?
  if [[ -n $next_watch_pid ]]; then
    kill "$next_watch_pid" 2>/dev/null || true
    wait "$next_watch_pid" 2>/dev/null || true
  fi
  unset OMARCHY_HANDHELD_SESSION
  return "$status"
}

start_desktop_input() {
  # Keep the observer in the original login, where the broker can check
  # Polkit's active/local session. Do not hand profile requests to UWSM.
  coproc DESKTOP_INPUT {
    exec python3 "$OMARCHY_PATH/default/gaming/input-profile-watch.py" "$1" 9>&-
  }
  desktop_input_pid=$!
  desktop_input_fd=${DESKTOP_INPUT[1]:-}
  # The observer subscribes before making its first bounded profile request.
  # If it is unavailable, Hyprland can still start.
  if [[ -n ${DESKTOP_INPUT[0]:-} ]]; then
    read -r -t 4 -u "${DESKTOP_INPUT[0]}" _ || true
  fi
}

stop_desktop_input() {
  [[ -n $desktop_input_pid ]] || return 0
  if [[ -n $desktop_input_fd ]]; then
    exec {desktop_input_fd}>&-
  fi
  # Let the observer finish restoring the greeter before the next session.
  wait "$desktop_input_pid" || true
  desktop_input_pid=''
  desktop_input_fd=''
}

# This supervisor cannot secure the new compositor before it starts. An
# existing shell could answer a lock request for a different compositor.
# Return 10 to keep the desktop closed when policy requires a lock.
desktop() {
  if [[ ${1:-} != authenticated && $(gaming_desktop_lock_effective) == on ]]; then
    echo 'Desktop lock is required. Sign in to Hyprland from the greeter.' >> "$gaming_state/session.log"
    return 10
  fi
  local status=0 profile=desktop
  if (( ${gaming_fallback:-0} )); then
    profile=osk
  fi
  if gaming_handheld_variant; then
    start_desktop_input "$profile"
  fi
  start_hyprland || status=$?
  stop_desktop_input
  return "$status"
}

handheld_autologin_stopped() {
  local dir=${OMARCHY_HANDHELD_AUTOLOGIN_DIR:-/run/omarchy/handheld-autologin}
  [[ -f $dir/stop && ! -L $dir/stop ]]
}

note_root_failure() {
  if omarchy-cmd-present omarchy-handheld-autologin; then
    omarchy-handheld-autologin fail || true
  fi
}

# Wayland sockets share the runtime directory with other compositors. Read
# the socket of the new Hyprland instance rather than taking the first one.
gaming_wayland_display() {
  local display
  display=$(hyprctl instances -j 2>/dev/null |
    jq -er --arg instance "$1" '.[] | select(.instance == $instance) | .wl_socket | strings') || return 1
  [[ $display =~ ^wayland-[[:alnum:]_.-]+$ && -S $XDG_RUNTIME_DIR/$display ]] || return 1
  printf '%s\n' "$display"
}

gaming_start_osk() {
  local before=${1-} signature_root waited=0 entry prior found signature display
  signature_root=${XDG_RUNTIME_DIR:-}/hypr
  [[ -n ${XDG_RUNTIME_DIR:-} && -n ${gaming_state:-} ]] || return 0
  while (( waited < 600 )); do
    if [[ -d $signature_root ]]; then
      for entry in "$signature_root"/*/.socket.sock "$signature_root"/*/.socket2.sock; do
        [[ -S $entry ]] || continue
        found=0
        while IFS= read -r prior; do
          if [[ $prior == "$entry" ]]; then
            found=1
          fi
        done <<< "$before"
        if (( found == 0 )); then
          signature=${entry%/*}
          signature=${signature##*/}
          display=$(gaming_wayland_display "$signature") || continue
          if omarchy-cmd-present omarchy-toggle-desktop-keyboard; then
            HYPRLAND_INSTANCE_SIGNATURE=$signature WAYLAND_DISPLAY=$display \
              XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland \
              omarchy-toggle-desktop-keyboard show ||
              printf '%s\n' 'on-screen keyboard did not start' >> "$gaming_state/fallback.log"
          else
            printf '%s\n' 'on-screen keyboard helper is missing' >> "$gaming_state/fallback.log"
          fi
          return 0
        fi
      done
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  printf '%s\n' 'on-screen keyboard gave up waiting for Hyprland' >> "$gaming_state/fallback.log"
}

# SDDM starts its next greeter when the session exits successfully. Only
# signal a clean handoff after its protected sign-in policy is in place.
prepare_desktop_signin() {
  local dropin=/etc/sddm.conf.d/zz-omarchy-handheld.conf
  omarchy-handheld-autologin apply && grep -Fxq 'Relogin=false' "$dropin"
}

# The recovery desktop has an on-screen keyboard. Relogin stays pinned off
# when the root helper can act. The managed loop handles any explicit retry.
# A required lock stays at the greeter instead of opening an unlocked session.
gaming_fail_limit_fallback() {
  local status=0 osk_pid='' spins=0 before
  gaming_fallback=1
  if [[ -n ${gaming_state:-} && -d $gaming_state && ! -L $gaming_state ]]; then
    gaming_save recovery "$gaming_fail_limit_latch" || true
  fi
  if ! handheld_autologin_stopped; then
    note_root_failure
  fi
  if [[ $(gaming_desktop_lock_effective) == on ]]; then
    if [[ -n ${gaming_state:-} && -d $gaming_state && ! -L $gaming_state ]]; then
      printf '%s\n' 'Desktop lock is required; not starting the fail-limit desktop. Sign in to Hyprland from the greeter.' >> "$gaming_state/session.log"
    else
      printf '%s\n' 'Omarchy Gaming: desktop lock is required; not starting the fail-limit desktop. Sign in to Hyprland from the greeter.' >&2
    fi
    prepare_desktop_signin
    return $?
  fi
  if [[ -n ${gaming_state:-} && -d $gaming_state && ! -L $gaming_state ]]; then
    printf '%s\n' 'Gaming failed repeatedly; starting the Hyprland desktop with the on-screen keyboard.' >> "$gaming_state/fallback.log"
  else
    printf '%s\n' 'Omarchy Gaming: fail limit tripped and the state directory is not writable; starting the desktop.' >&2
  fi
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    # Snapshot the sockets before this compositor starts. The waiter can be
    # scheduled after uwsm has created the new one.
    before=$(existing_hypr_sockets)
    gaming_start_osk "$before" 9>&- &
    osk_pid=$!
  fi
  desktop || status=$?
  if [[ -n $osk_pid ]]; then
    while kill -0 "$osk_pid" 2>/dev/null && (( spins < 20 )); do
      sleep 0.1 9>&-
      spins=$((spins + 1))
    done
    kill "$osk_pid" 2>/dev/null || true
    wait "$osk_pid" 2>/dev/null || true
  fi
  # A desktop refused by the lock gate cannot make an explicit switch.
  if (( status == 10 )); then
    prepare_desktop_signin
    return $?
  fi
  return "$status"
}

gaming_state_unusable_exit() {
  printf '%s\n' 'Omarchy Gaming: the gaming state directory is not usable.' >&2
  if ! omarchy-cmd-present omarchy-handheld-autologin; then
    printf '%s\n' 'omarchy-handheld-autologin is missing; starting the desktop.' >&2
    gaming_fail_limit_fallback
    exit $?
  fi
  if ! omarchy-handheld-autologin fail; then
    printf '%s\n' 'omarchy-handheld-autologin could not record the failed start; starting the desktop.' >&2
    gaming_fail_limit_fallback
    exit $?
  fi
  if omarchy-handheld-autologin tripped; then
    printf '%s\n' 'the autologin fail limit tripped; starting the desktop.' >&2
    gaming_fail_limit_fallback
    exit $?
  fi
  exit 1
}

desktop_login_properties() {
  # SDDM invokes this entry in its own PAM session, before UWSM moves apps
  # to the user manager. Ask logind for the caller, using the system bus.
  (exec -c /usr/bin/timeout --kill-after=1s 2s /usr/bin/loginctl --no-pager show-session "$1" \
    -p Id -p Active -p Class -p Remote -p Seat -p Service -p State -p Type -p User)
}

is_local_desktop_login() {
  local expected
  for expected in Class=user Remote=no Seat=seat0 Type=wayland "User=$UID"; do
    grep -Fxq "$expected" <<< "$1" || return 1
  done
  grep -Eq '^Service=sddm(-autologin)?$' <<< "$1"
}

sddm_login_id() {
  local properties session
  properties=$(desktop_login_properties self) || return 1
  is_local_desktop_login "$properties" && grep -Fxq 'Active=yes' <<< "$properties" &&
    grep -Fxq "Service=$1" <<< "$properties" || return 1
  if [[ $1 == sddm-autologin ]]; then
    grep -Fxq 'State=active' <<< "$properties" || return 1
  fi
  session=$(sed -n 's/^Id=//p' <<< "$properties")
  [[ $session =~ ^[[:alnum:]_-]+$ ]] || return 1
  printf '%s\n' "$session"
}

# Keep the boot ID in private persistent state so it outlives SDDM and the
# user's runtime directory. The directory lock serialises the check and write
# across different login IDs. The stamp only selects a policy.
claim_sddm_boot() (
  local boot_id previous stamp=sddm-boot-id
  local uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  IFS= read -r boot_id < /proc/sys/kernel/random/boot_id || return 1
  [[ $boot_id =~ $uuid ]] || return 1
  cd -P -- "$gaming_state" || return 1
  [[ -O . && $(stat -c %a -- .) == 700 ]] || return 1
  exec 8<. && flock -w 1 8 || return 1
  if [[ -e $stamp || -L $stamp ]]; then
    [[ -f $stamp && ! -L $stamp && -O $stamp && $(stat -c %a -- "$stamp") == 600 ]] || return 1
    previous=$(timeout --kill-after=1s 1s head -c 37 -- "$stamp") || return 1
    [[ $previous =~ $uuid && $previous != "$boot_id" ]] || return 1
  fi
  gaming_state=.
  gaming_save "$stamp" "$boot_id"
)

retire_closed_desktop() {
  local session=${XDG_SESSION_ID:-} unit=wayland-wm@hyprland.desktop.service
  local snapshot pid owner current previous units attempt
  local properties=(-p ActiveState -p MainPID -p InvocationID)
  [[ -n $session ]] || return 0
  snapshot=$(systemctl --user show "$unit" "${properties[@]}" 2>/dev/null) || return 0
  grep -Fxq 'ActiveState=active' <<< "$snapshot" &&
    grep -Eq '^InvocationID=[0-9a-f]{32}$' <<< "$snapshot" || return 0
  pid=$(sed -n 's/^MainPID=//p' <<< "$snapshot")
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 0
  owner=$(grep -az '^OMARCHY_HANDHELD_SESSION=' "/proc/$pid/environ" 2>/dev/null | tr '\0' '\n') || return 0
  owner=${owner#*=}
  [[ $owner =~ ^[[:alnum:]_-]+$ && $owner != "$session" ]] || return 0

  current=$(desktop_login_properties self) && previous=$(desktop_login_properties "$owner") || return 0
  is_local_desktop_login "$current" && grep -Fxq "Id=$session" <<< "$current" &&
    grep -Fxq 'Active=yes' <<< "$current" && grep -Fxq 'State=active' <<< "$current" || return 0
  is_local_desktop_login "$previous" && grep -Fxq "Id=$owner" <<< "$previous" &&
    grep -Fxq 'State=closing' <<< "$previous" || return 0
  # SDDM can close PAM before UWSM's user service exits. Stop only the
  # managed compositor whose exact service invocation was just checked.
  [[ $(systemctl --user show "$unit" "${properties[@]}" 2>/dev/null) == "$snapshot" ]] || return 0
  printf '%s\n' "Closing the remaining Hyprland service from session $owner." >> "$gaming_state/fallback.log"
  timeout --kill-after=1s 12s systemctl --user stop "$unit" || return 1
  for ((attempt=0; attempt < 30; attempt++)); do
    units=$(timeout 1s systemctl --user list-units --no-legend --plain --state=active,activating,deactivating \
      "$unit" wayland-wm-env@hyprland.desktop.service wayland-session@hyprland.desktop.target \
      wayland-session-pre@hyprland.desktop.target wayland-session-shutdown.target \
      graphical-session.target graphical-session-pre.target) || return 1
    [[ -z $units ]] && return 0
    sleep 0.1
  done
  return 1
}

if ! omarchy-hw-rog-ally || { [[ $1 == authenticated-desktop ]] && ! omarchy-pkg-present omarchy-gaming-session; }; then
  start_hyprland
  exit $?
fi
desktop_entry=''
autologin_id=''
if [[ $1 == authenticated-desktop ]]; then
  if ! XDG_SESSION_ID=$(sddm_login_id sddm); then
    gaming_fail 'Sign in through the local SDDM greeter to start the managed desktop.'
    exit 1
  fi
  export XDG_SESSION_ID
  unset OMARCHY_HANDHELD_SESSION
  desktop_entry=authenticated
elif [[ $1 == sddm ]] && omarchy-pkg-present omarchy-gaming-session && autologin_id=$(sddm_login_id sddm-autologin); then
  export XDG_SESSION_ID=$autologin_id
  unset OMARCHY_HANDHELD_SESSION
fi
if ! gaming_state_init; then
  if [[ -n $desktop_entry ]]; then
    gaming_fail 'The managed desktop state directory is not usable.'
    exit 1
  fi
  gaming_state_unusable_exit
fi
if ! gaming_runtime_init; then
  if [[ -n $desktop_entry ]]; then
    gaming_fail 'The managed desktop runtime directory is not usable.'
    exit 1
  fi
  gaming_failure_record || true
  note_root_failure
  if gaming_fail_limit_reached; then
    gaming_fail_limit_fallback
    exit $?
  fi
  exit 1
fi
if ! { exec 9>"$gaming_runtime/lock" && flock -n 9; }; then
  gaming_fail 'a managed session is already running.'
  exit 1
fi
if ! retire_closed_desktop; then
  gaming_fail 'The previous managed desktop did not finish closing.'
  exit 1
fi
# Pre-ready returns are counted for this login. Ready clears the count too.
gaming_early_return_reset
gaming_clear_waiter_latch
if [[ -n $desktop_entry ]]; then
  selection=desktop
elif [[ $1 == gaming ]]; then
  gaming_failure_reset
  rm -f -- "$gaming_state/recovery"
  selection=gaming
else
  entry=$1
  if [[ $entry == sddm ]]; then
    if [[ -n $autologin_id ]] && claim_sddm_boot; then
      entry=preferred
    else
      entry=relogin
    fi
  fi
  selection=$(gaming_entry_selection "$entry")
  if gaming_fail_limit_blocked || handheld_autologin_stopped; then
    selection=recovery
  fi
fi
scope=omarchy-gamescope-$XDG_SESSION_ID.scope
gaming_session_target=omarchy-gaming-session.target
scope_pid='' ready_pid='' return_pid=''
gaming_target_started=0
gaming_autologin_ready=0
gaming_explicit_desktop=0
gaming_fallback=0
gaming_attempt_recorded=0
autologin_watch=0

take_gaming_switch() {
  local request=$gaming_runtime/switch
  [[ -f $request && ! -L $request && -O $request && $(cat "$request") == "gaming" ]] &&
    rm -f -- "$request"
}

request_gaming_shutdown() {
  local deadline_pid finished=''
  [[ -p $gaming_runtime/shutdown ]] && kill -0 "$scope_pid" 2>/dev/null || return 0
  # Ask the Steam client to close while Xwayland is still running. A TERM
  # to the whole scope can make Gamescope restart Xwayland during teardown.
  # shellcheck disable=SC2016
  if timeout 1s bash -c 'printf "steam\n" > "$1"' _ "$gaming_runtime/shutdown"; then
    sleep 5 &
    deadline_pid=$!
    wait -n -p finished "$scope_pid" "$deadline_pid" 2>/dev/null || true
    if [[ ${finished:-} != "$deadline_pid" ]]; then
      kill "$deadline_pid" 2>/dev/null || true
      wait "$deadline_pid" 2>/dev/null || true
    elif [[ -f $gaming_runtime/steam-exit && $(< "$gaming_runtime/steam-exit") == "0" ]]; then
      # Steam finished normally. After resume, Gamescope can still get stuck
      # and restart Xwayland on TERM. Retire only this session's scope.
      printf '%s\n' 'Gamescope stayed up after Steam exited. Killing its remaining scope processes.' >> "$gaming_state/fallback.log"
      systemctl --user kill --kill-whom=all --signal=KILL "$scope" 2>/dev/null || true
    else
      printf '%s\n' 'Steam did not exit cleanly after the shutdown request. Stopping the Gamescope scope.' >> "$gaming_state/fallback.log"
    fi
  fi
}

stop_gaming() {
  if [[ -n $scope_pid ]]; then
    systemctl --user stop "$scope" || true
    # A scope that ignores the stop must not hold the next login open.
    local waited=0
    while kill -0 "$scope_pid" 2>/dev/null && (( waited < 20 )); do
      sleep 0.1
      waited=$(( waited + 1 ))
    done
    kill "$scope_pid" 2>/dev/null || true
    wait "$scope_pid" 2>/dev/null || true
    scope_pid=''
  fi
  for child in "$ready_pid" "$return_pid"; do
    if [[ -n $child ]]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi
  done
  ready_pid='' return_pid=''
  rm -f "$gaming_runtime/ready" "$gaming_runtime/return" "$gaming_runtime/shutdown"
  # Drop the session target before the desktop starts, so units bound with
  # PartOf= stop with the gamescope session and stay down on the desktop.
  if (( gaming_target_started )); then
    systemctl --user stop "$gaming_session_target" || true
    gaming_target_started=0
  fi
}

return_to_desktop_signin() {
  if ! prepare_desktop_signin >> "$gaming_state/session.log" 2>&1; then
    printf '%s\n' 'Could not prepare desktop sign-in. The required lock still prevents opening Hyprland.' >> "$gaming_state/session.log"
    return 1
  fi
  rm -f -- "$gaming_state/next"
  # The active gaming login can ask the broker to restore the greeter profile
  # before sign-out. Touch and a USB keyboard still work if the broker fails.
  busctl --timeout=3s --auto-start=no call \
    org.omarchy.InputPlumberProfile /org/omarchy/InputPlumberProfile \
    org.omarchy.InputPlumberProfile Load s pointer >> "$gaming_state/session.log" 2>&1 || true
  printf '%s\n' 'Desktop authentication is required. Returning to SDDM sign-in.' >> "$gaming_state/session.log"
}

cleanup() {
  stop_desktop_input
  stop_gaming
  rm -f "$gaming_runtime/active" "$gaming_runtime/switch"
  # A session that exits without Steam becoming ready is a failed gaming
  # start. Ready, an explicit Switch to Desktop, and the fail-limit fallback
  # are not another one.
  if (( autologin_watch && ! gaming_autologin_ready && ! gaming_explicit_desktop && ! gaming_fallback )); then
    if omarchy-cmd-present omarchy-handheld-autologin; then
      omarchy-handheld-autologin fail || true
    fi
  fi
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

if [[ $1 == sddm && $entry == preferred && $selection == desktop && $(gaming_desktop_lock_effective) == on ]]; then
  return_to_desktop_signin
  exit $?
fi

run_gaming() {
  omarchy-cmd-present gamescope && omarchy-cmd-present steam || return 2
  # A surviving desktop client would forward the startup request elsewhere.
  if pgrep -u "$UID" -x steam >/dev/null; then
    gaming_fail 'Steam is still running. Exit Steam before switching sessions.'
    return 2
  fi
  gaming_display_args || { gaming_fail 'invalid display settings; reset them.'; return 2; }
  # These companion integrations are optional; installed backends own their
  # resources and a failed mode switch must not leave a half-switched session.
  # The older input companion shipped the profiles, while its runtime
  # supplied this helper. Current runtimes load the gaming profile via the target.
  if omarchy-cmd-present omarchy-hw-rog-ally-input && omarchy-pkg-present omarchy-rog-ally-input; then
    omarchy-hw-rog-ally-input gamepad || return 1
  fi
  local display_args=() display_output
  display_output=$(omarchy-gaming-output gamescope-args) || return 1
  if [[ -n $display_output ]]; then mapfile -t display_args <<< "$display_output"; fi
  if [[ -f $gaming_state/overlay && $(cat "$gaming_state/overlay") == "on" ]]; then
    omarchy-cmd-present mangoapp || { gaming_fail 'install MangoHud or disable the session overlay.'; return 1; }
    gamescope_args+=(--mangoapp)
  fi
  rm -f "$gaming_runtime/ready" "$gaming_runtime/return" "$gaming_runtime/shutdown" "$gaming_runtime/steam-exit"
  mkfifo -m 600 "$gaming_runtime/ready" "$gaming_runtime/return" "$gaming_runtime/shutdown" || return 1
  (read -r event <> "$gaming_runtime/return" && [[ $event == "desktop" ]]) &
  return_pid=$!
  export OMARCHY_GAMING_RUNTIME=$gaming_runtime
  export XDG_CURRENT_DESKTOP=gamescope XDG_SESSION_DESKTOP=gamescope
  unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
  mv -f "$gaming_state/session.log" "$gaming_state/session.previous.log" 2>/dev/null || true
  # Group Gamescope and its children for teardown. Scope membership does not
  # establish logind session membership or target DRM/libseat access.
  # Scope stop owns only this session's subtree, including games and helpers.
  # Spec 04's overlay sits on the root Xwayland, so Gamescope always gets two.
  # The target is handheld-only: this function runs after the Ally gate above.
  # Older gaming-session packages have no vendor units. Supply missing
  # files in that case and honour any existing user units and masks.
  if [[ ! -f /usr/lib/systemd/user/$gaming_session_target ]]; then
    local gaming_unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
    local unit
    for unit in "$gaming_session_target" omarchy-gaming-input-profile.service \
      omarchy-rog-ally-input.service.d/10-gaming-session.conf \
      omarchy-ally-tdp-shim.service.d/10-gaming-session.conf; do
      if [[ ! -e $gaming_unit_dir/$unit && ! -L $gaming_unit_dir/$unit ]]; then
        install -D -m 644 "$OMARCHY_PATH/default/systemd/user/$unit" "$gaming_unit_dir/$unit" || return 1
      fi
    done
  fi
  systemctl --user daemon-reload || true
  # Starting the target runs the profile oneshot (Wants= and the .wants link).
  # The bridge unit, when that package is installed, is After= that oneshot.
  systemctl --user start "$gaming_session_target" || return 1
  gaming_target_started=1
  if systemctl --user cat omarchy-rog-ally-input.service >/dev/null 2>&1; then
    systemctl --user start omarchy-rog-ally-input.service || true
  fi
  # Restart the installed shim so Steam can read the current TDP settings.
  if systemctl --user cat omarchy-ally-tdp-shim.service >/dev/null 2>&1; then
    systemctl --user restart omarchy-ally-tdp-shim.service || true
  fi
  local ready_timeout=${OMARCHY_GAMING_READY_TIMEOUT:-60}
  [[ $ready_timeout =~ ^[0-9]+([.][0-9]+)?$ ]] || ready_timeout=60
  # Give Steam its full readiness window after the session units have started.
  # Opening the FIFO read/write includes the wait for the first writer.
  (read -r -t "$ready_timeout" event <> "$gaming_runtime/ready" && [[ $event == "started" ]]) &
  ready_pid=$!
  local library_args=()
  if [[ -s $gaming_state/library ]] && omarchy-pkg-present omarchy-gaming-session; then
    library_args+=("$(<"$gaming_state/library")")
  fi
  systemd-run --user --scope --quiet --collect --unit="$scope" \
    --property=TimeoutStopSec=15s \
    gamescope --backend drm -e --xwayland-count 2 --default-touch-mode 4 \
    "${display_args[@]}" "${gamescope_args[@]}" -- "$OMARCHY_PATH/bin/omarchy-gaming-steam" "${library_args[@]}" \
    > "$gaming_state/session.log" 2>&1 9>&- &
  scope_pid=$!
  local finished='' status=0 started=false steam_ready_at=0 returned=false
  local premature_desktop=false early_count=0
  mark_steam_ready() {
    started=true
    gaming_autologin_ready=1
    if omarchy-cmd-present omarchy-handheld-autologin; then
      omarchy-handheld-autologin reset || true
    fi
    gaming_failure_reset
    gaming_early_return_reset
    steam_ready_at=$(date +%s)
    ready_pid=''
    gaming_save last gaming
  }
  gaming_scope_alive() {
    [[ -n $scope_pid ]] && kill -0 "$scope_pid" 2>/dev/null
  }
  wait -n -p finished "$scope_pid" "$ready_pid" "$return_pid" || status=$?
  if [[ ${finished:-} == "$ready_pid" ]]; then
    if (( status == 0 )); then
      mark_steam_ready
    elif gaming_scope_alive && pgrep -u "$UID" -x steam >/dev/null; then
      # A live Steam process can still be an updater or sign-in dialog.
      printf '%s\n' "ready waiter timed out after ${ready_timeout}s; Steam and Gamescope are still running; leaving them up." >> "$gaming_state/fallback.log"
      ready_pid=''
    fi
    if [[ -z $ready_pid ]]; then
      status=0
      wait -n -p finished "$scope_pid" "$return_pid" || status=$?
    fi
  fi
  if [[ ${finished:-} == "$return_pid" ]] && (( status == 0 )); then
    # Closing the sign-in screen sends the same request as Switch to Desktop.
    # The first one before the ready marker relaunches Gaming. The second one
    # in this login opens the desktop, because Steam never became ready.
    if $started; then
      returned=true
    else
      early_count=$(gaming_early_return_record) || early_count=1
      if (( early_count >= 2 )); then
        returned=true
        if [[ $(gaming_desktop_lock_effective) == on ]]; then
          printf '%s\n' 'Steam was not ready; returning to desktop sign-in.' >> "$gaming_state/fallback.log"
        else
          printf '%s\n' 'Steam was not ready; opening the desktop.' >> "$gaming_state/fallback.log"
          omarchy-notification-send 'Steam was not ready' 'Opening the desktop.' || true
        fi
      else
        premature_desktop=true
        printf '%s\n' 'return to desktop arrived before Steam was ready; relaunching the gaming session.' >> "$gaming_state/fallback.log"
      fi
    fi
  elif [[ -n $ready_pid && ${finished:-} == "$ready_pid" ]]; then
    status=1
    printf '%s\n' "Gamescope exited before Steam's UI was ready." >> "$gaming_state/fallback.log"
  elif ! $started; then
    status=1
    printf '%s\n' 'Gamescope exited without confirmed Steam readiness.' >> "$gaming_state/fallback.log"
  fi
  # A passwordless Switch to Desktop after readiness (or the second request
  # before readiness) writes the one-shot preference. The file is the session
  # user's ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/gaming-session/next,
  # mode 0600, in the mode 0700 state directory from gaming_state_init. It is
  # written before the gamescope scope stops. Relogin consumes desktop once.
  # Once this handoff's Hyprland socket appears, the file is removed so a
  # later logout returns to gaming. If this process dies before that socket,
  # the file is still there and that one relogin starts Hyprland.
  if $returned && [[ $(gaming_desktop_lock_effective) != on ]] && gaming_save next desktop; then
    gaming_desktop_next=1
  fi
  # Explicit Switch to Desktop, and the second pre-ready return, are a
  # success. Either clears the crash counter. The first pre-ready return does not.
  if $returned; then
    gaming_explicit_desktop=1
    gaming_failure_reset
    if omarchy-cmd-present omarchy-handheld-autologin; then
      omarchy-handheld-autologin reset || true
    fi
    request_gaming_shutdown
  fi
  stop_gaming
  # Append after Gamescope's log redirection has closed, so its exit text
  # cannot overwrite the return line the desktop switch is recognised by.
  if $returned; then
    echo 'Requested return to desktop.' >> "$gaming_state/session.log"
    if [[ $(gaming_desktop_lock_effective) == on ]]; then
      return_to_desktop_signin
      exit $?
    fi
  fi
  # Gamescope can return zero after its primary child fails. A non-zero Steam
  # exit in the first 120 seconds is a failure. A later exit returns to desktop.
  # An explicit Switch to Desktop is not a failure, whatever Steam's status is.
  if $returned; then
    status=0
  elif $premature_desktop; then
    status=3
  elif [[ -f $gaming_runtime/steam-exit && $(cat "$gaming_runtime/steam-exit") != "0" ]]; then
    if $started; then
      local now
      now=$(date +%s)
      if (( now - steam_ready_at < 120 )); then
        status=1
      else
        status=0
      fi
    else
      status=1
    fi
  fi
  unset OMARCHY_GAMING_RUNTIME
  return "$status"
}

retry_gap=${OMARCHY_GAMING_RETRY_GAP:-3}
[[ $retry_gap =~ ^[0-9]+([.][0-9]+)?$ ]] || retry_gap=3
retries=0
recovery_retry_used=0
if [[ $selection == gaming ]]; then
  # Record before Gamescope starts. A SIGKILL cannot run the exit trap,
  # and an early exit already has the count on disk for the next relogin.
  gaming_failure_record || true
  gaming_attempt_recorded=1
  if gaming_fail_limit_reached; then
    selection=recovery
  fi
fi
while true; do
  if [[ $selection == "recovery" ]]; then
    rm -f -- "$gaming_runtime/switch"
    if (( recovery_retry_used )); then
      # The attempted retry failed. This desktop can still sign out normally.
      rm -f -- "$gaming_runtime/active"
    else
      printf '%s\n' desktop > "$gaming_runtime/active" || exit 1
    fi
    gaming_fail_limit_fallback
    status=$?
    if (( status != 0 || recovery_retry_used )) || ! take_gaming_switch; then
      exit "$status"
    fi
    recovery_retry_used=1
    selection=gaming
  fi
  printf '%s\n' "$selection" > "$gaming_runtime/active" || exit 1
  if [[ $selection == "gaming" ]]; then
    autologin_watch=1
    if (( gaming_attempt_recorded || gaming_fallback )); then
      # The explicit recovery retry is already guarded by the existing latch.
      gaming_attempt_recorded=0
    else
      gaming_failure_record || true
      if gaming_fail_limit_reached; then
        selection=recovery
        continue
      fi
    fi
    run_gaming
    status=$?
    stop_gaming
    if (( status == 0 )); then
      gaming_fallback=0
      selection=desktop
    elif (( status == 3 )); then
      # Do not burn a start failure or the one retry that ends on the desktop.
      gaming_attempt_recorded=1
      sleep "$retry_gap"
    elif (( gaming_fallback )); then
      selection=recovery
    elif (( status == 2 || retries >= 1 )); then
      gaming_save recovery 'Steam or Gamescope exited; desktop selected until an explicit gaming choice.'
      omarchy-notification-send 'Gaming Mode didn’t start' 'Gaming did not start. Log: ~/.local/state/omarchy/gaming-session/session.log' || true
      retries=1
      selection=desktop
    else
      retries=1
      sleep "$retry_gap"
    fi
  else
    gaming_save last desktop
    desktop "$desktop_entry"
    status=$?
    desktop_entry=''
    if (( status == 10 )); then
      # The recovery latch stays. A remaining D2 retry goes back to gaming.
      if (( retries >= 1 )); then
        return_to_desktop_signin
        exit $?
      fi
      retries=1
      selection=gaming
    elif take_gaming_switch; then
      selection=gaming
    else
      exit "$status"
    fi
  fi
done
