#!/bin/bash
# omarchy:hidden=true
# omarchy:summary=Launch Steam inside the managed Gamescope scope

set -uo pipefail
[[ -n ${OMARCHY_GAMING_RUNTIME:-} && -n ${DISPLAY:-} ]] || exit 1
# A non-login ssh command does not source env-bootstrap, and set -u then
# aborts here. Same fallback as env-bootstrap and omarchy-migrate.
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/default/gaming/bin:$PATH"
# Upstream CachyOS steam-launcher contract; use the installed Steam/library.
export XDG_SESSION_TYPE=x11 SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export STEAM_MULTIPLE_XWAYLANDS=1 SRT_URLOPEN_PREFER_STEAM=1
# No fake Deck HDR, fan, TDP, drive-formatting or update capability flags.

# shellcheck source=/dev/null
source "$OMARCHY_PATH/default/gaming/steam-ready.sh"

power_pid=''
cleanup() {
  if [[ -n $power_pid ]]; then
    kill "$power_pid" 2>/dev/null || true
    wait "$power_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
if omarchy-cmd-present omarchy-launch-gaming-powerbutton && omarchy-pkg-present omarchy-rog-ally-powerbutton && [[ -x /usr/bin/steamos-powerbuttond ]]; then
  omarchy-launch-gaming-powerbutton &
  power_pid=$!
fi
# Full connectivity, or the timeout. A missing NetworkManager client skips it.
gaming_wait_for_steam_network
steam -steamos3 -steampal -steamdeck -gamepadui &
steam_pid=$!
proc_root=${OMARCHY_STEAM_PROC_ROOT:-/proc}
# shellcheck source=/dev/null
source "$OMARCHY_PATH/default/gaming/steam-path.sh"
steam_session_select_record "$proc_root" "$steam_pid" "$OMARCHY_PATH/default/gaming/bin" "$OMARCHY_GAMING_RUNTIME/steam-path" || true
# The session supervisor reads the fifo for this long, then gives up. Past
# that, or once the UI has been reported, another scan cannot change the
# result, and a 0.2s scan for the rest of the session is the battery cost.
ready_wait=${OMARCHY_GAMING_READY_TIMEOUT:-60}
[[ $ready_wait =~ ^[0-9]+([.][0-9]+)?$ ]] || ready_wait=60
ready_wait_s=${ready_wait%%.*}
if (( ready_wait_s < 1 )); then
  ready_wait_s=1
fi
while kill -0 "$steam_pid" 2>/dev/null; do
  if steam_tree_has_ui "$proc_root" "$steam_pid"; then
    # A reader that already timed out must not leave this write blocked.
    # A failed write means that reader is gone. Stop either way.
    timeout 1s bash -c 'printf "started\n" > "$1"' _ "$OMARCHY_GAMING_RUNTIME/ready" || true
    break
  fi
  if (( SECONDS >= ready_wait_s )); then
    break
  fi
  sleep 0.2
done
wait "$steam_pid"
status=$?
printf '%s\n' "$status" > "$OMARCHY_GAMING_RUNTIME/steam-exit"
exit "$status"
