#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Apply the ROG Ally sustained power limit
# omarchy:args=--show | --conflict-units | --snapshot | --set <watts> | --set-custom <watts> | --set-profile <profile> | --reassert

# RC71L sustained limit. SPPT and FPPT are derived here. The caller never
# passes them. Privileged operations re-exec through pkexec.
#
# The three current_value stores follow FirmwareAttributeLimitManager::set_tdp_limit
# in evlaV/steamos-manager 85fbd8f (SPDX-License-Identifier: MIT, Collabora,
# Valve, Igalia): SPL, then SPPT, then FPPT. The notice is
# $OMARCHY_PATH/default/ally-tdp/NOTICE.steamos-manager. The watts are the
# overlay ratio, not that function's max(limit, min) alone.
#
# A root process ignores OMARCHY_ALLY_TDP_* so a caller cannot point pkexec
# at a stand-in sysfs. Fixture mode is non-root only.

set -euo pipefail

ATTRS=(ppt_pl1_spl ppt_pl2_sppt ppt_pl3_fppt)
SNAPSHOT_FIELDS=(default_value min_value max_value)
CONFLICT_UNITS=(
  power-profiles-daemon.service
  powerstation.service
  hhd.service
  adjustor.service
  asusd.service
  tlp.service
  auto-cpufreq.service
  tuned.service
  gamemoded.service
)
LOCK_WAIT_DEFAULT=5
AC_SPL_POLICY=30
BATTERY_SPL_POLICY=20
BATTERY_SPPT_POLICY=20
BATTERY_FPPT_POLICY=25

log() {
  printf 'omarchy-ally-tdp-apply: %s\n' "$*" >&2
  logger -t omarchy-ally-tdp-apply -- "$*" 2>/dev/null || true
}

usage() {
  echo "Usage: omarchy-ally-tdp-apply --show | --conflict-units | --snapshot | --set <watts> | --set-custom <watts> | --set-profile <power-saver|balanced|performance|custom> | --reassert" >&2
  exit 1
}

canonical_watts() {
  [[ $1 =~ ^[0-9]+$ ]] || return 1
  [[ $1 == 0 || $1 =~ ^[1-9][0-9]*$ ]]
}

read_int() {
  local file=$1 value
  [[ -f $file ]] || return 1
  IFS= read -r value <"$file" || return 1
  value=${value//$'\r'/}
  [[ $value =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$value"
}

write_int() {
  local file=$1 value=$2 got
  printf '%s\n' "$value" >"$file" || return 1
  got=$(read_int "$file") || return 1
  [[ $got == "$value" ]]
}

anchor_of() {
  local default=$1 max=$2
  if (( default > 0 )); then
    printf '%s\n' "$default"
  else
    printf '%s\n' "$max"
  fi
}

# Half-up integer division. numer and denom are non-negative.
round_div() {
  local numer=$1 denom=$2
  (( denom > 0 )) || return 1
  printf '%s\n' "$(( (numer + denom / 2) / denom ))"
}

clamp_to() {
  local value=$1 floor=$2 ceil=$3
  if (( value < floor )); then
    value=$floor
  fi
  if (( value > ceil )); then
    value=$ceil
  fi
  printf '%s\n' "$value"
}

lowest() {
  local best=$1 next
  shift
  for next in "$@"; do
    if (( next < best )); then
      best=$next
    fi
  done
  printf '%s\n' "$best"
}

# Steam watches the same services even when firmware is currently unavailable.
if (( $# == 1 )) && [[ $1 == "--conflict-units" ]]; then
  printf '%s\n' "${CONFLICT_UNITS[@]}"
  exit 0
fi

fixture=0
if [[ $EUID -ne 0 && ${OMARCHY_ALLY_TDP_FIXTURE:-} == 1 ]]; then
  fixture=1
fi

if (( fixture )); then
  armoury=${OMARCHY_ALLY_TDP_ARMOURY:?}
  power_root=${OMARCHY_ALLY_TDP_POWER:?}
  state_dir=${OMARCHY_ALLY_TDP_STATE:?}
  run_dir=${OMARCHY_ALLY_TDP_RUN:-$state_dir/run}
  lock_file=${OMARCHY_ALLY_TDP_LOCK:?}
  boot_id=${OMARCHY_ALLY_TDP_BOOT_ID:-fixture}
  lock_wait=${OMARCHY_ALLY_TDP_LOCK_WAIT:-$LOCK_WAIT_DEFAULT}
else
  armoury=/sys/class/firmware-attributes/asus-armoury/attributes
  power_root=/sys/class/power_supply
  state_dir=/var/lib/omarchy/handheld/ally-tdp
  run_dir=/run/omarchy-ally-tdp
  lock_file=/run/omarchy-ally-tdp.lock
  if ! IFS= read -r boot_id </proc/sys/kernel/random/boot_id || [[ -z $boot_id ]]; then
    boot_id=unknown
  fi
  lock_wait=$LOCK_WAIT_DEFAULT
fi

[[ $lock_wait =~ ^[0-9]+$ ]] || lock_wait=$LOCK_WAIT_DEFAULT

verb=
watts=
profile=
case ${1:-} in
  --show)
    [[ $# -eq 1 ]] || usage
    verb="show"
    ;;
  --snapshot)
    [[ $# -eq 1 ]] || usage
    verb="snapshot"
    ;;
  --set | --set-custom)
    [[ $# -eq 2 ]] || usage
    verb=${1#--}
    watts=$2
    ;;
  --set-profile)
    [[ $# -eq 2 ]] || usage
    case $2 in power-saver | balanced | performance | custom) ;; *) usage ;; esac
    verb=set-profile
    profile=$2
    ;;
  --reassert)
    [[ $# -eq 1 ]] || usage
    verb="reassert"
    ;;
  *)
    usage
    ;;
esac

if [[ $verb != show ]]; then
  if [[ $EUID -ne 0 && $fixture -eq 0 ]]; then
    exec pkexec /usr/bin/omarchy-ally-tdp-apply "$@"
  fi
fi

if ! omarchy-hw-rog-ally; then
  log "not a ROG Ally RC71L"
  exit 1
fi

for attr in "${ATTRS[@]}"; do
  if [[ ! -f $armoury/$attr/current_value || ! -f $armoury/$attr/min_value || ! -f $armoury/$attr/max_value || ! -f $armoury/$attr/default_value ]]; then
    log "asus-armoury attribute $attr is missing"
    exit 1
  fi
done

read_text() {
  local file=$1 value
  [[ -f $file ]] || return 1
  IFS= read -r value <"$file" || return 1
  value=${value//$'\r'/}
  printf '%s\n' "$value"
}

power_source() {
  local dir type online scope found=0
  [[ -d $power_root ]] || {
    printf '%s\n' battery
    return
  }
  for dir in "$power_root"/*; do
    [[ -d $dir ]] || continue
    type=$(read_text "$dir/type" 2>/dev/null || true)
    scope=$(read_text "$dir/scope" 2>/dev/null || true)
    [[ $scope != "Device" ]] || continue
    online=0
    if [[ -f $dir/online ]]; then
      online=$(read_int "$dir/online" 2>/dev/null || true)
      [[ -n $online ]] || online=0
    fi
    if [[ $type == Mains || $type == USB ]] && [[ $online == 1 ]]; then
      found=1
    fi
  done
  if (( found )); then
    printf '%s\n' ac
  else
    printf '%s\n' battery
  fi
}

conflict_owner() {
  local i
  local -a states
  # is-active prints one state per requested unit, even when all are inactive.
  mapfile -t states < <(systemctl is-active "${CONFLICT_UNITS[@]}")
  if (( ${#states[@]} != ${#CONFLICT_UNITS[@]} )); then
    printf '%s\n' 'unknown'
    return
  fi
  for i in "${!states[@]}"; do
    if [[ ${states[i]} != "inactive" && ${states[i]} != "failed" ]]; then
      printf '%s\n' "${CONFLICT_UNITS[i]}"
      return
    fi
  done
  return 1
}

boot_cache=$run_dir/boot/$boot_id

snapshot_complete() {
  local directory=$1 attr field
  [[ -d $directory ]] || return 1
  # Earlier writers populated the directory one file at a time.
  for attr in "${ATTRS[@]}"; do
    for field in "${SNAPSHOT_FIELDS[@]}"; do
      read_int "$directory/$attr.$field" >/dev/null || return 1
    done
  done
}

firmware_limits() {
  local attr field
  for attr in "${ATTRS[@]}"; do
    for field in "${SNAPSHOT_FIELDS[@]}"; do
      read_int "$armoury/$attr/$field" || return 1
    done
  done
}

ensure_snapshot() {
  local source=$1 directory=$boot_cache/$1 pending=$boot_cache/.$1.pending
  local first confirmed attr field index=0
  local -a values
  snapshot_complete "$directory" && return 0

  # A charger transition can change the firmware table between sysfs reads.
  first=$(firmware_limits) || return 1
  verify_power_source "$source" "firmware snapshot discarded" || return 1
  confirmed=$(firmware_limits) || return 1
  if [[ $first != "$confirmed" ]]; then
    log "firmware limits changed during snapshot"
    return 1
  fi

  # Only the lock holder writes here. Readers see the live ceiling until
  # the complete snapshot replaces any partial directory from an old writer.
  mkdir -p -- "$pending" || return 1
  mapfile -t values <<<"$confirmed"
  for attr in "${ATTRS[@]}"; do
    for field in "${SNAPSHOT_FIELDS[@]}"; do
      printf '%s\n' "${values[index++]}" >"$pending/$attr.$field" || return 1
    done
  done
  verify_power_source "$source" "firmware snapshot discarded" || return 1
  if [[ -d $directory ]]; then
    rm -r -- "$directory" || return 1
  fi
  mv -T -- "$pending" "$directory"
}

load_snap() {
  read_int "$boot_cache/$1/$2.$3"
}

request_file=$state_dir/request

preset_watts() {
  case $1 in
    power-saver) printf '%s\n' "$2" ;;
    balanced) printf '%s\n' "$BATTERY_SPL_POLICY" ;;
    performance) printf '%s\n' "$AC_SPL_POLICY" ;;
    *) return 1 ;;
  esac
}

read_request() {
  stored=
  mode=
  if [[ -f $request_file ]]; then
    {
      IFS= read -r stored || stored=
      IFS= read -r mode || mode=
    } 2>/dev/null <"$request_file" || return 0
    stored=${stored//$'\r'/}
    canonical_watts "$stored" || stored=
  fi
}

save_request() {
  local temporary
  mkdir -p -- "$state_dir" || return 1
  temporary=$(mktemp "$state_dir/.request.XXXXXXXX") || return 1
  # The first line stays readable by older releases and the reapply path.
  if {
    printf '%s\n' "$1" &&
      if [[ -n $2 ]]; then printf '%s\n' "$2"; fi
  } >"$temporary" && chmod 0644 "$temporary" && mv -T -- "$temporary" "$request_file"; then
    return 0
  fi
  rm -f -- "$temporary"
  return 1
}

active_profile() {
  local requested=$1 mode=$2 limit=$3 min=$4 max=$5 preset target active=
  if target=$(preset_watts "$mode" "$min"); then
    if [[ $limit == "$(clamp_to "$target" "$min" "$max")" ]]; then
      active=$mode
    fi
  elif [[ -z $mode ]]; then
    # Older requests only record watts. Infer a preset only from a unique match.
    for preset in power-saver balanced performance; do
      target=$(preset_watts "$preset" "$min")
      [[ $requested == "$target" ]] || continue
      [[ $limit == "$(clamp_to "$target" "$min" "$max")" ]] || continue
      if [[ -n $active ]]; then
        active=
        break
      fi
      active=$preset
    done
  fi
  printf '%s\n' "${active:-custom}"
}

# Plan applied SPL/SPPT/FPPT for a stored request on this source.
# Prints three lines. Returns 1 when the tuple cannot keep order.
plan_tuple() {
  local requested=$1 source=$2
  local live_spl_min live_spl_max live_sppt_min live_sppt_max live_fppt_min live_fppt_max
  local boot_spl_default boot_spl_max boot_sppt_default boot_sppt_max boot_fppt_default boot_fppt_max
  local spl_policy sppt_policy fppt_policy spl_ceil applied
  local spl_anchor sppt_anchor fppt_anchor sppt_derived fppt_derived
  local sppt_floor sppt_ceil fppt_floor fppt_ceil sppt fppt

  live_spl_min=$(read_int "$armoury/ppt_pl1_spl/min_value") || return 1
  live_spl_max=$(read_int "$armoury/ppt_pl1_spl/max_value") || return 1
  live_sppt_min=$(read_int "$armoury/ppt_pl2_sppt/min_value") || return 1
  live_sppt_max=$(read_int "$armoury/ppt_pl2_sppt/max_value") || return 1
  live_fppt_min=$(read_int "$armoury/ppt_pl3_fppt/min_value") || return 1
  live_fppt_max=$(read_int "$armoury/ppt_pl3_fppt/max_value") || return 1
  boot_spl_default=$(load_snap "$source" ppt_pl1_spl default_value) || return 1
  boot_spl_max=$(load_snap "$source" ppt_pl1_spl max_value) || return 1
  boot_sppt_default=$(load_snap "$source" ppt_pl2_sppt default_value) || return 1
  boot_sppt_max=$(load_snap "$source" ppt_pl2_sppt max_value) || return 1
  boot_fppt_default=$(load_snap "$source" ppt_pl3_fppt default_value) || return 1
  boot_fppt_max=$(load_snap "$source" ppt_pl3_fppt max_value) || return 1

  if [[ $source == battery ]]; then
    spl_policy=$BATTERY_SPL_POLICY
    sppt_policy=$BATTERY_SPPT_POLICY
    fppt_policy=$BATTERY_FPPT_POLICY
  else
    spl_policy=$AC_SPL_POLICY
    sppt_policy=$boot_sppt_max
    fppt_policy=$boot_fppt_max
  fi

  spl_ceil=$(lowest "$spl_policy" "$live_spl_max" "$boot_spl_max")
  if (( live_spl_min > spl_ceil )); then
    log "SPL floor $live_spl_min is above ceiling $spl_ceil"
    return 1
  fi
  applied=$(clamp_to "$requested" "$live_spl_min" "$spl_ceil")

  spl_anchor=$(anchor_of "$boot_spl_default" "$boot_spl_max")
  sppt_anchor=$(anchor_of "$boot_sppt_default" "$boot_sppt_max")
  fppt_anchor=$(anchor_of "$boot_fppt_default" "$boot_fppt_max")
  if (( spl_anchor <= 0 )); then
    log "SPL ratio anchor is zero"
    return 1
  fi
  sppt_derived=$(round_div $(( applied * sppt_anchor )) "$spl_anchor") || return 1
  fppt_derived=$(round_div $(( applied * fppt_anchor )) "$spl_anchor") || return 1

  if (( applied > live_sppt_min )); then
    sppt_floor=$applied
  else
    sppt_floor=$live_sppt_min
  fi
  sppt_ceil=$(lowest "$sppt_policy" "$live_sppt_max" "$boot_sppt_max")
  if (( sppt_floor > sppt_ceil )); then
    log "SPPT floor $sppt_floor is above ceiling $sppt_ceil"
    return 1
  fi
  sppt=$(clamp_to "$sppt_derived" "$sppt_floor" "$sppt_ceil")

  if (( sppt > live_fppt_min )); then
    fppt_floor=$sppt
  else
    fppt_floor=$live_fppt_min
  fi
  fppt_ceil=$(lowest "$fppt_policy" "$live_fppt_max" "$boot_fppt_max")
  if (( fppt_floor > fppt_ceil )); then
    log "FPPT floor $fppt_floor is above ceiling $fppt_ceil"
    return 1
  fi
  fppt=$(clamp_to "$fppt_derived" "$fppt_floor" "$fppt_ceil")

  if (( applied > sppt || sppt > fppt )); then
    log "planned tuple $applied/$sppt/$fppt breaks SPL <= SPPT <= FPPT"
    return 1
  fi
  printf '%s\n%s\n%s\n' "$applied" "$sppt" "$fppt"
}

read_tdp_tuple() {
  local attr value
  for attr in "${ATTRS[@]}"; do
    value=$(read_int "$armoury/$attr/current_value") || return 1
    printf '%s\n' "$value"
  done
}

verify_power_source() {
  if [[ $(power_source) != "$1" ]]; then
    log "power source changed; $2"
    return 1
  fi
}

restore_tdp_tuple() {
  local source=$1 previous=$2 planned=$3 last_attempt=$4
  local index path current remaining
  local -a previous_values planned_values
  mapfile -t previous_values <<<"$previous"
  mapfile -t planned_values <<<"$planned"

  # Undo attempted changes in reverse order. A failed store may have left its
  # old value in place. Leave it and any untouched fields alone.
  for (( index = last_attempt; index >= 0; index-- )); do
    [[ ${previous_values[index]} != "${planned_values[index]}" ]] || continue
    path=$armoury/${ATTRS[index]}/current_value
    current=$(read_int "$path") || current=""
    [[ $current != "${previous_values[index]}" ]] || continue
    verify_power_source "$source" "TDP rollback skipped" || return
    write_int "$path" "${previous_values[index]}" || log "could not restore ${ATTRS[index]}"
  done
  verify_power_source "$source" "TDP rollback not verified" || return
  if ! remaining=$(read_tdp_tuple); then
    log "could not read TDP limits after rollback"
  elif [[ $remaining != "$previous" ]]; then
    log "TDP rollback incomplete: expected ${previous//$'\n'/,}, read ${remaining//$'\n'/,}"
  fi
}

apply_tdp_tuple() {
  local source=$1 planned=$2 previous index readback
  local -a names=(SPL SPPT FPPT) planned_values
  if ! previous=$(read_tdp_tuple); then
    log "cannot read previous TDP limits"
    return 1
  fi
  mapfile -t planned_values <<<"$planned"

  # Preserve the firmware write order. Reassert must still send a value when
  # the driver's cached current_value already matches the plan.
  for index in "${!ATTRS[@]}"; do
    verify_power_source "$source" "TDP write stopped" || return 1
    if ! write_int "$armoury/${ATTRS[index]}/current_value" "${planned_values[index]}"; then
      log "${names[index]} write failed"
      restore_tdp_tuple "$source" "$previous" "$planned" "$index"
      return 1
    fi
  done

  readback=$(read_tdp_tuple) || readback=""
  verify_power_source "$source" "TDP write not verified" || return 1
  if [[ $readback != "$planned" ]]; then
    log "TDP readback does not match the requested limits"
    restore_tdp_tuple "$source" "$previous" "$planned" "$index"
    return 1
  fi
  printf '%s\n' "$readback"
}

slider_bounds() {
  local source=$1 live_min live_max boot_max policy ceil
  live_min=$(read_int "$armoury/ppt_pl1_spl/min_value") || return 1
  live_max=$(read_int "$armoury/ppt_pl1_spl/max_value") || return 1
  if [[ $source == battery ]]; then
    policy=$BATTERY_SPL_POLICY
  else
    policy=$AC_SPL_POLICY
  fi
  boot_max=$live_max
  if snapshot_complete "$boot_cache/$source"; then
    boot_max=$(load_snap "$source" ppt_pl1_spl max_value) || return 1
  fi
  ceil=$(lowest "$policy" "$live_max" "$boot_max")
  if (( live_min > ceil )); then
    return 1
  fi
  printf '%s\n%s\n' "$live_min" "$ceil"
}

emit_status() {
  local source=$1 spl=$2 sppt=$3 fppt=$4 min=$5 max=$6 writable=$7
  local stored mode
  read_request
  printf 'source=%s\n' "$source"
  printf 'stored=%s\n' "$stored"
  printf 'limit=%s\n' "$spl"
  printf 'spl=%s\n' "$spl"
  printf 'sppt=%s\n' "$sppt"
  printf 'fppt=%s\n' "$fppt"
  printf 'min=%s\n' "$min"
  printf 'max=%s\n' "$max"
  printf 'writable=%s\n' "$writable"
  printf 'conflict=%s\n' "$owner"
  printf 'spl_policy_battery=%s\n' "$BATTERY_SPL_POLICY"
  printf 'spl_policy_ac=%s\n' "$AC_SPL_POLICY"
  printf 'profile=%s\n' "$(active_profile "$stored" "$mode" "$spl" "$min" "$max")"
}

acquire_lock() {
  local lock_dir
  lock_dir=$(dirname -- "$lock_file")
  mkdir -p -- "$lock_dir" || {
    log "cannot create $lock_dir"
    exit 1
  }
  # shellcheck disable=SC3023
  exec {tdp_lock_fd}>"$lock_file" || {
    log "cannot open $lock_file"
    exit 1
  }
  if ! flock -w "$lock_wait" "$tdp_lock_fd"; then
    log "timed out after ${lock_wait}s waiting for $lock_file"
    exit 1
  fi
}

if [[ $verb != "show" ]]; then
  if [[ $verb == "set" || $verb == "set-custom" ]] && ! canonical_watts "$watts"; then
    log "watts must be a canonical whole number"
    exit 1
  fi
  # A new owner or charger can appear while another request holds the lock.
  acquire_lock
fi

owner=""
if owner=$(conflict_owner); then
  writable=0
else
  writable=1
  owner=""
fi

if [[ $verb == show ]]; then
  source=$(power_source)
  spl=$(read_int "$armoury/ppt_pl1_spl/current_value") || exit 1
  sppt=$(read_int "$armoury/ppt_pl2_sppt/current_value") || exit 1
  fppt=$(read_int "$armoury/ppt_pl3_fppt/current_value") || exit 1
  if ! bounds=$(slider_bounds "$source"); then
    log "slider window is empty"
    exit 1
  fi
  min=$(printf '%s\n' "$bounds" | sed -n '1p')
  max=$(printf '%s\n' "$bounds" | sed -n '2p')
  emit_status "$source" "$spl" "$sppt" "$fppt" "$min" "$max" "$writable"
  exit 0
fi

if (( writable == 0 )); then
  if [[ $verb == reassert ]]; then
    log "skipping reapply (power service owner: $owner)"
    exit 0
  fi
  log "refusing to write (power service owner: $owner)"
  exit 1
fi

# Tell a running Steam shim when the write or reapply is complete, including
# a power change that only changes the slider bounds. /run is present before
# the first request, so the shim can watch the marker even before it exists.
if [[ $verb != "snapshot" ]]; then
  trap ': > "$lock_file.updated" || log "cannot notify the TDP shim"' EXIT
fi

source=$(power_source)
ensure_snapshot "$source" || {
  log "cannot snapshot firmware limits"
  exit 1
}

bounds=$(slider_bounds "$source")
min=${bounds%%$'\n'*}
max=${bounds##*$'\n'}

if [[ $verb == "snapshot" || $verb == "set-profile" && $profile == "custom" || $verb == "set-custom" ]]; then
  spl=$(read_int "$armoury/ppt_pl1_spl/current_value")
  sppt=$(read_int "$armoury/ppt_pl2_sppt/current_value")
  fppt=$(read_int "$armoury/ppt_pl3_fppt/current_value")
  read_request
  if [[ $verb == "set-profile" ]]; then
    verify_power_source "$source" "custom profile request discarded" || exit 1
    if [[ $mode == "power-saver" || -z $stored || $(clamp_to "$stored" "$min" "$max") != "$spl" ]]; then
      stored=$spl
    fi
    save_request "$stored" custom || exit 1
  fi
  # Steam can send the effective wattage back after a preset was selected.
  # Preserve the preset's request, especially 30 W clamped to 20 W on battery.
  if [[ $verb != "set-custom" ]] ||
    { [[ $watts == "$spl" ]] && [[ $(active_profile "$stored" "$mode" "$spl" "$min" "$max") != "custom" ]]; }; then
    emit_status "$source" "$spl" "$sppt" "$fppt" "$min" "$max" "$writable"
    exit 0
  fi
fi

if [[ $verb == "set-profile" ]]; then
  watts=$(preset_watts "$profile" "$min")
fi
if [[ $verb == reassert ]]; then
  read_request
  if [[ -z $stored ]]; then
    log "no stored request to reassert"
    exit 0
  fi
  watts=$(preset_watts "$mode" "$min") || watts=$stored
fi

if ! planned=$(plan_tuple "$watts" "$source"); then
  log "refusing to write"
  exit 1
fi
got=$(apply_tdp_tuple "$source" "$planned") || exit 1
mapfile -t limits <<<"$got"
got_spl=${limits[0]}
got_sppt=${limits[1]}
got_fppt=${limits[2]}

case $verb in
  set) save_request "$watts" '' || exit 1 ;;
  set-profile) save_request "$watts" "$profile" || exit 1 ;;
  set-custom) save_request "$watts" custom || exit 1 ;;
esac
bounds=$(slider_bounds "$source")
min=${bounds%%$'\n'*}
max=${bounds##*$'\n'}
emit_status "$source" "$got_spl" "$got_sppt" "$got_fppt" "$min" "$max" 1
