#!/bin/bash
# omarchy:summary=Inspect and control supported RC71L power settings through SteamOS Manager
# omarchy:args=[status|set [--source autodetect|ac|battery] <control> <value>|restore [--source autodetect|ac|battery]|watch|run <watts> -- <command...>]
# omarchy:examples=omarchy power ally status | omarchy power ally set tdp 15 | omarchy power ally run 15 -- steam

set -euo pipefail
exec python3 "$OMARCHY_PATH/default/handheld/power.py" "$@"
