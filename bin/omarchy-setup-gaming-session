#!/bin/bash
# omarchy:summary=Choose a reversible authenticated gaming session preference
# omarchy:args=[status|default <desktop|gaming|last>|next <desktop|gaming|clear>|display <native|720p|900p|1080p> [fps] [linear|nearest|fsr|nis]|overlay <on|off>|reset]

set -euo pipefail
if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  echo 'Usage: omarchy-setup-gaming-session [status|default <desktop|gaming|last>|next <desktop|gaming|clear>|display <native|720p|900p|1080p> [fps] [linear|nearest|fsr|nis]|overlay <on|off>|reset]'
  echo 'Select Omarchy (session preference) at SDDM. Password sign-in is retained.'
  echo 'Display settings affect game rendering, not physical output modes. FPS: 0,30,40,45,60,90,120.'
  exit 0
fi
source "$OMARCHY_PATH/default/gaming/session.sh"
omarchy-hw-rog-ally || { gaming_fail 'this setup supports the original RC71L only.'; exit 1; }
gaming_state_init
case ${1:-status} in
  status)
    (( $# <= 1 )) || exit 2
    for setting in preference next last display overlay recovery; do
      if [[ -f $gaming_state/$setting ]]; then
        printf '%s: %s\n' "$setting" "$(cat "$gaming_state/$setting")"
      fi
    done
    echo 'Absent preference means desktop; choose Omarchy (session preference) at sign-in.'
    ;;
  default)
    (( $# == 2 )) || exit 2
    case $2 in desktop | gaming | last) ;; *) exit 2 ;; esac
    gaming_save preference "$2"
    rm -f "$gaming_state/recovery"
    ;;
  next)
    (( $# == 2 )) || exit 2
    case $2 in
      desktop | gaming) gaming_save next "$2"; rm -f "$gaming_state/recovery" ;;
      clear) rm -f "$gaming_state/next" ;;
      *) exit 2 ;;
    esac
    ;;
  display)
    (( $# >= 2 && $# <= 4 )) || exit 2
    # Validate the same parser the launcher uses before replacing saved state.
    candidate=$(mktemp -d)
    trap 'rm -rf "$candidate"' EXIT
    printf '%s %s %s\n' "$2" "${3:-0}" "${4:-linear}" > "$candidate/display"
    # shellcheck disable=SC2030
    (gaming_state=$candidate; gaming_display_args) || { gaming_fail 'invalid display settings; use --help.'; exit 2; }
    gaming_save display "$(cat "$candidate/display")"
    ;;
  overlay)
    (( $# == 2 )) || exit 2
    case $2 in on | off) gaming_save overlay "$2" ;; *) exit 2 ;; esac
    ;;
  reset)
    (( $# == 1 )) || exit 2
    # shellcheck disable=SC2031
    rm -f "$gaming_state/"{preference,next,last,display,overlay,recovery}
    ;;
  *) gaming_fail 'unknown option; use --help.'; exit 2 ;;
esac
