#!/bin/bash
# omarchy:summary=Choose a reversible authenticated gaming session preference
# omarchy:args=[status|default <desktop|gaming|last|auto>|next <desktop|gaming|clear>|display <native|720p|900p|1080p> [fps] [linear|nearest|fsr|nis]|overlay <on|off>|desktop-lock <on|off>|install-power-button|reset]

set -euo pipefail
if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  echo 'Usage: omarchy-setup-gaming-session [status|default <desktop|gaming|last|auto>|next <desktop|gaming|clear>|display <native|720p|900p|1080p> [fps] [linear|nearest|fsr|nis]|overlay <on|off>|desktop-lock <on|off>|install-power-button|reset]'
  echo 'Select Omarchy (session preference) at SDDM. Password sign-in is retained.'
  echo 'Display settings affect game rendering, not physical output modes. FPS: 0,30,40,45,60,90,120.'
  echo 'Use install-power-button to install or repair the optional gaming power-button companion.'
  exit 0
fi
# A non-login ssh command does not source env-bootstrap, and set -u then
# aborts here. Same fallback as env-bootstrap and omarchy-migrate.
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
source "$OMARCHY_PATH/default/gaming/session.sh"
omarchy-hw-rog-ally || { gaming_fail 'this setup supports the original RC71L only.'; exit 1; }
case ${1:-status} in
  status)
    (( $# <= 1 )) || exit 2
    if [[ -e $gaming_state || -L $gaming_state ]]; then
      [[ -d $gaming_state && ! -L $gaming_state && -O $gaming_state ]] || exit 1
      for setting in preference next last display overlay library recovery; do
        if [[ -f $gaming_state/$setting ]]; then
          printf '%s: %s\n' "$setting" "$(cat "$gaming_state/$setting")"
        fi
      done
    fi
    if gaming_handheld_variant; then
      echo 'The preference selector uses Auto for a missing or invalid preference.'
      echo 'Auto selects Desktop with an external display and Gaming otherwise.'
    else
      echo 'The preference selector uses Desktop for a missing or invalid preference.'
    fi
    echo 'The SDDM handheld entry uses this preference on the first automatic login of each boot.'
    echo 'Relogin defaults to Gaming and honours a one-use Desktop override.'
    ;;
  install-power-button)
    (( $# == 1 )) || exit 2
    omarchy-pkg-present omarchy-gaming-session || { gaming_fail 'install the optional gaming session package first.'; exit 1; }
    if ! omarchy-install-rog-ally-powerbutton; then
      printf 'warning: RC71L power-button companion setup failed; re-run: omarchy-setup-gaming-session install-power-button\n' >&2
      exit 1
    fi
    ;;
  default)
    (( $# == 2 )) || exit 2
    case $2 in desktop | gaming | last | auto) ;; *) exit 2 ;; esac
    gaming_state_init
    gaming_save preference "$2"
    rm -f "$gaming_state/recovery"
    ;;
  next)
    (( $# == 2 )) || exit 2
    case $2 in desktop | gaming | clear) ;; *) exit 2 ;; esac
    gaming_state_init
    if [[ $2 == "clear" ]]; then
      rm -f "$gaming_state/next"
    else
      gaming_save next "$2"
      rm -f "$gaming_state/recovery"
    fi
    ;;
  display)
    (( $# >= 2 && $# <= 4 )) || exit 2
    # Validate the same parser the launcher uses before replacing saved state.
    candidate=$(mktemp -d)
    trap 'rm -rf "$candidate"' EXIT
    printf '%s %s %s\n' "$2" "${3:-0}" "${4:-linear}" > "$candidate/display"
    # shellcheck disable=SC2030
    (gaming_state=$candidate; gaming_display_args) || { gaming_fail 'invalid display settings; use --help.'; exit 2; }
    gaming_state_init
    gaming_save display "$(cat "$candidate/display")"
    ;;
  overlay)
    (( $# == 2 )) || exit 2
    case $2 in on | off) ;; *) exit 2 ;; esac
    gaming_state_init
    gaming_save overlay "$2"
    ;;
  desktop-lock)
    (( $# == 2 )) || exit 2
    case $2 in
      on) lock_value=on ;;
      off)
        # A background process, including Steam, has no terminal to answer sudo.
        if [[ ! -t 0 && ! -t 1 ]]; then
          gaming_fail 'desktop-lock off needs a terminal so sudo can ask for a password.'
          exit 1
        fi
        lock_value=explicit-off
        ;;
      *) exit 2 ;;
    esac
    if (( EUID == 0 )); then
      "$OMARCHY_PATH/bin/omarchy-setup-handheld-dirs" --value "$lock_value"
    else
      sudo env OMARCHY_PATH="$OMARCHY_PATH" "$OMARCHY_PATH/bin/omarchy-setup-handheld-dirs" --value "$lock_value"
    fi
    if gaming_handheld_variant; then
      omarchy-handheld-autologin apply
    fi
    ;;
  reset)
    (( $# == 1 )) || exit 2
    gaming_state_init
    # shellcheck disable=SC2031
    rm -f "$gaming_state/"{preference,next,last,display,overlay,library,recovery,gamescope-modes.cfg,sunshine,update-checks}
    ;;
  *) gaming_fail 'unknown option; use --help.'; exit 2 ;;
esac
