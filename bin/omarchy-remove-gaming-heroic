#!/bin/bash

# omarchy:summary=Remove Heroic Games Launcher while preserving games, saves, prefixes and settings
# omarchy:requires-sudo=true

set -e

omarchy-pkg-drop heroic-games-launcher-bin

# Compatibility runtimes and user data may also be used by other launchers.
echo "Heroic Games Launcher removed. Games, saves, prefixes and settings were kept."
