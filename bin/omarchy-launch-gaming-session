#!/bin/bash
# omarchy:summary=Switch a managed Hyprland session to standalone gaming
# omarchy:args=[--help|--confirm|--available|--wait-for-desktop-exit]

set -euo pipefail
if (( $# )); then
  (( $# == 1 )) || exit 2
  case $1 in
    --help|-h)
      echo 'Save your work and exit Steam, then run omarchy-launch-gaming-session from a managed handheld desktop.'
      exit 0
      ;;
    --available|--confirm|--wait-for-desktop-exit) ;;
    *) exit 2 ;;
  esac
fi
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
source "$OMARCHY_PATH/default/gaming/session.sh"

managed_desktop() {
  local mode
  [[ -n ${OMARCHY_HANDHELD_SESSION:-} ]] && gaming_runtime_path || return 1
  [[ -d $gaming_runtime && ! -L $gaming_runtime && -O $gaming_runtime ]] || return 1
  [[ -f $gaming_runtime/active && ! -L $gaming_runtime/active ]] || return 1
  read -r mode <"$gaming_runtime/active" && [[ $mode == "desktop" ]]
}

# Used at Hyprland config load, before the compositor exports its display.
if [[ ${1:-} == "--available" ]]; then
  managed_desktop && gaming_handheld_variant
  exit $?
fi

# The menu confirms the switch and the lock gate requests it directly.
omarchy-hw-rog-ally || { gaming_fail 'this action supports the original RC71L only.'; exit 1; }
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -n ${WAYLAND_DISPLAY:-} ]] || exit 1
if ! managed_desktop || ! omarchy-pkg-present omarchy-gaming-session; then
  gaming_fail 'Save your work, then sign out and select Omarchy (handheld desktop) at sign-in.'
  omarchy-notification-send 'Gaming session' 'Sign out and select Omarchy (handheld desktop) first.'
  exit 1
fi
if pgrep -u "$UID" -x steam >/dev/null; then
  gaming_fail 'Exit Steam first so it can start on the gaming display.'
  omarchy-notification-send 'Gaming session' 'Exit Steam, save your work, then try again.'
  exit 1
fi
if ! omarchy-cmd-present gamescope || ! omarchy-cmd-present steam; then
  gaming_fail 'install the optional gaming session dependencies first.'
  exit 1
fi
desktop_unit=wayland-wm@hyprland.desktop.service
desktop_state() {
  systemctl --user show "$desktop_unit" --property=ActiveState --value
}

# The lock gate bounds this mode and needs to observe a running compositor
# before it can use the unit's inactive state as proof of teardown.
if [[ ${1:-} == "--wait-for-desktop-exit" ]]; then
  state=$(desktop_state) && [[ $state == "active" ]] || exit 1
fi
# Release wvkbd while this desktop still owns its Wayland connection, and
# before Gamescope is handed the session. A missing helper or keyboard is a
# no-op, and a stuck helper cannot hold the switch.
if omarchy-cmd-present omarchy-toggle-desktop-keyboard && omarchy-cmd-present wvkbd-mobintl; then
  timeout --kill-after=1s 2s omarchy-toggle-desktop-keyboard stop >/dev/null 2>&1 || true
fi
# The worker survives desktop teardown and owns the marker through the actual
# logout result. Submitting omarchy-system's asynchronous job is not completion.
systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
  --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=OMARCHY_PATH \
  "$OMARCHY_PATH/default/gaming/switch.sh" "$gaming_runtime"

if [[ ${1:-} == "--wait-for-desktop-exit" ]]; then
  for ((poll=0; poll < 60; poll++)); do
    if state=$(desktop_state) && [[ $state == "inactive" ]]; then
      exit 0
    fi
    sleep 0.05
  done
  exit 1
fi
