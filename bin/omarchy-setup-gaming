#!/bin/bash

# omarchy:summary=Set up Steam for desktop play and find Gaming Mode power controls
# omarchy:args=[power|--help]

set -euo pipefail

if (( $# == 1 )) && [[ $1 == "--help" || $1 == "-h" ]]; then
  echo "Usage: omarchy-setup-gaming [power]"
  echo "Open Steam installation, first sign-in, controller and desktop-return guidance."
  echo "Use power for Gaming Mode power limit guidance on the original ROG Ally."
  exit 0
elif (( $# > 1 )) || [[ ${1-power} != "power" ]]; then
  echo "Usage: omarchy-setup-gaming [power|--help]" >&2
  exit 2
fi

row() {
  printf '%s\t%s\t%s' "$1" "$2" "$3"
}

# A cancelled picker is normal; an unavailable shell is an actual failure.
# Match translated labels, without the menu's tab-separated subtext.
choose() {
  local status
  if selection=$(omarchy-menu-select "$@" -- --width 540); then
    selection=${selection%%$'\t'*}
  else
    status=$?
    if (( status == 1 )); then
      exit 0
    else
      exit "$status"
    fi
  fi
}

load_power_option() {
  local hint
  power_status=$(omarchy-setup-ally-power gaming-status 2>/dev/null) || power_status=unavailable
  power_label=$(omarchy-i18n gaming.powerLimits)
  case $power_status in
    ready) hint=$(omarchy-i18n gaming.powerReady) ;;
    asus)
      power_label=$(omarchy-i18n allyPower.title)
      hint=$(omarchy-i18n gaming.powerAsus)
      ;;
    backend) hint=$(omarchy-i18n gaming.powerBackend) ;;
    firmware) hint=$(omarchy-i18n gaming.powerFirmware) ;;
    conflict) hint=$(omarchy-i18n gaming.powerConflict) ;;
    *) hint=$(omarchy-i18n gaming.powerUnavailable) ;;
  esac
  power_option=$(row '' "$power_label" "$hint")
}

if [[ ${1:-} == "power" ]]; then
  omarchy-hw-rog-ally && omarchy-pkg-present omarchy-gaming-session || exit 1
  load_power_option
  choose "$(omarchy-i18n gaming.powerLimits)" "$power_option"
  if [[ $power_status == "asus" && $selection == "$power_label" ]]; then
    omarchy-menu summon setup.ally-power
  fi
  exit
fi

while true; do
  if omarchy-cmd-present steam; then
    options=(
      "$(row '' "$(omarchy-i18n gaming.openBigPicture)" "$(omarchy-i18n gaming.playInsideDesktop)")"
      "$(row '󰍹' "$(omarchy-i18n gaming.desktopMode)" "$(omarchy-i18n gaming.preserveDownloads)")"
    )
  else
    options=("$(row '' "$(omarchy-i18n gaming.installSteam)" "$(omarchy-i18n gaming.chooseSteamInstaller)")")
  fi
  if omarchy-cmd-present omarchy-toggle-desktop-keyboard && omarchy-cmd-present wvkbd-mobintl && omarchy-hw-rog-ally; then
    options+=("$(row '' "$(omarchy-i18n gaming.desktopKeyboard)" "$(omarchy-i18n gaming.keyboardToggle)")")
  elif omarchy-cmd-present omarchy-setup-rog-ally-keyboard && omarchy-hw-rog-ally; then
    options+=("$(row '' "$(omarchy-i18n gaming.installKeyboard)" "$(omarchy-i18n gaming.keyboardAur)")")
  fi
  power_status=''
  if omarchy-hw-rog-ally && omarchy-pkg-present omarchy-gaming-session; then
    load_power_option
    options+=("$power_option")
    options+=("$(row '󰁹' "$(omarchy-i18n gaming.chargeLimit)" "$(omarchy-i18n gaming.chargeLimitHint)")")
    options+=("$(row '󰋊' "$(omarchy-i18n gaming.library)" "$(omarchy-i18n gaming.libraryHint)")")
  fi
  options+=("$(row '󰋖' "$(omarchy-i18n gaming.help)" "$(omarchy-i18n gaming.helpTopics)")" "$(row '󰅖' "$(omarchy-i18n gaming.close)" "$(omarchy-i18n gaming.closeHelp)")")
  choose "$(omarchy-i18n gaming.title)" "${options[@]}"

  if [[ $power_status == "asus" && $selection == "$power_label" ]]; then
    omarchy-menu summon setup.ally-power
    exit
  fi
  if [[ $selection == "$(omarchy-i18n gaming.help)" ]]; then
    choose "$(omarchy-i18n gaming.help)" \
      "$(row '󰌾' "$(omarchy-i18n gaming.firstSignIn)" "$(omarchy-i18n gaming.firstSignInHint)")" \
      "$(row '' "$(omarchy-i18n gaming.controllerTyping)" "$(omarchy-i18n gaming.controllerHint)")" \
      "$(row '󰍹' "$(omarchy-i18n gaming.returnHelp)" "$(omarchy-i18n gaming.returnHint)")" \
      "$(row '󰌑' "$(omarchy-i18n gaming.back)" "$(omarchy-i18n gaming.backHint)")"
  fi

  case "$selection" in
    "$(omarchy-i18n gaming.openBigPicture)") omarchy-launch-steam-bigpicture; exit ;;
    "$(omarchy-i18n gaming.chargeLimit)") omarchy-battery-charge-limit choose || true ;;
    "$(omarchy-i18n gaming.library)")
      # shellcheck source=default/gaming/session.sh
      source "$OMARCHY_PATH/default/gaming/session.sh"
      gaming_handheld_variant || exit 1
      saved=''
      if [[ -f $gaming_state/library ]]; then saved=$(<"$gaming_state/library"); fi
      if choice=$(python "$OMARCHY_PATH/default/gaming/removable-library.py" select "$saved" \
        "$(omarchy-i18n gaming.chooseLibrary)" "$(omarchy-i18n gaming.rememberedLibrary)" \
        "$(omarchy-i18n gaming.noLibraries)"); then
        [[ $choice != "$saved" ]] || continue
        gaming_state_init
        if [[ -n $choice ]]; then
          gaming_save library "$choice"
        else
          rm -f -- "$gaming_state/library"
        fi
      else
        status=$?
        if (( status != 1 )); then exit "$status"; fi
      fi
      ;;
    "$(omarchy-i18n gaming.desktopMode)") omarchy-launch-steam-desktop; exit ;;
    "$(omarchy-i18n gaming.installSteam)") omarchy-menu summon install.gaming; exit ;;
    "$(omarchy-i18n gaming.desktopKeyboard)") omarchy-toggle-desktop-keyboard; exit ;;
    "$(omarchy-i18n gaming.installKeyboard)")
      choose "$(omarchy-i18n gaming.aurReviewTitle)" \
        "$(row '' "$(omarchy-i18n gaming.aurInstall)" "$(omarchy-i18n gaming.aurBuildHint)")" "$(row '󰅖' "$(omarchy-i18n gaming.cancel)" "$(omarchy-i18n gaming.cancelHint)")"
      if [[ $selection == "$(omarchy-i18n gaming.aurInstall)" ]]; then
        omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-keyboard --install-reviewed-aur
        exit
      fi
      ;;
    "$(omarchy-i18n gaming.firstSignIn)")
      choose "$(omarchy-i18n gaming.helpBackTitle)" \
        "$(row '' "$(omarchy-i18n gaming.finishUpdating)" "$(omarchy-i18n gaming.updatingHint)")" \
        "$(row '󰍹' "$(omarchy-i18n gaming.windowedSignIn)" "$(omarchy-i18n gaming.windowedSignInHint)")" \
        "$(row '󰌾' "$(omarchy-i18n gaming.scanQr)" "$(omarchy-i18n gaming.qrHint)")" \
        "$(row '' "$(omarchy-i18n gaming.usbKeyboard)" "$(omarchy-i18n gaming.usbHint)")" "$(row '󰌑' "$(omarchy-i18n gaming.back)" "$(omarchy-i18n gaming.backHint)")"
      ;;
    "$(omarchy-i18n gaming.controllerTyping)")
      choose "$(omarchy-i18n gaming.helpBackTitle)" \
        "$(row '' "$(omarchy-i18n gaming.controllerSettings)" "$(omarchy-i18n gaming.controllerSettingsHint)")" \
        "$(row '' "$(omarchy-i18n gaming.touchFallback)" "$(omarchy-i18n gaming.touchFallbackHint)")" \
        "$(row '' "$(omarchy-i18n gaming.steamKeyboard)" "$(omarchy-i18n gaming.steamKeyboardHint)")" "$(row '󰌑' "$(omarchy-i18n gaming.back)" "$(omarchy-i18n gaming.backHint)")"
      ;;
    "$(omarchy-i18n gaming.returnHelp)")
      choose "$(omarchy-i18n gaming.helpBackTitle)" \
        "$(row '󰍹' "$(omarchy-i18n gaming.fullscreenSignIn)" "$(omarchy-i18n gaming.fullscreenSignInHint)")" \
        "$(row '󰍹' "$(omarchy-i18n gaming.powerMenu)" "$(omarchy-i18n gaming.powerMenuHint)")" \
        "$(row '' "$(omarchy-i18n gaming.steamStaysOpen)" "$(omarchy-i18n gaming.downloadsHint)")" "$(row '󰌑' "$(omarchy-i18n gaming.back)" "$(omarchy-i18n gaming.backHint)")"
      ;;
    "$(omarchy-i18n gaming.close)") exit 0 ;;
  esac
done
