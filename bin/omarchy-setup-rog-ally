#!/bin/bash

# omarchy:summary=Open original ROG Ally setup, status, storage and recovery tools
# omarchy:args=[--help]

set -euo pipefail
if (( $# == 1 )) && [[ $1 == "--help" || $1 == "-h" ]]; then
  echo 'Usage: omarchy-setup-rog-ally'
  echo 'Choose each handheld component explicitly. Existing backend setup owns installation and rollback.'
  exit 0
fi
(( $# == 0 )) || exit 2
if ! omarchy-hw-rog-ally; then
  echo 'Handheld setup supports the original ASUS ROG Ally RC71L only.' >&2
  exit 1
fi

row() { printf '%s\t%s\t%s' "$1" "$2" "$3"; }
reviewed_input_installed() {
  local companion
  # This setup boundary requires the exact companion reviewed with the runtime.
  companion=$(pacman -Q omarchy-rog-ally-input 2>/dev/null) || return 1
  [[ $companion == "omarchy-rog-ally-input 1.0.2-1" ]]
}
choose() {
  local status
  if selection=$(omarchy-menu-select "$@" -- --width 620); then
    selection=${selection%%$'\t'*}
  else
    status=$?
    if (( status == 1 )); then exit 0; else exit "$status"; fi
  fi
}

while true; do
  options=("$(row '󰋖' 'Status' 'Packages, services, recovery readiness and unverified device checks')")
  # Backend setup commands are optional increments. Never invoke an absent
  # command or silently install a different backend in its place.
  if omarchy-cmd-present omarchy-setup-rog-ally-input && omarchy-cmd-present omarchy-hw-rog-ally-input; then
    options+=("$(row '' 'Controller input' 'Reviewed companion setup, readiness and disable; keep touch or USB keyboard recovery')")
  fi
  if omarchy-cmd-present omarchy-setup-rog-ally-power && omarchy-cmd-present omarchy-power-ally; then
    options+=("$(row '󰁹' 'Power setup' 'Readiness and legacy rollback; unchanged Manager package must not be installed')")
  fi
  if omarchy-cmd-present omarchy-setup-gaming-session; then
    options+=("$(row '' 'Gaming session' 'Authenticated session preference, rendering, desktop recovery')")
  fi
  if omarchy-cmd-present omarchy-display-rog-ally; then
    options+=("$(row '󰍹' 'Display and touch layout' 'Inspect actual modes or choose the optional touch preset')")
  fi
  options+=("$(row '' 'Game software' 'Steam, other launchers and optional compatibility tools')"
    "$(row '' 'Desktop keyboard' 'Review and install the optional wvkbd AUR package')"
    "$(row '󰋊' 'Game libraries' 'Mount an existing microSD or USB filesystem; never format')"
    "$(row '󰑓' 'Update and recovery' 'Normal Omarchy updates and existing system snapshots')"
    "$(row '󰅖' 'Close' 'Leave setup without changing anything')")
  choose 'ROG Ally handheld setup' "${options[@]}"
  case "$selection" in
    'Status') omarchy-hw-rog-ally-status --menu ;;
    'Controller input')
      input_options=("$(row '󰋖' 'Input readiness' 'Shareable package, service, composite and capability summary')")
      if reviewed_input_installed; then
        input_options+=("$(row '' 'Enable reviewed input' 'Explicit opt-in with installed companion 1.0.2-1; no packages installed')")
      fi
      input_options+=("$(row '󰋖' 'Input setup requirements' 'Matching runtime + reviewed companion 1.0.2-1; visible terminal and recovery input')"
        "$(row '󰁯' 'Disable input integration' 'Disable before removing companion or restoring an old owner')"
        "$(row '󰌑' 'Back' 'No changes')")
      choose 'InputPlumber — keep a touch or USB keyboard recovery route' "${input_options[@]}"
      case "$selection" in
        'Input readiness') omarchy-hw-rog-ally-status --menu ;;
        'Enable reviewed input')
          choose 'Enable reviewed InputPlumber in a visible terminal?' \
            "$(row '' 'Enable input now' 'Keep touch or USB keyboard available; backend refuses competing owners')" \
            "$(row '󰌑' 'Back' 'No changes')"
          if [[ $selection == 'Enable input now' ]]; then
            if omarchy-cmd-present omarchy-setup-rog-ally-input && omarchy-cmd-present omarchy-hw-rog-ally-input && reviewed_input_installed; then
              omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-input --enable
              exit
            else
              choose 'Input prerequisites changed — nothing enabled' \
                "$(row '󰌑' 'Back' 'Install matching runtime and reviewed companion 1.0.2-1 before retrying')"
            fi
          fi
          ;;
        'Input setup requirements')
          choose 'Reviewed input setup requirements' \
            "$(row '󰋖' 'Matching packages' 'Install matching reviewed runtime + companion 1.0.2-1; setup installs no packages')" \
            "$(row '󰌾' 'Recovery input' 'Keep touch or a USB keyboard available before changing controller ownership')" \
            "$(row '󰁯' 'Rollback order' 'Disable integration before companion removal or restoring the prior owner')" \
            "$(row '󰌑' 'Back' 'Follow docs/rog-ally-input.md for dependency installation and rollback')"
          ;;
        'Disable input integration') omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-input --disable; exit ;;
      esac
      ;;
    'Power setup')
      choose 'Power activation blocked — unchanged Manager package rejected' \
        "$(row '󰋖' 'Power readiness' 'Actual available controls and readback; no hardware changes')" \
        "$(row '󰁯' 'Roll back power backend' 'Verify original settings, then restore prior services; reconnect AC if needed')" \
        "$(row '󰌑' 'Back' 'No changes')"
      case "$selection" in
        'Power readiness') omarchy-hw-rog-ally-status --menu ;;
        'Roll back power backend') omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-power --rollback; exit ;;
      esac
      ;;
    'Gaming session')
      choose 'Select Omarchy (session preference) at sign-in; original desktop is recovery' \
        "$(row '󰋖' 'Session status' 'Local preference state; package registration and device checks remain separate')" \
        "$(row '' 'Default gaming' 'Persistent preference; password sign-in is retained')" \
        "$(row '󰍹' 'Default desktop' 'Persistent desktop preference; no autologin')" \
        "$(row '󰑓' 'Default last session' 'Remember the last entered desktop or gaming mode')" \
        "$(row '' 'Next login gaming' 'One-shot choice at the next managed sign-in')" \
        "$(row '󰍹' 'Next login desktop' 'One-shot desktop recovery')" \
        "$(row '󰁯' 'Clear next login override' 'Keep the persistent preference')" \
        "$(row '' 'Launch gaming session' 'Save work and exit Steam first; requires managed preference login')" \
        "$(row '󰍹' 'Gaming overlay' 'Optional mangoapp; applies to the next dedicated gaming session')" \
        "$(row '󰍹' 'Render settings' 'Game render size, FPS cap and filter; physical display mode stays separate')" \
        "$(row '󰁯' 'Reset session preferences' 'Reset preferences, render/overlay settings and recovery latch; keep games/logs')" \
        "$(row '󰌑' 'Back' 'No changes')"
      session_args=()
      case "$selection" in
        'Launch gaming session')
          choose 'Save work and fully exit Steam before leaving desktop' 'Launch gaming now' 'Back'
          if [[ $selection == 'Launch gaming now' ]]; then
            omarchy-launch-floating-terminal-with-presentation omarchy-launch-gaming-session
            exit
          fi
          ;;
        'Session status') omarchy-launch-floating-terminal-with-presentation omarchy-setup-gaming-session status; exit ;;
        'Default gaming') session_args=(default gaming) ;;
        'Default desktop') session_args=(default desktop) ;;
        'Default last session') session_args=(default last) ;;
        'Next login gaming') session_args=(next gaming) ;;
        'Next login desktop') session_args=(next desktop) ;;
        'Clear next login override') session_args=(next clear) ;;
        'Reset session preferences')
          choose 'Reset session settings; keep Steam data and logs?' 'Reset session settings' 'Back'
          if [[ $selection == 'Reset session settings' ]]; then session_args=(reset); fi
          ;;
        'Gaming overlay')
          choose 'Gaming overlay — install MangoHud tools first' 'Enable gaming overlay' 'Disable gaming overlay' 'Back'
          case "$selection" in
            'Enable gaming overlay') session_args=(overlay on) ;;
            'Disable gaming overlay') session_args=(overlay off) ;;
          esac
          ;;
        'Render settings')
          choose 'Game render size' 'native' '720p' '900p' '1080p' 'Back'
          if [[ $selection != 'Back' ]]; then
            render=$selection
            choose 'FPS limit — requested cap, not measured performance' '0' '30' '40' '45' '60' '90' '120' 'Back'
            if [[ $selection != 'Back' ]]; then
              fps=$selection
              choose 'Gamescope spatial filter' 'linear' 'nearest' 'fsr' 'nis' 'Back'
              if [[ $selection != 'Back' ]]; then session_args=(display "$render" "$fps" "$selection"); fi
            fi
          fi
          ;;
      esac
      if (( ${#session_args[@]} > 0 )); then
        omarchy-launch-floating-terminal-with-presentation omarchy-setup-gaming-session "${session_args[@]}"
        exit
      fi
      ;;
    'Display and touch layout')
      choose 'Display and touch layout' \
        "$(row '󰋖' 'Display status' 'Read advertised capabilities and actual touchscreen names')" \
        "$(row '' 'Apply touch preset' 'Optional 1.5x internal scale and larger bar; preserves original backups')" \
        "$(row '󰁯' 'Restore touch preset' 'Restore the preset backup; later layout edits may need review')" \
        "$(row '󰌑' 'Back' 'No changes')"
      display_args=()
      case "$selection" in
        'Display status') display_args=(status) ;;
        'Apply touch preset') display_args=(touch-preset) ;;
        'Restore touch preset') display_args=(touch-preset reset) ;;
      esac
      if (( ${#display_args[@]} > 0 )); then
        omarchy-launch-floating-terminal-with-presentation omarchy-display-rog-ally "${display_args[@]}"
        exit
      fi
      ;;
    'Game software')
      game_options=("$(row '' 'Game installers' 'Open the existing Steam and launcher installers')")
      if omarchy-cmd-present omarchy-install-gaming-tools; then
        game_options+=("$(row '' 'Compatibility tools' 'Optional UMU, Protontricks and Winetricks')"
          "$(row '' 'ProtonPlus' 'Optional runner manager; existing prefixes stay intact')"
          "$(row '󰍹' 'Performance overlay' 'Optional MangoHud; enable it per game')"
          "$(row '󰍹' 'GOverlay' 'Optional overlay configuration application')"
          "$(row '󰖔' 'Sunshine' 'Optional streaming application; host permissions remain separate')")
      fi
      if omarchy-cmd-present omarchy-install-gaming-decky && omarchy-cmd-present omarchy-setup-gaming-decky; then
        game_options+=("$(row '' 'Decky' 'Optional root-plugin loader; installation and activation are separate')")
      fi
      game_options+=("$(row '󰌑' 'Back' 'Return without installation')")
      choose 'Game software' "${game_options[@]}"
      component=''
      case "$selection" in
        'Game installers') omarchy-menu summon install.gaming; exit ;;
        'Compatibility tools') component=compatibility ;;
        'ProtonPlus') component=protonplus ;;
        'Performance overlay') component=overlay ;;
        'GOverlay') component=goverlay ;;
        'Sunshine') component=sunshine ;;
        'Decky')
          choose 'Optional Decky — plugins run as root' \
            "$(row '󰋖' 'Decky status' 'Inspect locally; this output is not part of the shareable status report')" \
            "$(row '' 'Install reviewed Decky' 'Review AUR source and companion instructions first; package stays disabled')" \
            "$(row '' 'Enable root plugins' 'Requires reviewed package + companion; enables Steam debugging')" \
            "$(row '󰁯' 'Disable Decky' 'Stop the service; preserve plugins and user data')" \
            "$(row '󰌑' 'Back' 'No changes')"
          case "$selection" in
            'Decky status') omarchy-launch-floating-terminal-with-presentation omarchy-setup-gaming-decky status; exit ;;
            'Install reviewed Decky') omarchy-launch-floating-terminal-with-presentation omarchy-install-gaming-decky --install-reviewed-aur; exit ;;
            'Enable root plugins')
              choose 'Allow root plugins and Steam debugging?' \
                "$(row '' 'Allow root plugins' 'Explicitly enable the reviewed Decky backend; no plugins are installed')" \
                "$(row '󰌑' 'Back' 'No changes')"
              if [[ $selection == 'Allow root plugins' ]]; then
                omarchy-launch-floating-terminal-with-presentation omarchy-setup-gaming-decky enable --allow-root-plugins
                exit
              fi
              ;;
            'Disable Decky') omarchy-launch-floating-terminal-with-presentation omarchy-setup-gaming-decky disable; exit ;;
          esac
          ;;
      esac
      if [[ -n $component ]]; then
        omarchy-launch-floating-terminal-with-presentation omarchy-install-gaming-tools "$component"
        exit
      fi
      ;;
    'Desktop keyboard')
      keyboard_options=()
      if omarchy-cmd-present wvkbd-mobintl; then
        keyboard_options+=("$(row '' 'Toggle desktop keyboard' 'Show or hide the desktop keyboard; unavailable in a gaming session')")
      fi
      keyboard_options+=("$(row '' 'Configure reviewed keyboard' 'Use an already installed reviewed wvkbd 0.21-1; no package install')"
        "$(row '' 'Install reviewed keyboard' 'Review wvkbd AUR source first; installer preserves existing launcher')"
        "$(row '󰌑' 'Back' 'No changes')")
      choose 'Optional desktop keyboard' "${keyboard_options[@]}"
      case "$selection" in
        'Toggle desktop keyboard') omarchy-toggle-desktop-keyboard toggle; exit ;;
        'Configure reviewed keyboard')
          omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-keyboard --configure-reviewed-package
          exit ;;
        'Install reviewed keyboard')
          omarchy-launch-floating-terminal-with-presentation omarchy-setup-rog-ally-keyboard --install-reviewed-aur
          exit ;;
      esac
      ;;
    'Game libraries') omarchy-launch-floating-terminal-with-presentation omarchy-drive-game-library --menu; exit ;;
    'Update and recovery')
      choose 'Update and recovery' \
        "$(row '󰋖' 'Check updates' 'Check repository package count without installing anything')" \
        "$(row '󰑓' 'Omarchy updates' 'Open the normal update menu; use a full system update')" \
        "$(row '󰋊' 'Create system snapshot' 'Requires configured Snapper; excludes home and saves')" \
        "$(row '󰁯' 'Restore system snapshot' 'Use after booting a known-good Limine snapshot; home stays unchanged')" \
        "$(row '󰋖' 'Recovery instructions' 'Boot fallback, firmware, backups and per-component rollback')" \
        "$(row '󰌑' 'Back' 'Return to handheld setup')"
      case "$selection" in
        'Check updates') omarchy-hw-rog-ally-status --menu --updates ;;
        'Omarchy updates') omarchy-menu summon update; exit ;;
        'Create system snapshot') omarchy-launch-floating-terminal-with-presentation omarchy-snapshot create; exit ;;
        'Restore system snapshot')
          choose 'Restore the root system; home and saves stay unchanged' \
            "$(row '󰁯' 'Open snapshot restore' 'Existing Limine restore tool; review the selected snapshot before applying')" \
            "$(row '󰌑' 'Back' 'No changes')"
          if [[ $selection == 'Open snapshot restore' ]]; then
            omarchy-launch-floating-terminal-with-presentation omarchy-snapshot restore
            exit
          fi
          ;;
        'Recovery instructions')
          choose 'Recovery and backup guidance' \
            "$(row '󰋊' 'Boot recovery' 'Choose a known-good snapshot in Limine, then run snapshot restore')" \
            "$(row '󰌾' 'Direct boot or failed startup' 'Choose Limine from firmware boot options; keep a USB keyboard for unlock')" \
            "$(row '󰁯' 'No automatic rollback' 'Repeated failures do not automatically select an older snapshot')" \
            "$(row '󰋊' 'Save backups' 'Back up saves and prefixes to separate storage; root snapshots exclude home')" \
            "$(row '󰋖' 'Firmware' 'Use LVFS/device-supported instructions; no firmware is flashed here')" \
            "$(row '󰌑' 'Back' 'Full instructions: manual/rog-ally-recovery.md')"
          ;;
      esac
      ;;
    'Close') exit 0 ;;
  esac
done
