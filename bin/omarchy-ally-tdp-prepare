#!/bin/bash

# omarchy:summary=Sync the Ally PPD mask with the handheld TDP owner gate
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Masks power-profiles-daemon only while omarchy-hw-rog-ally matches, the
# handheld variant is installed, and omarchy-ally-tdp-apply is installed.
# Removes that mask when the gate stops applying. asusd is a different task.

if [[ $(id -u) -ne 0 && ${OMARCHY_ALLY_TDP_FIXTURE:-} != 1 ]]; then
  echo "omarchy-ally-tdp-prepare must run as root." >&2
  exit 1
fi

if [[ $(id -u) -eq 0 ]]; then
  if [[ -n ${OMARCHY_PATH:-} ]]; then
    echo "ally-tdp: ignoring OMARCHY_PATH. Do not use sudo --preserve-env." >&2
  fi
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
  module=/usr/share/omarchy/default/handheld/ally_tdp.py
else
  module=""
  if [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/default/handheld/ally_tdp.py ]]; then
    module=$OMARCHY_PATH/default/handheld/ally_tdp.py
  else
    module=/usr/share/omarchy/default/handheld/ally_tdp.py
  fi
fi

if [[ ! -f $module ]]; then
  echo "ally-tdp: cannot find the TDP helper module" >&2
  exit 1
fi

if [[ $(id -u) -eq 0 ]]; then
  owner=$(stat -c %u "$module")
  mode=$(stat -c %a "$module")
  if [[ $owner != 0 ]] || (( (8#$mode & 8#022) != 0 )); then
    echo "ally-tdp: packaged module is not a root-owned private file" >&2
    exit 1
  fi
fi

exec python3 -B "$module" prepare "$@"
