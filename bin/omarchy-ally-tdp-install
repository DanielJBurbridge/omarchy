#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Install or remove the ROG Ally TDP units
# omarchy:args=hardware | power-source | session | remove-session | remove

# hardware is every Ally, including a deny-all polkit rule beside the policy.
# session reconciles the reapply units too, for package installs that missed
# hardware setup. It also sets up the shim, user rule and power daemon mask.
# A non-root process may write only into OMARCHY_ALLY_TDP_DEST while
# OMARCHY_ALLY_TDP_FIXTURE=1.
# Root ignores that destination unless the fixture flag is also set.

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

log() {
  printf 'omarchy-ally-tdp-install: %s\n' "$*" >&2
}

usage() {
  echo "Usage: omarchy-ally-tdp-install hardware | power-source | session | remove-session | remove" >&2
  exit 1
}

prefix=
if [[ $EUID -ne 0 ]]; then
  if [[ ${OMARCHY_ALLY_TDP_FIXTURE:-} != 1 || -z ${OMARCHY_ALLY_TDP_DEST:-} ]]; then
    log "install must run as root"
    exit 1
  fi
  prefix=$OMARCHY_ALLY_TDP_DEST
elif [[ ${OMARCHY_ALLY_TDP_FIXTURE:-} == 1 && -n ${OMARCHY_ALLY_TDP_DEST:-} ]]; then
  prefix=$OMARCHY_ALLY_TDP_DEST
fi

copy_file() {
  local src=$1 dest=$2
  [[ -f $src ]] || {
    log "missing $src"
    return 1
  }
  install -D -m 0644 "$src" "$prefix$dest"
}

sc() {
  if [[ -n $prefix ]]; then
    systemctl --root="$prefix" "$@"
  else
    systemctl "$@"
  fi
}

reload_systemd() {
  sc daemon-reload
}

unit_state() {
  local state
  state=$(sc is-enabled "$1" 2>/dev/null || true)
  printf '%s\n' "$state"
}

enable_unit() {
  local unit=$1 state
  state=$(unit_state "$unit")
  if [[ $state == masked* ]]; then
    log "leaving masked unit $unit in place"
    return 0
  fi
  sc enable "$unit"
}

enable_shim() {
  local state
  state=$(unit_state omarchy-ally-tdp-shim.service)
  if [[ $state == masked ]]; then
    log "leaving masked unit omarchy-ally-tdp-shim.service in place"
    return 0
  fi
  if [[ -n $prefix ]]; then
    systemctl --root="$prefix" --global enable omarchy-ally-tdp-shim.service
  else
    systemctl --global enable omarchy-ally-tdp-shim.service
  fi
}

handheld_user() {
  local file=$prefix/etc/sddm.conf.d/omarchy-handheld-user.conf
  local line user
  [[ -f $file && ! -L $file ]] || return 1
  local mode owner
  mode=$(stat -c %a -- "$file")
  owner=$(stat -c %u -- "$file")
  [[ $owner == 0 ]] || return 1
  # Group or other write would let a local account name itself.
  if (( (8#$mode & 8#022) != 0 )); then
    return 1
  fi
  while IFS= read -r line; do
    if [[ $line == User=* ]]; then
      user=${line#User=}
    fi
  done <"$file"
  [[ -n ${user:-} ]] || return 1
  [[ $user != sddm ]] || return 1
  [[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || return 1
  printf '%s\n' "$user"
}

rule_dest() {
  printf '%s\n' "$prefix/etc/polkit-1/rules.d/50-omarchy-ally-set-tdp.rules"
}

# Hardware and a removed session leave this rule. It returns NO for every
# caller, so allow_active=yes cannot authorize a desktop session.
write_deny_rule() {
  local dest
  dest=$(rule_dest)
  mkdir -p -- "$(dirname -- "$dest")"
  cat >"$dest" <<'EOF'
// Generated by omarchy-ally-tdp-install.
// YES only for the handheld user named in omarchy-handheld-user.conf, and
// only while that session is active and local. sddm is never authorized.
// Every other user is NO, so allow_active=yes cannot authorize them.
polkit.addRule(function(action, subject) {
  if (action.id != "org.omarchy.ally.set-tdp") {
    return polkit.Result.NOT_HANDLED;
  }
  if (subject.user == "sddm") {
    return polkit.Result.NO;
  }
  return polkit.Result.NO;
});
EOF
  chmod 0644 "$dest"
}

write_rule() {
  local user dest template
  dest=$(rule_dest)
  # handheld_user accepts only ^[a-z_][a-z0-9_-]*[$]?$. The name is data in
  # the substitution below. It is never a printf format.
  if ! user=$(handheld_user); then
    write_deny_rule
    return 0
  fi
  mkdir -p -- "$(dirname -- "$dest")"
  template=$(cat <<'EOF'
// Generated by omarchy-ally-tdp-install.
// YES only for the handheld user named in omarchy-handheld-user.conf, and
// only while that session is active and local. sddm is never authorized.
// Every other user is NO, so allow_active=yes cannot authorize them.
// A %s or \n in this text stays literal. The username is text, not a format.
polkit.addRule(function(action, subject) {
  if (action.id != "org.omarchy.ally.set-tdp") {
    return polkit.Result.NOT_HANDLED;
  }
  if (subject.user == "sddm") {
    return polkit.Result.NO;
  }
  if (subject.active && subject.local && subject.user == "@USER@") {
    return polkit.Result.YES;
  }
  return polkit.Result.NO;
});
EOF
)
  printf '%s\n' "${template//@USER@/$user}" >"$dest"
  chmod 0644 "$dest"
}

ppd_unit=power-profiles-daemon.service
ppd_record=$prefix/var/lib/omarchy/handheld/power-profiles-daemon.state
ppd_mask=$prefix/etc/systemd/system/$ppd_unit
ppd_mask_target=/etc/omarchy/handheld/omarchy-ally-tdp-ppd-mask.service

ppd_owns_mask_target() {
  [[ -L $prefix$ppd_mask_target && $(readlink -- "$prefix$ppd_mask_target") == /dev/null ]]
}

ppd_owns_mask() {
  [[ -L $ppd_mask && $(readlink -- "$ppd_mask") == "$ppd_mask_target" ]] && ppd_owns_mask_target
}

ppd_has_legacy_mask() {
  [[ -L $ppd_mask && $(readlink -- "$ppd_mask") == /dev/null ]]
}

ppd_activity() {
  if [[ -n $prefix ]]; then
    printf '%s\n' unknown
    return
  fi
  local state
  state=$(sc show --property=ActiveState --value "$ppd_unit") || return 1
  case $state in
    active | reloading) printf '%s\n' active ;;
    inactive | failed) printf '%s\n' inactive ;;
    *) log "could not determine whether $ppd_unit is running (state: $state)"; return 1 ;;
  esac
}

reconcile_ppd_activity() {
  local expected=$1 current
  case $expected in
    active | inactive) ;;
    *) return 0 ;;
  esac
  current=$(ppd_activity) || return 1
  if [[ $current == unknown || $current == "$expected" ]]; then
    return 0
  fi
  if [[ $expected == active ]]; then
    sc start "$ppd_unit"
  else
    sc stop "$ppd_unit"
  fi
}

read_ppd_receipt() {
  local receipt
  receipt=$(<"$ppd_record") || return 1
  case $receipt in
    'v2 active' | 'v2 inactive' | 'v2 unknown' | 'v2 external')
      printf '%s\n' "${receipt#v2 }"
      ;;
    masked | bad | not-found | '') printf '%s\n' external ;;
    alias | disabled | enabled | enabled-runtime | generated | indirect | linked | linked-runtime | masked-runtime | static | transient)
      printf '%s\n' legacy
      ;;
    *) log "invalid power-profiles-daemon handoff receipt"; return 1 ;;
  esac
}

write_ppd_receipt() {
  local dir=${ppd_record%/*} temporary
  mkdir -p -- "$dir"
  temporary=$(mktemp "$dir/.power-profiles-daemon.XXXXXXXX")
  if ! printf 'v2 %s\n' "$1" >"$temporary" || ! mv -T -- "$temporary" "$ppd_record"; then
    rm -f -- "$temporary"
    log "could not save the power-profiles-daemon handoff receipt"
    return 1
  fi
}

mask_ppd() {
  local receipt='' state activity
  if [[ -f $ppd_record ]]; then
    receipt=$(read_ppd_receipt) || return 1
  fi
  if ! ppd_owns_mask && ! { [[ $receipt == legacy ]] && ppd_has_legacy_mask; }; then
    state=$(unit_state "$ppd_unit")
    if [[ $state == masked* ]]; then
      if [[ -z $receipt ]]; then
        write_ppd_receipt external || return 1
      fi
      return 0
    fi
    if [[ -z $state || -e $ppd_mask || -L $ppd_mask ]]; then
      log "could not mask $ppd_unit while preserving its existing unit configuration"
      return 1
    fi
    if [[ -z $receipt || $receipt == external ]]; then
      activity=$(ppd_activity) || return 1
      write_ppd_receipt "$activity" || return 1
    fi
    # A distinct mask target lets removal recognise our link after an
    # interruption without calling unmask on administrator links.
    if [[ ! -e $prefix$ppd_mask_target && ! -L $prefix$ppd_mask_target ]]; then
      mkdir -p -- "$prefix${ppd_mask_target%/*}"
      ln -sT -- /dev/null "$prefix$ppd_mask_target"
    fi
    if ! ppd_owns_mask_target; then
      log "the Omarchy mask target for $ppd_unit was replaced"
      return 1
    fi
    mkdir -p -- "${ppd_mask%/*}"
    ln -sT -- "$ppd_mask_target" "$ppd_mask"
  fi
  reload_systemd
  reconcile_ppd_activity inactive
}

restore_ppd() {
  local receipt
  [[ -f $ppd_record ]] || return 0
  receipt=$(read_ppd_receipt) || return 1
  if [[ $receipt != external ]]; then
    # For a legacy receipt, a unit that originally lacked a persistent mask
    # is the only evidence the old installer left for its plain /etc mask.
    # The old installer recorded no activity.
    if ppd_owns_mask || { [[ $receipt == legacy ]] && ppd_has_legacy_mask; }; then
      rm -- "$ppd_mask"
    fi
    reload_systemd
    reconcile_ppd_activity "$receipt"
    if ppd_owns_mask_target; then
      rm -- "$prefix$ppd_mask_target"
    fi
  fi
  rm -- "$ppd_record"
}

lock_session() {
  mkdir -p -- "$prefix/run"
  exec 9>"$prefix/run/omarchy-ally-tdp-install.lock"
  if ! flock -w 5 9; then
    log "another Ally TDP session change is in progress"
    return 1
  fi
}

install_power_source() {
  local watcher=omarchy-ally-tdp-source.path state
  state=$(unit_state "$watcher")
  if [[ $state != masked* ]]; then
    copy_file "$OMARCHY_PATH/default/systemd/system/$watcher" "/etc/systemd/system/$watcher"
  fi
  copy_file "$OMARCHY_PATH/default/systemd/system/omarchy-ally-tdp-source.service" \
    /etc/systemd/system/omarchy-ally-tdp-source.service
  copy_file "$OMARCHY_PATH/default/udev/99-omarchy-ally-tdp.rules" \
    /etc/udev/rules.d/99-omarchy-ally-tdp.rules
  reload_systemd
  if [[ $state == masked* ]]; then
    log "leaving masked unit $watcher in place"
  else
    sc enable "$watcher"
  fi
  if [[ -z $prefix ]]; then
    udevadm control --reload
    if [[ $state != masked* ]]; then
      sc start "$watcher"
    fi
  fi
}

install_reapply_units() {
  local resume=omarchy-ally-tdp-resume.service
  if [[ $(unit_state "$resume") != masked* ]]; then
    copy_file "$OMARCHY_PATH/default/systemd/system/$resume" "/etc/systemd/system/$resume"
  fi
  install_power_source
  enable_unit "$resume"
}

install_hardware() {
  omarchy-hw-rog-ally || return 0
  # The deny rule lands before the policy. A desktop-only Ally, and the
  # moment before the session install, stay NO. Session replaces this with
  # the handheld user's YES.
  write_deny_rule
  copy_file "$OMARCHY_PATH/default/polkit/org.omarchy.ally.set-tdp.policy" \
    /usr/share/polkit-1/actions/org.omarchy.ally.set-tdp.policy
  install_reapply_units
}

install_session() {
  omarchy-hw-rog-ally || return 0
  omarchy-pkg-present omarchy-gaming-session || return 0
  lock_session
  [[ -x /usr/bin/omarchy-ally-tdp-apply || -x $OMARCHY_PATH/bin/omarchy-ally-tdp-apply ]] || {
    log "omarchy-ally-tdp-apply is not installed"
    return 1
  }
  copy_file "$OMARCHY_PATH/default/systemd/user/omarchy-ally-tdp-shim.service" \
    /etc/systemd/user/omarchy-ally-tdp-shim.service
  copy_file "$OMARCHY_PATH/default/dbus/com.steampowered.SteamOSManager1.service" \
    /usr/share/dbus-1/services/com.steampowered.SteamOSManager1.service
  # The rule is in place before the policy, including a session install that
  # did not run hardware first. allow_active=yes never stands alone.
  write_rule
  copy_file "$OMARCHY_PATH/default/polkit/org.omarchy.ally.set-tdp.policy" \
    /usr/share/polkit-1/actions/org.omarchy.ally.set-tdp.policy
  install_reapply_units
  enable_shim
  mask_ppd
  if [[ -z $prefix ]]; then
    busctl call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 || true
  fi
}

remove_paths() {
  local path
  for path in \
    /etc/systemd/user/omarchy-ally-tdp-shim.service \
    /usr/share/dbus-1/services/com.steampowered.SteamOSManager1.service \
    /etc/polkit-1/rules.d/50-omarchy-ally-set-tdp.rules
  do
    rm -f -- "$prefix$path"
  done
}

remove_session() {
  if [[ -n $prefix ]]; then
    systemctl --root="$prefix" --global disable omarchy-ally-tdp-shim.service >/dev/null 2>&1 || true
  else
    systemctl --global disable omarchy-ally-tdp-shim.service >/dev/null 2>&1 || true
  fi
  remove_paths
  # The policy stays with the hardware install. Put the deny rule back so
  # removing the session does not reopen allow_active=yes.
  if [[ -f $prefix/usr/share/polkit-1/actions/org.omarchy.ally.set-tdp.policy ]]; then
    write_deny_rule
  fi
  restore_ppd
  # The vanished PPD receipt prevents new handoffs from starting. Restore
  # under the writer's lock even if a first claim is still saving its receipt.
  if [[ -z $prefix ]] && omarchy-hw-rog-ally; then
    if [[ -x /usr/bin/omarchy-setup-ally-power ]]; then
      /usr/bin/omarchy-setup-ally-power restore-asus >/dev/null || return 1
    elif [[ -f /var/lib/omarchy/handheld/asus-power-handoff.state ]]; then
      log "restore the ASUS power handoff before removing its backend"
      return 1
    fi
  fi
  reload_systemd || return 1
}

remove_all() {
  sc disable --now omarchy-ally-tdp-source.path >/dev/null 2>&1 || true
  sc disable --now omarchy-ally-tdp-resume.service >/dev/null 2>&1 || true
  sc disable --now omarchy-ally-tdp-source.service >/dev/null 2>&1 || true
  remove_session
  rm -f -- \
    "$prefix/etc/systemd/system/omarchy-ally-tdp-resume.service" \
    "$prefix/etc/systemd/system/omarchy-ally-tdp-source.service" \
    "$prefix/etc/systemd/system/omarchy-ally-tdp-source.path" \
    "$prefix/run/omarchy-ally-tdp-source.pending" \
    "$prefix/etc/udev/rules.d/99-omarchy-ally-tdp.rules" \
    "$prefix/usr/share/polkit-1/actions/org.omarchy.ally.set-tdp.policy" \
    "$prefix/etc/polkit-1/rules.d/50-omarchy-ally-set-tdp.rules"
  if [[ -z $prefix ]]; then
    udevadm control --reload || true
  fi
  reload_systemd
}

action=${1:-}
[[ $# -eq 1 ]] || usage

case $action in
  hardware)
    install_hardware
    ;;
  power-source)
    if omarchy-hw-rog-ally; then
      install_power_source
    fi
    ;;
  session)
    install_session
    ;;
  remove-session)
    lock_session
    remove_session
    ;;
  remove)
    lock_session
    remove_all
    ;;
  *)
    usage
    ;;
esac
