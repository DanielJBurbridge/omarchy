#!/bin/bash

# omarchy:summary=Handle the desktop power button on the original ASUS ROG Ally
# omarchy:hidden=true

set -euo pipefail

omarchy-hw-rog-ally || exit 0

# Coalesce overlapping power-key events while the desktop is locking.
exec 9>"$XDG_RUNTIME_DIR/omarchy-power-button.lock"
flock -n 9 || exit 0

# A press can arrive while the fingerprint reader is unlocking the desktop.
# Only an explicit unlocked reply allows a new action.
locked=$(timeout --kill-after=0.1s 0.5s hyprctl locked 2>/dev/null) || exit 0
[[ $locked == "false" ]] || exit 0

if omarchy-sleep-disabled || omarchy-toggle-enabled suspend-off; then
  omarchy-menu toggle system
elif "$OMARCHY_PATH/bin/omarchy-system-sleep-lock"; then
  systemctl suspend
else
  echo "Suspend cancelled because the desktop did not lock." >&2
  exit 1
fi
