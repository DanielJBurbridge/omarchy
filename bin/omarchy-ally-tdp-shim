#!/usr/bin/python3
# omarchy:hidden=true
# omarchy:summary=Session bus owner for Steam's TDP slider on the ROG Ally RC71L
"""Session bus owner for Steam's TDP slider on the ROG Ally RC71L.

TdpLimit1 is loaded from the vendored MIT interface (evlaV/steamos-manager
85fbd8f, Collabora, Valve, Igalia). The notice sits beside that file. The
device model is reported through the SteamOS Manager interface.
This process never writes sysfs. It pkexecs omarchy-ally-tdp-apply for
--set only. Wake reassert is omarchy-ally-tdp-resume.service.
"""

import os
import signal
import subprocess
import sys
from pathlib import Path

BUS = "com.steampowered.SteamOSManager1"
OBJECT = "/com/steampowered/SteamOSManager1"
TDP = BUS + ".TdpLimit1"
MANAGER = BUS + ".Manager2"
PROPS = "org.freedesktop.DBus.Properties"
OBJECT_MANAGER = "org.freedesktop.DBus.ObjectManager"
SYSTEMD = "org.freedesktop.systemd1"
SYSTEMD_PATH = "/org/freedesktop/systemd1"
TDP_PROPERTIES = {"TdpLimit": "limit", "TdpLimitMin": "min", "TdpLimitMax": "max"}

# Steam discovers the supported interfaces through the manager at the bus root.
OBJECT_MANAGER_XML = """<node>
  <interface name="org.freedesktop.DBus.ObjectManager">
    <method name="GetManagedObjects">
      <arg type="a{oa{sa{sv}}}" direction="out"/>
    </method>
    <signal name="InterfacesAdded">
      <arg type="o"/>
      <arg type="a{sa{sv}}"/>
    </signal>
    <signal name="InterfacesRemoved">
      <arg type="o"/>
      <arg type="as"/>
    </signal>
  </interface>
</node>
"""

# Property names match the public SteamOS Manager API. The text is ours.
MANAGER_XML = """<node>
  <interface name="com.steampowered.SteamOSManager1.Manager2">
    <property name="DeviceModel" type="(ss)" access="read"/>
  </interface>
</node>
"""


def apply_bin():
    override = os.environ.get("OMARCHY_ALLY_TDP_APPLY")
    if override:
        return override
    return "/usr/bin/omarchy-ally-tdp-apply"


def use_pkexec():
    return os.environ.get("OMARCHY_ALLY_TDP_NO_PKEXEC") != "1"


def interface_xml():
    root = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
    path = Path(root) / "default/ally-tdp/com.steampowered.SteamOSManager1.TdpLimit1.xml"
    return path.read_text(encoding="utf-8")


def run_apply(args):
    command = [apply_bin(), *args]
    if use_pkexec() and args and args[0] == "--set":
        command = ["pkexec", apply_bin(), *args]
    return subprocess.run(command, check=False, text=True, capture_output=True)


def parse_show(stdout):
    data = {}
    for line in stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key] = value
    if data.get("writable") != "1":
        return None
    try:
        props = {name: int(data[key]) for name, key in TDP_PROPERTIES.items()}
    except (KeyError, ValueError):
        return None
    if any(value < 0 or value > 0xFFFFFFFF for value in props.values()):
        return None
    return props


def show():
    try:
        proc = run_apply(["--show"])
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    return parse_show(proc.stdout)


def ally():
    proc = subprocess.run(["omarchy-hw-rog-ally"], check=False)
    return proc.returncode == 0


def main():
    if not ally():
        return 0

    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    try:
        tdp_xml = interface_xml()
    except OSError as exc:
        print(f"omarchy-ally-tdp-shim: {exc}", file=sys.stderr)
        return 1

    loop = GLib.MainLoop()
    tdp = Gio.DBusNodeInfo.new_for_xml(tdp_xml).interfaces[0]
    state = {"failed": False, "stopping": False, "session": None, "last": None, "tdp_id": 0}

    def stop():
        state["stopping"] = True
        loop.quit()
        return GLib.SOURCE_REMOVE

    def tdp_properties(info):
        return {name: GLib.Variant("u", value) for name, value in info.items()}

    def refresh_tdp(info, announce=True):
        connection = state["session"]
        previous = state["last"]
        if connection is None or info == previous:
            return
        state["last"] = info
        if info is None:
            connection.unregister_object(state["tdp_id"])
            state["tdp_id"] = 0
            connection.emit_signal(
                None, "/", OBJECT_MANAGER, "InterfacesRemoved", GLib.Variant("(oas)", (OBJECT, [TDP])),
            )
            return
        if previous is None:
            state["tdp_id"] = connection.register_object(OBJECT, tdp, on_method, on_get, on_set)
            if announce:
                connection.emit_signal(
                    None, "/", OBJECT_MANAGER, "InterfacesAdded",
                    GLib.Variant("(oa{sa{sv}})", (OBJECT, {TDP: tdp_properties(info)})),
                )
            return
        changed = tdp_properties({name: value for name, value in info.items() if value != previous[name]})
        connection.emit_signal(
            None,
            OBJECT,
            PROPS,
            "PropertiesChanged",
            GLib.Variant.new_tuple(
                GLib.Variant("s", TDP),
                GLib.Variant("a{sv}", changed),
                GLib.Variant("as", []),
            ),
        )

    def on_method(_connection, _sender, _path, _interface, method, _params, invocation):
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def get_property(interface, name):
        if interface == TDP:
            info = state["last"]
            if info is not None and name in info:
                return GLib.Variant("u", info[name])
        if interface == MANAGER and name == "DeviceModel":
            return GLib.Variant("(ss)", ("rog_ally", "RC71L"))
        return None

    def on_get(_connection, _sender, _path, interface, name):
        return get_property(interface, name)

    def on_set(_connection, _sender, _path, interface, name, value):
        if interface == TDP and name == "TdpLimit":
            watts = value.get_uint32()
            try:
                proc = run_apply(["--set", str(watts)])
            except OSError:
                proc = None
            applied = proc is not None and proc.returncode == 0
            info = parse_show(proc.stdout) if applied else None
            if info is None:
                info = show()
            refresh_tdp(info)
            return applied and info is not None
        return False

    def on_bus(connection, _name):
        state["session"] = connection
        manager = Gio.DBusNodeInfo.new_for_xml(MANAGER_XML).interfaces[0]
        connection.register_object(OBJECT, manager, on_method, on_get, on_set)
        refresh_tdp(show(), announce=False)

        def get_managed_objects(_connection, _sender, _path, _interface, _method, _params, invocation):
            managed = {MANAGER: {"DeviceModel": get_property(MANAGER, "DeviceModel")}}
            if state["last"] is not None:
                managed[TDP] = tdp_properties(state["last"])
            invocation.return_value(GLib.Variant("(a{oa{sa{sv}}})", ({OBJECT: managed},)))

        object_manager = Gio.DBusNodeInfo.new_for_xml(OBJECT_MANAGER_XML).interfaces[0]
        connection.register_object("/", object_manager, get_managed_objects, None, None)

    def on_lost(_connection, _name):
        if not state["stopping"]:
            state["failed"] = True
            loop.quit()

    def on_update(_monitor, _file, _other_file, event):
        if event == Gio.FileMonitorEvent.CHANGES_DONE_HINT and state["session"] is not None:
            refresh_tdp(show())

    def on_unit_change(_connection, _sender, path, _interface, _signal, parameters):
        if path in conflict_paths and state["session"] is not None:
            _unit, changed, invalidated = parameters.unpack()
            if "ActiveState" in changed or "ActiveState" in invalidated:
                refresh_tdp(show())

    lock = "/run/omarchy-ally-tdp.lock"
    if os.environ.get("OMARCHY_ALLY_TDP_FIXTURE") == "1" and not use_pkexec():
        lock = os.environ["OMARCHY_ALLY_TDP_LOCK"]
    try:
        marker = Gio.Vfs.get_local().get_file_for_path(lock + ".updated")
        updates = marker.monitor_file(Gio.FileMonitorFlags.NONE, None)
        updates.connect("changed", on_update)
    except GLib.Error as exc:
        print(f"omarchy-ally-tdp-shim: could not watch for power updates: {exc}", file=sys.stderr)

    try:
        proc = run_apply(["--conflict-units"])
        conflict_paths = {
            f"{SYSTEMD_PATH}/unit/{Gio.dbus_escape_object_path(unit)}" for unit in proc.stdout.splitlines()
        } if proc.returncode == 0 else set()
        if conflict_paths:
            system_bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
            system_bus.signal_subscribe(
                SYSTEMD, PROPS, "PropertiesChanged", None, SYSTEMD + ".Unit", Gio.DBusSignalFlags.NONE, on_unit_change,
            )
            system_bus.call_sync(
                SYSTEMD, SYSTEMD_PATH, SYSTEMD + ".Manager", "Subscribe", None, None,
                Gio.DBusCallFlags.NONE, 3000, None,
            )
    except (OSError, GLib.Error) as exc:
        print(f"omarchy-ally-tdp-shim: could not watch for power owner changes: {exc}", file=sys.stderr)

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
    Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS,
        Gio.BusNameOwnerFlags.NONE,
        on_bus,
        None,
        on_lost,
    )
    loop.run()
    return 1 if state["failed"] else 0


if __name__ == "__main__":
    sys.exit(main())
