#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

# The handheld gate lives with the callers of the lock, not in the lock screen.
if [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/default/gaming/session.sh ]]; then
  # shellcheck source=/dev/null
  source "$OMARCHY_PATH/default/gaming/session.sh"
  gaming_apply_lock_gate
  gate=$?
  if (( gate == 10 )); then exit 0; fi
  if (( gate == 11 )); then exit 1; fi
fi

# Hide wvkbd before the lock surface. Its overlay would sit above hyprlock and
# take the touches meant for the password field. stop is a no-op when it is
# not running, and a missing helper must not refuse the lock.
omarchy-toggle-desktop-keyboard stop >/dev/null 2>&1 || true

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && [[ $("$OMARCHY_PATH/bin/omarchy-lock-host" mode 2>/dev/null) == "host" ]]; then
  "$OMARCHY_PATH/bin/omarchy-system-sleep-lock" || exit 1
else
  # A failed lock used to fall through and exit 0, which opened an unlocked
  # desktop. The caller has to see that the lock did not engage.
  if ! omarchy-shell lock lock >/dev/null; then
    exit 1
  fi
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked. Use timeout because `1password --lock` can
# otherwise leave a full Electron helper tree running after each lock.
if pgrep -x "1password" >/dev/null && omarchy-cmd-present 1password; then
  (
    flock -n 9 || exit 0
    timeout --kill-after=1s 3s 1password --lock >/dev/null 2>&1 || true
  ) 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-1password-lock.lock" &
fi

# Avoid running screensaver when locked
screensaver='[/]usr/lib/omarchy-screensaver/omarchy-screensaver'
if pkill -f "$screensaver" 2>/dev/null; then
  timeout 1s pidwait -f "$screensaver" 2>/dev/null || pkill -KILL -f "$screensaver" 2>/dev/null || true
  # It hid the cursor, and a killed or failed exit leaves it hidden.
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 || hyprctl keyword cursor:invisible false >/dev/null 2>&1 || true
fi
