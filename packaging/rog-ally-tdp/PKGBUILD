# Opt-in ROG Ally TDP slider. The writer and the shim ship in omarchy, so this
# package does not install /usr/bin copies of them. Its scriptlet runs
# omarchy-ally-tdp-install, which is also what the Ally hardware leaf runs.
# Not listed in install/omarchy-base.packages, and the leaf does not pkg-add it.
pkgname=omarchy-rog-ally-tdp
pkgver=1.0.0
pkgrel=1
pkgdesc='ROG Ally RC71L Steam TDP slider'
arch=('any')
url='https://github.com/DanielJBurbridge/omarchy'
license=('MIT')
depends=('omarchy' 'python-gobject' 'polkit' 'systemd')
conflicts=('steamos-manager')
source=(
  'NOTICE.steamos-manager'
  'com.steampowered.SteamOSManager1.TdpLimit1.xml'
)
sha256sums=('SKIP' 'SKIP')
install=omarchy-rog-ally-tdp.install

package() {
  install -Dm644 NOTICE.steamos-manager "$pkgdir/usr/share/licenses/$pkgname/NOTICE.steamos-manager"
  install -Dm644 com.steampowered.SteamOSManager1.TdpLimit1.xml \
    "$pkgdir/usr/share/omarchy-rog-ally-tdp/com.steampowered.SteamOSManager1.TdpLimit1.xml"
}
