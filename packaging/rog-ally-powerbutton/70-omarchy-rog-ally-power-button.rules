# KEY_POWER is also advertised by laptop and dock keyboards. uaccess is only
# for the ACPI power button: name "Power Button", and PNP0C0C or LNXPWRBN.
# Sleep Button, the AT keyboard, and InputPlumber's virtual keyboard stay out.
ACTION=="remove", GOTO="omarchy_rog_ally_power_button_end"
SUBSYSTEM=="input", KERNEL=="event*", ENV{OMARCHY_POWER_BUTTON}=="1", ATTRS{name}=="Power Button", ATTRS{modalias}=="*PNP0C0C*", PROGRAM=="/usr/bin/omarchy-hw-rog-ally", ENV{STEAMOS_POWER_BUTTON}="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{OMARCHY_POWER_BUTTON}=="1", ATTRS{name}=="Power Button", ATTRS{modalias}=="*LNXPWRBN*", PROGRAM=="/usr/bin/omarchy-hw-rog-ally", ENV{STEAMOS_POWER_BUTTON}="1", TAG+="uaccess"
LABEL="omarchy_rog_ally_power_button_end"
