[Unit]
Description=Reapply the ROG Ally TDP limit after the system wakes
DefaultDependencies=no
StopWhenUnneeded=yes
Before=sleep.target
# systemd.special(7): this unit starts before sleep and stays active while
# the machine is asleep. ExecStart writes nothing. ExecStop runs after wake.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/bin/omarchy-hw-rog-ally
ExecStart=/bin/true
ExecStop=/usr/bin/omarchy-ally-tdp-apply --reassert

[Install]
WantedBy=sleep.target
