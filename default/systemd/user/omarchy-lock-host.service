[Unit]
Description=Trusted Omarchy authentication host (explicit next-session opt-in)
After=wayland-session-waitenv.service
PartOf=graphical-session.target
ConditionEnvironment=OMARCHY_PATH
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
# The launcher reads the immutable per-compositor owner selection. Do not
# condition restarts on the next-session preference: staging opt-out while
# unlocked must leave crash recovery available to this session's owner.

[Service]
Type=simple
# Remove loader/interpreter injection before the first executable starts;
# the launcher also isolates Qt imports and the host's backend environment.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT PYTHONPATH PYTHONHOME BASH_ENV ENV QML_IMPORT_PATH QML2_IMPORT_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QT_QUICK_CONTROLS_CONF QT_QUICK_CONTROLS_STYLE_PATH
ExecStart=/usr/bin/omarchy-launch-lock-host
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
