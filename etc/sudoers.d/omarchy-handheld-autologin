# The gaming session records a failed start and clears it when the ready FIFO
# reads started. Neither write can wait for a password at the login boundary.
# The grant is these three verbs and nothing else: no session start, no
# arbitrary paths.
%wheel ALL=(root) NOPASSWD: /usr/bin/omarchy-handheld-autologin fail, /usr/bin/omarchy-handheld-autologin reset, /usr/bin/omarchy-handheld-autologin apply
